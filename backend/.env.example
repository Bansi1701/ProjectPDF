# Copy this file to .env and fill in the real values.
# .env is git-ignored — never commit it.

ENVIRONMENT=development
DEBUG=true

# --- Neon Postgres -----------------------------------------------------------
# Neon dashboard -> your project -> Connect -> copy the connection string.
#
# Paste it EXACTLY as Neon gives it to you. The app strips the parameters
# asyncpg cannot handle (sslmode, channel_binding) and enables TLS itself.
#
# Use the POOLED host (it contains "-pooler") for the application.
# Use the DIRECT host (no "-pooler") for Alembic migrations.
#
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
