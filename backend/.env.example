# The real .env is shared privately by a maintainer — ask for it.
# This file documents the shape only. Never commit a filled-in .env.

ENVIRONMENT=development
DEBUG=true

# Neon Postgres connection string, pasted exactly as Neon gives it.
# The app strips the parameters asyncpg cannot handle (sslmode,
# channel_binding) and enables TLS itself, so no editing is needed.
#
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
