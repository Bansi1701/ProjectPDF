# Frontend build configuration. Every value is optional; the defaults build
# the GitHub Pages project site. In CI these come from repository variables
# (see .github/workflows/deploy.yml), not from a checked-in file.

# Where the site is published, base path included. Drives canonicals,
# sitemap, robots.txt, llms.txt, structured data and the CNAME file.
#   https://bansi1701.github.io/ProjectPDF   (default)
#   https://hatepdf.com                      (custom domain)
SITE_ORIGIN=

# IndexNow key (any 8–128 character hex string). The build publishes
# <key>.txt at the site root and the deploy pings Bing and partners.
INDEXNOW_KEY=

# Ownership proofs. Paste the token from Google Search Console
# (HTML tag method) and Bing Webmaster Tools (meta tag method).
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=

# Backend origin for the one server-side tool (Web page to PDF). Unset means
# the tool shows "not deployed yet" and makes no request.
PUBLIC_API_URL=
