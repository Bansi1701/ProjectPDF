# Response headers for Cloudflare Pages. GitHub Pages ignores this file, so it
# is safe to ship from either host.
#
# Caching turns on one distinction: a filename that changes when its bytes
# change can be cached forever; one that keeps its name cannot. Vite hashes
# everything under /_astro, so those are immutable. The engine payloads keep
# fixed names across a dependency bump, so they revalidate before reuse.
# Unchanged files can still return a small 304 response. A security upgrade
# must not leave an old worker or engine cached for a month.
#
# No Cross-Origin-Opener-Policy or Cross-Origin-Embedder-Policy here, ever:
# cross-origin isolation is banned repo-wide (see CLAUDE.md). It would buy
# WASM threads at the cost of ad revenue, embeds and OAuth popups.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()
  Cache-Control: public, max-age=0, must-revalidate

# Content-hashed by the bundler: a changed file is a different URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fixed-name engines must pick up compatible/security updates immediately.
/tesseract/*
  Cache-Control: public, max-age=0, must-revalidate
/tessdata/*
  Cache-Control: public, max-age=2592000
/pdfjs/*
  Cache-Control: public, max-age=0, must-revalidate
/wasm/*
  Cache-Control: public, max-age=0, must-revalidate
/fonts/*
  Cache-Control: public, max-age=2592000
/brand/*
  Cache-Control: public, max-age=2592000
