---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import PdfTool from '../components/PdfTool.astro';
import ToolGuide from '../components/ToolGuide.astro';
---

<BaseLayout title="Split PDF — Filozy" description="Split a PDF using visible page cuts or custom page groups. Open advanced splitting for size targets and smart separators.">
  <Masthead />
  <main id="main">
    <PdfTool
      mode="split"
      title="Split PDF"
      description="Choose where to cut in the page preview, or enter custom page groups — all processed in your browser."
    />
    <ToolGuide slug="split-pdf" />
  </main>
</BaseLayout>
