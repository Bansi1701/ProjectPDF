---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import PdfTool from '../components/PdfTool.astro';
import ToolGuide from '../components/ToolGuide.astro';

const description =
  'Converts a PDF to greyscale by rewriting the colour where the file records it, so text stays selectable and searchable instead of being flattened into pictures.';
---

<BaseLayout title="PDF to greyscale — HatePDF" description={description}>
  <Masthead />
  <main id="main">
    <PdfTool
      mode="grayscale"
      eyebrow="Runs entirely in your browser"
      title="Convert a PDF to greyscale"
      description={description}
    />
    <ToolGuide slug="grayscale-pdf" />
  </main>
</BaseLayout>
