---
import IntentPage from '../components/IntentPage.astro';
---
<IntentPage
  title="Merge PDF files without uploading them"
  description="Combine and reorder PDF pages in your browser. The source files stay on your device, and the finished PDF downloads directly from the same tab."
  toolSlug="merge-pdf"
  toolName="Merge PDF"
  explanation="HatePDF loads the PDF engine only after you choose files, reads them in browser memory, and creates the merged download locally. Its completion receipt reports exactly how many document bytes were sent."
  steps={[
    { title: 'Choose locally', text: 'Select two or more PDFs. No upload begins and no account is created.' },
    { title: 'See and reorder', text: 'Inspect page thumbnails and drag pages into the final sequence.' },
    { title: 'Save or continue', text: 'Download the merged PDF or hand it locally to Compress, Page numbers, or Protect.' },
  ]}
  limitation="The work uses your device's memory. A phone may struggle with hundreds of image-heavy pages that a server or desktop app could handle more comfortably."
/>
