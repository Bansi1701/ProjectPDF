---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import PdfTool from '../components/PdfTool.astro';
---

<BaseLayout title="Compare two PDFs — ProjectPDF" description="Check whether two documents are the same. Both stay on your device.">
  <Masthead />
  <main id="main">
    <PdfTool mode="compare" title="Compare two PDFs" description="Check whether two documents are the same. Both stay on your device." multiple />
  </main>
</BaseLayout>
