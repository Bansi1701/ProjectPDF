---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import PdfTool from '../components/PdfTool.astro';
import ToolGuide from '../components/ToolGuide.astro';

const description =
  'Make filled forms and comments permanent, so what you send is what they see. Runs in this tab.';
---

<BaseLayout title="Flatten a PDF — HatePDF" description={description}>
  <Masthead />
  <main id="main">
    <PdfTool
      mode="flatten"
      eyebrow="Runs entirely in your browser"
      title="Flatten a PDF"
      description={description}
    />
    <ToolGuide slug="flatten-pdf" />
  </main>
</BaseLayout>
