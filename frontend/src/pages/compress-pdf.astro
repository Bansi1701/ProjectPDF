---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Lens from '../components/Lens.astro';
import { SITE } from '../config/site';

const title = 'Compress PDF — smaller file, identical pages';
const description =
  'Make a PDF smaller without changing a single pixel. Runs entirely in your browser — the file is never uploaded.';
---

<BaseLayout title={`${title} | ${SITE.name}`} description={description}>
  <Masthead />

  <main id="main" class="tool wrap">
    <!-- Paints from static HTML. No JS on the critical path. -->
    <header class="tool__head">
      <p class="eyebrow"><span class="dot"></span>Lossless · nothing is uploaded</p>
      <h1>Compress PDF</h1>
      <p class="lede">
        Repacks the file and strips what nothing renders. Every page, every image and every
        character comes out byte-for-byte identical — only the container gets smaller.
      </p>
    </header>

    <Lens variant="loupe" class="drop">
      <!-- The label IS the control: this works with keyboard and screen readers,
           and needs no JavaScript to be focusable. -->
      <label class="drop__zone" id="zone">
        <input type="file" accept="application/pdf,.pdf" id="file" class="sr-only" />
        <span class="drop__icon" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M8 3h11l6 6v20a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z" stroke-linejoin="round"></path>
            <path d="M19 3v6h6" stroke-linejoin="round"></path>
            <path d="M16 22v-8m0 0-3.2 3.2M16 14l3.2 3.2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </span>
        <span class="drop__title">Choose a PDF, or drop one here</span>
        <span class="drop__meta">Stays on this device · no account · no size limit but your RAM</span>
      </label>

      <div class="drop__state" id="state" hidden>
        <p class="drop__filename" id="filename"></p>
        <p class="drop__progress" id="progress">Working…</p>
      </div>
    </Lens>

    <!-- Result. Populated by script; hidden until there is something to say. -->
    <section class="result" id="result" hidden aria-live="polite">
      <div class="result__headline">
        <span class="result__pct" id="pct"></span>
        <span class="result__sizes" id="sizes"></span>
      </div>

      <div class="result__bar" aria-hidden="true">
        <span class="result__bar-fill" id="bar"></span>
      </div>

      <p class="result__why" id="why" hidden></p>

      <ul class="result__notes" id="notes"></ul>

      <div class="result__actions">
        <a class="btn btn--primary" id="download" download>Save the smaller file</a>
        <button class="btn btn--quiet" id="again" type="button">Compress another</button>
      </div>

      <p class="result__receipt" id="receipt"></p>
    </section>

    <p class="error" id="error" hidden role="alert"></p>

    <section class="explain">
      <h2>What this does, exactly</h2>
      <ol class="explain__list">
        <li>
          <b>Repacks the file structure.</b> A PDF is thousands of small objects. Packing them
          into compressed object streams is where most of the saving comes from.
        </li>
        <li>
          <b>Drops what nothing renders.</b> Authoring tools leave private working data behind —
          Illustrator and InDesign can hide an entire copy of the source document in there.
        </li>
        <li>
          <b>Clears metadata.</b> Author, dates, the software you used, and the XMP block.
        </li>
        <li>
          <b>Checks the result.</b> The output is re-opened and the page count verified before
          you get it. If anything looks wrong, or the result is not smaller, you get your
          original file back untouched.
        </li>
      </ol>
      <p class="explain__note">
        What it never does: re-encode an image, reduce resolution, or flatten anything. That is
        a different tool, and it will be clearly labelled when it exists.
      </p>
    </section>
  </main>
</BaseLayout>

<script>
  import type { WorkerResponse } from '../lib/compress/types';

  const zone = document.getElementById('zone') as HTMLLabelElement;
  const input = document.getElementById('file') as HTMLInputElement;
  const state = document.getElementById('state') as HTMLElement;
  const filenameEl = document.getElementById('filename') as HTMLElement;
  const progress = document.getElementById('progress') as HTMLElement;
  const result = document.getElementById('result') as HTMLElement;
  const pct = document.getElementById('pct') as HTMLElement;
  const sizes = document.getElementById('sizes') as HTMLElement;
  const bar = document.getElementById('bar') as HTMLElement;
  const notes = document.getElementById('notes') as HTMLElement;
  const why = document.getElementById('why') as HTMLElement;
  const download = document.getElementById('download') as HTMLAnchorElement;
  const again = document.getElementById('again') as HTMLButtonElement;
  const receipt = document.getElementById('receipt') as HTMLElement;
  const errorEl = document.getElementById('error') as HTMLElement;

  let worker: Worker | null = null;
  let jobId = 0;
  let objectUrl: string | null = null;

  const kb = (n: number) => `${(n / 1024).toFixed(1)} KB`;
  const mb = (n: number) => (n >= 1024 * 1024 ? `${(n / 1024 / 1024).toFixed(2)} MB` : kb(n));

  /** Spun up on first use, not on page load — the WASM-on-load mistake in miniature. */
  function ensureWorker(): Worker {
    if (!worker) {
      worker = new Worker(new URL('../lib/compress/worker.ts', import.meta.url), {
        type: 'module',
      });
      worker.onmessage = (event: MessageEvent<WorkerResponse>) => onDone(event.data);
      worker.onerror = () => fail('The compressor failed to start.');
    }
    return worker;
  }

  function reset() {
    result.hidden = true;
    errorEl.hidden = true;
    state.hidden = true;
    zone.hidden = false;
    if (objectUrl) {
      URL.revokeObjectURL(objectUrl);
      objectUrl = null;
    }
  }

  function fail(message: string) {
    state.hidden = true;
    zone.hidden = false;
    errorEl.textContent = message;
    errorEl.hidden = false;
  }

  async function run(file: File) {
    if (file.type && file.type !== 'application/pdf' && !file.name.toLowerCase().endsWith('.pdf')) {
      fail('That is not a PDF.');
      return;
    }

    reset();
    zone.hidden = true;
    state.hidden = false;
    filenameEl.textContent = file.name;
    progress.textContent = `Reading ${mb(file.size)}…`;

    const buffer = await file.arrayBuffer();
    progress.textContent = 'Compressing on this device…';

    const id = ++jobId;
    // Transfer, don't copy — a 50 MB file should not exist twice in memory.
    ensureWorker().postMessage({ id, bytes: buffer, mode: 'lossless' }, [buffer]);

    download.dataset.name = file.name.replace(/\.pdf$/i, '') + '-compressed.pdf';
  }

  function onDone({ id, result: res }: WorkerResponse) {
    if (id !== jobId) return;

    state.hidden = true;
    zone.hidden = false;

    if (!res.ok) {
      fail(res.error);
      return;
    }

    const saved = res.bytesIn - res.bytesOut;
    const percent = Math.round(res.ratio * 100);

    pct.textContent = res.unchanged ? 'Already optimal' : `${percent}% smaller`;
    pct.dataset.weak = String(res.unchanged || percent < 8);
    sizes.textContent = res.unchanged
      ? `${mb(res.bytesIn)} — nothing to remove`
      : `${mb(res.bytesIn)} → ${mb(res.bytesOut)}  ·  saved ${mb(saved)}`;

    bar.style.width = `${Math.max(2, percent)}%`;
    bar.dataset.weak = String(res.unchanged || percent < 8);

    if (res.explanation) {
      why.textContent = res.explanation;
      why.hidden = false;
    } else {
      why.hidden = true;
    }

    notes.innerHTML = '';
    for (const note of res.notes) {
      const li = document.createElement('li');
      li.textContent = note;
      notes.append(li);
    }

    receipt.textContent =
      `${res.pages} pages · ${Math.round(res.durationMs)}ms · 0 bytes sent`;

    const blob = new Blob([res.bytes as BlobPart], { type: 'application/pdf' });
    objectUrl = URL.createObjectURL(blob);
    download.href = objectUrl;
    download.setAttribute('download', download.dataset.name ?? 'compressed.pdf');
    download.hidden = res.unchanged;

    result.hidden = false;
  }

  input.addEventListener('change', () => {
    const file = input.files?.[0];
    if (file) void run(file);
  });

  again.addEventListener('click', () => {
    input.value = '';
    reset();
  });

  for (const event of ['dragenter', 'dragover'] as const) {
    zone.addEventListener(event, (e) => {
      e.preventDefault();
      zone.dataset.over = 'true';
    });
  }

  for (const event of ['dragleave', 'drop'] as const) {
    zone.addEventListener(event, (e) => {
      e.preventDefault();
      delete zone.dataset.over;
    });
  }

  zone.addEventListener('drop', (e) => {
    const file = e.dataTransfer?.files?.[0];
    if (file) void run(file);
  });
</script>

<style>
  .tool {
    padding-block: clamp(2.5rem, 2rem + 3vw, 4rem) clamp(3.5rem, 3rem + 4vw, 6rem);
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3rem);
    max-width: 46rem;
  }

  .tool__head h1 {
    font-size: var(--step-4);
    margin-block: 1rem 1.25rem;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--ok);
  }

  /* ── dropzone ─────────────────────────────────────────────────────── */
  .tool :global(.drop) {
    --lens-radius: 20px;
  }

  .drop__zone {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    padding: clamp(2rem, 1.5rem + 3vw, 3.25rem) 1.5rem;
    text-align: center;
    cursor: pointer;
    border-radius: inherit;
    border: 1.5px dashed var(--line-strong);
    margin: 0.5rem;
    transition: border-color 160ms ease-out, background-color 160ms ease-out;
  }

  .drop__zone:hover,
  .drop__zone[data-over] {
    border-color: var(--accent);
    background: color-mix(in oklab, var(--accent) 5%, transparent);
  }

  .drop__zone:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* display:none would take the input out of the tab order in some browsers.
     Clip it instead so it stays focusable and screen-reader visible. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .drop__icon {
    width: 2rem;
    height: 2rem;
    color: var(--ink-2);
  }

  .drop__icon svg {
    width: 100%;
    height: 100%;
  }

  .drop__title {
    font-size: var(--step-1);
    font-weight: 500;
  }

  .drop__meta {
    font-size: var(--step--2);
    color: var(--muted);
  }

  .drop__state {
    padding: clamp(2rem, 1.5rem + 3vw, 3.25rem) 1.5rem;
    text-align: center;
    display: grid;
    gap: 0.4rem;
  }

  .drop__filename {
    font-weight: 500;
  }

  .drop__progress {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
  }

  /* ── result ───────────────────────────────────────────────────────── */
  .result {
    background: var(--paper-sunk);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    display: grid;
    gap: 1rem;
  }

  .result__headline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
  }

  .result__pct {
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--ok);
  }

  .result__pct[data-weak='true'] {
    color: var(--ink-2);
  }

  .result__bar-fill[data-weak='true'] {
    background: var(--line-strong);
  }

  .result__sizes {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .result__bar {
    height: 0.4rem;
    border-radius: 999px;
    background: var(--line);
    overflow: hidden;
  }

  .result__bar-fill {
    display: block;
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: var(--ok);
    transition: width 520ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* Shown when the number alone would read as a failure. */
  .result__why {
    margin: 0;
    padding: 0.9rem 1rem;
    border-left: 2px solid var(--disclose);
    background: color-mix(in oklab, var(--disclose) 6%, transparent);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .result__notes {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.35rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .result__notes:empty {
    display: none;
  }

  .result__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.25rem;
  }

  .result__receipt {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--muted);
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
  }

  .error {
    margin: 0;
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius);
    border: 1px solid var(--seal);
    color: var(--seal);
    font-size: var(--step--1);
  }

  /* ── explainer ────────────────────────────────────────────────────── */
  .explain h2 {
    font-size: var(--step-2);
    margin-bottom: 1.25rem;
  }

  .explain__list {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.75rem;
    color: var(--ink-2);
    font-size: var(--step--1);
  }

  .explain__list b {
    color: var(--ink);
    font-weight: 600;
  }

  .explain__note {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--muted);
  }
</style>
