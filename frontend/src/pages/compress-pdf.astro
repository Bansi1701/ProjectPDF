---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import PdfTool from '../components/PdfTool.astro';
import ToolGuide from '../components/ToolGuide.astro';
---

<BaseLayout
  title="Compress PDF — preserve text and appearance | Filozy"
  description="Reduce PDF size with verified font compaction and safe repacking. Set an upload limit without changing words, page layout or image quality."
>
  <Masthead />
  <main id="main">
    <PdfTool
      mode="compress"
      eyebrow="Lossless · nothing is uploaded"
      title="Compress PDF"
      description="Smaller files, the same words and page layout. Set your upload limit or try a 30%, 50% or 70% reduction target. We report what is safely achievable without reducing image quality."
    />
    <ToolGuide slug="compress-pdf" />
  </main>
</BaseLayout>
