---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import PdfTool from '../components/PdfTool.astro';
import ToolGuide from '../components/ToolGuide.astro';
---

<BaseLayout
  title="Compress PDF — smaller file, identical pages | HatePDF"
  description="Make a PDF smaller without changing a single pixel. Runs entirely in your browser — the file is never uploaded."
>
  <Masthead />
  <main id="main">
    <PdfTool
      mode="compress"
      eyebrow="Lossless · nothing is uploaded"
      title="Compress PDF"
      description="Repacks the file and strips what nothing renders. Every page, every image and every character comes out byte-for-byte identical — only the container gets smaller."
    />
    <ToolGuide slug="compress-pdf" />
  </main>
</BaseLayout>
