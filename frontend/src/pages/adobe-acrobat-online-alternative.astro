    { statement: 'Adobe’s free online tools process the file on Adobe’s servers; if you are not signed in, Adobe says the file is deleted from its servers within a short time, and you must sign in to save, share or download further work.', sourceUrl: 'https://helpx.adobe.com/document-cloud/faq.html', sourceLabel: 'Adobe Document Cloud FAQ' },
    { statement: 'Signed-in users keep files in Adobe cloud storage (2 GB free) until they delete them, subject to Adobe’s retention policy for inactive free accounts.', sourceUrl: 'https://helpx.adobe.com/document-cloud/faq.html', sourceLabel: 'Adobe Document Cloud FAQ' },
    { statement: 'Many tools allow a limited number of free uses before an Acrobat subscription is required; Acrobat Pro also adds the desktop application and certified signing features.', sourceUrl: 'https://www.adobe.com/acrobat/online.html', sourceLabel: 'Adobe Acrobat online tools' },
  ]}
