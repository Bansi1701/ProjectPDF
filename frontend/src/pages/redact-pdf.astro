---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import RedactTool from '../components/RedactTool.astro';
import ToolGuide from '../components/ToolGuide.astro';
---

<BaseLayout
  title="Redact a PDF — HatePDF"
  description="Remove content from a PDF so it is gone, not covered up. Runs entirely in your browser."
>
  <Masthead />
  <main id="main">
    <RedactTool />
    <ToolGuide slug="redact-pdf" />
  </main>
</BaseLayout>
