---
import { getCollection } from 'astro:content';

import HelpFooter from '../../components/HelpFooter.astro';
import Masthead from '../../components/Masthead.astro';
import { TOOLS } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { breadcrumbLd, canonical } from '../../lib/seo';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const guides = (await getCollection('guides')).sort((a, b) => (a.data.updated < b.data.updated ? 1 : -1));
const toolName = (slug: string) => TOOLS.find((tool) => tool.slug === slug)?.searchName ?? slug;

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'HatePDF Guides',
  description: 'Long-form guides to real PDF tasks — redaction, encryption, OCR, archiving, conversion — done in the browser without uploading.',
  url: canonical('/guides/'),
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: guides.length,
    itemListElement: guides.map((guide, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: guide.data.title,
      url: canonical(`/guides/${guide.id}/`),
    })),
  },
};
---

<BaseLayout
  title="PDF guides for real tasks, done privately | HatePDF"
  description="Long-form guides to redaction, encryption, OCR, PDF/A, compression and conversion — how each job works, what to check, and how to do it in your browser without uploading."
  keywords={['PDF guides', 'how to redact a PDF', 'how to password protect a PDF', 'PDF/A explained', 'OCR scanned PDF', 'private PDF tools']}
>
  <Masthead />
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd([{ name: 'Home', url: '/' }, { name: 'Guides', url: '/guides/' }]))} is:inline />
  <main id="main" class="guides">
    <header>
      <nav class="crumbs" aria-label="Breadcrumb"><a href={`${base}/`}>Home</a><span>/</span><strong>Guides</strong></nav>
      <p class="eyebrow">Guides</p>
      <h1>The job, explained — then done on your device.</h1>
      <p class="lede">Each guide covers one real task end to end: what the format actually does, the mistakes that leak information or break files, and the exact steps in HatePDF. Short guides for every individual tool live in the <a href={`${base}/help/`}>Help Center</a>.</p>
    </header>
    <ul class="list">
      {guides.map((guide) => (
        <li>
          <a href={`${base}/guides/${guide.id}/`}>
            <small>{guide.data.tools.map(toolName).join(' · ')}</small>
            <h2>{guide.data.title}</h2>
            <p>{guide.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
    <p class="feed">Follow new guides: <a href={`${base}/guides/feed.xml`}>Atom feed</a> · <a href={`${base}/alternatives/`}>How HatePDF compares with upload-based PDF sites</a></p>
  </main>
  <HelpFooter />
</BaseLayout>

<style>
  .guides { width: min(64rem, calc(100% - 2rem)); margin: 0 auto; padding: clamp(3rem, 8vw, 6rem) 0 4rem; }
  .crumbs { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; color: var(--muted); font-size: var(--step--1); }
  .crumbs a { color: var(--ink-2); text-decoration: none; }
  .crumbs strong { color: var(--ink); }
  .eyebrow { margin: 0 0 0.6rem; color: var(--accent); font-size: var(--step--2); font-weight: var(--weight-bold); letter-spacing: var(--tracking-label); text-transform: uppercase; }
  h1 { max-width: 20ch; margin: 0; font-family: var(--font-display); font-size: var(--step-5); line-height: var(--leading-display); letter-spacing: var(--tracking-tight); }
  .lede { max-width: 50rem; color: var(--ink-2); font-size: var(--step-1); line-height: var(--leading-copy); }
  .lede a { color: var(--accent); }
  .list { display: grid; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); gap: 1rem; margin: 2.5rem 0 0; padding: 0; list-style: none; }
  .list a { display: grid; gap: 0.35rem; height: 100%; padding: 1.25rem; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--paper-raised); color: inherit; text-decoration: none; transition: 160ms ease; }
  .list a:hover { transform: translateY(-3px); border-color: var(--accent); }
  .list small { color: var(--accent); font-size: var(--step--2); font-weight: var(--weight-bold); letter-spacing: var(--tracking-label); text-transform: uppercase; }
  .list h2 { margin: 0; font-family: var(--font-display); font-size: var(--step-1); line-height: var(--leading-heading); }
  .list p { margin: 0; color: var(--ink-2); font-size: var(--step--1); line-height: var(--leading-copy); }
  .feed { margin-top: 2rem; color: var(--muted); font-size: var(--step--1); }
  .feed a { color: var(--accent); }
  @media (max-width: 44rem) { h1 { font-size: var(--step-4); } }
</style>
