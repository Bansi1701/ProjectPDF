---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import PdfTool from '../components/PdfTool.astro';
import ToolGuide from '../components/ToolGuide.astro';

const description =
  'Several pages to a sheet for handouts, a foldable booklet, or one page blown up across many sheets.';
---

<BaseLayout title="N-up, booklet and poster — HatePDF" description={description}>
  <Masthead />
  <main id="main">
    <PdfTool
      mode="impose"
      eyebrow="Runs entirely in your browser"
      title="N-up, booklet and poster"
      description={description}
    />
    <ToolGuide slug="impose-pdf" />
  </main>
</BaseLayout>
