---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import PdfTool from '../components/PdfTool.astro';
---

<BaseLayout title="Rotate PDF — ProjectPDF" description="Turn every page. Lossless — only the page dictionary changes.">
  <Masthead />
  <main id="main">
    <PdfTool mode="rotate" title="Rotate PDF" description="Turn every page. Lossless — only the page dictionary changes." />
  </main>
</BaseLayout>
