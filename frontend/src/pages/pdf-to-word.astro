---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import PdfTool from '../components/PdfTool.astro';

const description =
  'Rebuilds the text, headings and tables of a PDF into a .docx you can edit. Runs in this tab — the document is never uploaded.';
---

<BaseLayout title="PDF to Word — ProjectPDF" description={description}>
  <Masthead />
  <main id="main">
    <PdfTool
      mode="pdf-to-word"
      eyebrow="Converted here, not on a server"
      title="PDF to Word"
      description={description}
    />
  </main>
</BaseLayout>
