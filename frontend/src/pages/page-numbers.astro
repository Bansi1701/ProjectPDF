---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import PdfTool from '../components/PdfTool.astro';
---

<BaseLayout title="Add page numbers — ProjectPDF" description="Number every page, with an optional prefix.">
  <Masthead />
  <main id="main">
    <PdfTool mode="page-numbers" title="Add page numbers" description="Number every page, with an optional prefix." />
  </main>
</BaseLayout>
