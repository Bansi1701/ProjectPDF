---
import { getCollection } from 'astro:content';

import HelpFooter from '../../components/HelpFooter.astro';
import Masthead from '../../components/Masthead.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import { NAVIGATION_GROUPS, POPULAR_TOOL_SLUGS } from '../../config/navigation';
import { TOOLS } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { helpArticleDescription, helpKeywords } from '../../lib/help';
import { helpCollectionLd } from '../../lib/seo';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const liveTools = TOOLS.filter((tool) => tool.status === 'live');
const entries = await getCollection('tools');
const entryBySlug = new Map(entries.map((entry) => [entry.id, entry]));
const guideHref = (slug: string) => `${base}/help/${slug}/`;

const popularTools = POPULAR_TOOL_SLUGS
  .map((slug) => liveTools.find((tool) => tool.slug === slug))
  .filter((tool): tool is (typeof liveTools)[number] => Boolean(tool));

const collectionSchema = helpCollectionLd(
  liveTools.map((tool) => ({ name: `${tool.searchName} help`, path: `/help/${tool.slug}/` })),
);
---

<BaseLayout
  title="ProjectPDF Help Center — guides for every PDF tool"
  description="Find step-by-step ProjectPDF guides, practical tips, limitations, privacy details, and answers to common questions for every PDF tool."
  keywords={['ProjectPDF help', 'PDF help center', 'how to edit PDF', 'how to organize PDF', 'private PDF tools', 'PDF questions and answers']}
>
  <Masthead />
  <main id="main" class="help-home">
    <header class="help-hero">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={`${base}/`}>Home</a><span>/</span><strong>Help Center</strong></nav>
      <p class="eyebrow"><span aria-hidden="true"></span>ProjectPDF Help Center</p>
      <h1>Clear answers for every PDF tool.</h1>
      <p class="help-hero__intro">Learn what each tool is for, follow the exact steps, understand its limitations, and get answers before you work on an important document.</p>

      <form class="help-search" role="search" data-help-search>
        <span aria-hidden="true">⌕</span>
        <label class="sr-only" for="help-query">Search ProjectPDF help</label>
        <input id="help-query" type="search" placeholder={`Search ${liveTools.length} guides — merge, redact, OCR…`} autocomplete="off" data-help-query />
        <kbd>/</kbd>
      </form>
      <p class="help-results" aria-live="polite" data-help-results>{liveTools.length} guides available</p>

      <nav class="help-jumps" aria-label="Help topics">
        {NAVIGATION_GROUPS.map((group) => <a href={`#${group.anchor}-help`}>{group.label}<span>{group.tools.length}</span></a>)}
      </nav>
    </header>

    <section class="popular" aria-labelledby="popular-help-title">
      <div class="section-head"><div><p>Start here</p><h2 id="popular-help-title">Popular help guides</h2></div><span>Short, practical, private</span></div>
      <div class="popular__grid">
        {popularTools.map((tool) => {
          const group = NAVIGATION_GROUPS.find((item) => item.tools.some((candidate) => candidate.slug === tool.slug));
          return (
            <a href={guideHref(tool.slug)}>
              <ToolIcon slug={tool.slug} tone={group?.tone} size="3.1rem" />
              <span><small>{group?.label}</small><strong>How to use {tool.searchName}</strong><em>{tool.blurb}</em></span>
              <b aria-hidden="true">→</b>
            </a>
          );
        })}
      </div>
    </section>

    <div class="help-library" id="all-help-guides">
      {NAVIGATION_GROUPS.map((group) => (
        <section class={`help-group help-group--${group.tone}`} id={`${group.anchor}-help`} data-help-group>
          <header class="section-head">
            <div><p><span aria-hidden="true"></span>{group.label}</p><h2>{group.description}</h2></div>
            <span data-group-count>{group.tools.length} guides</span>
          </header>
          <div class="guide-grid">
            {group.tools.map((tool) => {
              const entry = entryBySlug.get(tool.slug);
              const search = [tool.searchName, tool.name, tool.blurb, group.label, ...helpKeywords(tool), ...(entry?.data.faqs.map((faq) => faq.question) ?? [])].join(' ').toLocaleLowerCase();
              return (
                <article class="guide-card" data-help-card data-search={search}>
                  <a class="guide-card__hit" href={guideHref(tool.slug)} aria-label={`Read the ${tool.searchName} guide`}></a>
                  <div class="guide-card__top"><ToolIcon slug={tool.slug} tone={group.tone} size="2.7rem" /><span>{(entry?.data.faqs.length ?? 4) + 2} FAQs</span></div>
                  <p>{group.label}</p>
                  <h3>How to use {tool.searchName}</h3>
                  <div>{helpArticleDescription(tool)}</div>
                  <strong>Read complete guide <span aria-hidden="true">→</span></strong>
                </article>
              );
            })}
          </div>
        </section>
      ))}
    </div>

    <section class="help-empty" data-help-empty hidden>
      <p>No guide matches that search yet.</p>
      <span>Try a task such as “sign”, “scan”, “pages”, “convert”, “password”, or “compress”.</span>
    </section>

    <section class="help-close">
      <p>Every guide follows the same promise</p>
      <h2>Understand the change before you make it.</h2>
      <div>
        <span><b>01</b> What the tool does</span>
        <span><b>02</b> How to use it</span>
        <span><b>03</b> What to check</span>
        <span><b>04</b> Where the file goes</span>
      </div>
    </section>
  </main>
  <HelpFooter />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionSchema)}></script>
</BaseLayout>

<script>
  const helpQuery = document.querySelector<HTMLInputElement>('[data-help-query]');
  const helpSearch = document.querySelector<HTMLFormElement>('[data-help-search]');
  const helpCards = [...document.querySelectorAll<HTMLElement>('[data-help-card]')];
  const helpGroups = [...document.querySelectorAll<HTMLElement>('[data-help-group]')];
  const helpResults = document.querySelector<HTMLElement>('[data-help-results]');
  const helpEmpty = document.querySelector<HTMLElement>('[data-help-empty]');

  const filterHelp = () => {
    const query = helpQuery?.value.trim().toLocaleLowerCase() ?? '';
    let visible = 0;
    helpCards.forEach((card) => {
      const show = !query || (card.dataset.search ?? '').includes(query);
      card.hidden = !show;
      if (show) visible += 1;
    });
    helpGroups.forEach((group) => {
      const count = group.querySelectorAll<HTMLElement>('[data-help-card]:not([hidden])').length;
      group.hidden = count === 0;
      const label = group.querySelector<HTMLElement>('[data-group-count]');
      if (label) label.textContent = `${count} guide${count === 1 ? '' : 's'}`;
    });
    if (helpResults) helpResults.textContent = query ? `${visible} guide${visible === 1 ? '' : 's'} found for “${helpQuery?.value.trim()}”` : `${visible} guides available`;
    if (helpEmpty) helpEmpty.hidden = visible !== 0;
  };

  helpQuery?.addEventListener('input', filterHelp);
  helpSearch?.addEventListener('submit', (event) => {
    event.preventDefault();
    filterHelp();
  });
  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement | null;
    if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey || target?.closest('input, textarea, select, [contenteditable]')) return;
    event.preventDefault();
    helpQuery?.focus();
  });
</script>

<style>
  .help-home { width: min(76rem, calc(100% - (var(--gutter) * 2))); margin: 0 auto; padding: clamp(2.2rem, 6vw, 5rem) 0 5rem; }
  .breadcrumbs { display: flex; gap: 0.5rem; color: var(--muted); font-size: var(--step--2); }
  .breadcrumbs a { color: inherit; text-decoration: none; }
  .breadcrumbs a:hover { color: var(--accent); }
  .help-hero { position: relative; max-width: 66rem; padding-bottom: clamp(3rem, 7vw, 5.5rem); }
  .eyebrow { display: flex; align-items: center; gap: 0.55rem; margin: 2.8rem 0 0.9rem; color: var(--muted); font: 700 var(--step--2)/1 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; }
  .eyebrow span { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 5px color-mix(in srgb, var(--ok) 12%, transparent); }
  h1 { max-width: 13ch; margin: 0; font-size: clamp(2.8rem, 7vw, 5.8rem); line-height: 0.96; letter-spacing: -0.055em; }
  .help-hero__intro { max-width: 48rem; margin: 1.3rem 0 0; color: var(--ink-2); font-size: var(--step-1); line-height: 1.65; }
  .help-search { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; max-width: 48rem; min-height: 4rem; margin-top: 1.8rem; padding: 0 1rem; border: 1px solid var(--line-strong); border-radius: calc(var(--radius) * 1.15); background: var(--paper-raised); box-shadow: var(--shadow-paper); }
  .help-search > span { color: var(--accent); font-size: 1.6rem; }
  .help-search input { min-width: 0; padding: 0.8rem; border: 0; outline: 0; background: transparent; color: var(--ink); font: 600 var(--step-0)/1 var(--font-sans); }
  .help-search:focus-within { border-color: var(--accent); box-shadow: var(--shadow-paper), 0 0 0 4px color-mix(in srgb, var(--accent) 9%, transparent); }
  .help-search kbd { color: var(--muted); font: 650 var(--step--2)/1 var(--font-mono); }
  .help-results { min-height: 1.4rem; margin: 0.65rem 0 0; color: var(--muted); font-size: var(--step--2); }
  .help-jumps { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.1rem; }
  .help-jumps a { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.5rem 0.72rem; border: 1px solid var(--line); border-radius: 999px; background: var(--paper); color: var(--ink-2); font-size: var(--step--2); font-weight: 650; text-decoration: none; }
  .help-jumps a:hover { border-color: var(--accent); color: var(--accent); }
  .help-jumps span { color: var(--muted); font-family: var(--font-mono); }
  .section-head { display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; margin-bottom: 1.1rem; }
  .section-head p { display: flex; align-items: center; gap: 0.5rem; margin: 0 0 0.35rem; color: var(--accent); font: 700 var(--step--2)/1 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; }
  .section-head p span { width: 0.48rem; height: 0.48rem; border-radius: 50%; background: var(--group-color, var(--accent)); }
  .section-head h2 { max-width: 28ch; margin: 0; font-size: var(--step-2); }
  .section-head > span { color: var(--muted); font-size: var(--step--2); }
  .popular { margin-bottom: clamp(4rem, 8vw, 7rem); }
  .popular__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
  .popular__grid a { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 0.85rem; padding: 0.85rem; border: 1px solid var(--line); border-radius: calc(var(--radius) * 1.15); background: var(--paper-raised); color: var(--ink); text-decoration: none; }
  .popular__grid a:hover { border-color: color-mix(in srgb, var(--accent) 52%, var(--line)); transform: translateY(-2px); }
  .popular__grid a > span { display: grid; gap: 0.15rem; min-width: 0; }
  .popular__grid small { color: var(--muted); font: 650 var(--step--2)/1 var(--font-mono); text-transform: uppercase; }
  .popular__grid strong { font-size: var(--step-0); }
  .popular__grid em { overflow: hidden; color: var(--ink-2); font-size: var(--step--2); font-style: normal; text-overflow: ellipsis; white-space: nowrap; }
  .popular__grid b { color: var(--accent); }
  .help-library { display: grid; gap: clamp(4rem, 8vw, 6.5rem); }
  .help-group--organize { --group-color: #f97316; }
  .help-group--optimize { --group-color: #65a30d; }
  .help-group--to-pdf { --group-color: #eab308; }
  .help-group--from-pdf { --group-color: #3b82f6; }
  .help-group--compose { --group-color: #c026d3; }
  .help-group--review { --group-color: #7c3aed; }
  .help-group--secure { --group-color: #0f766e; }
  .guide-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; }
  .guide-card { position: relative; display: grid; align-content: start; min-height: 20rem; padding: 1.15rem; overflow: hidden; border: 1px solid var(--line); border-radius: calc(var(--radius) * 1.15); background: linear-gradient(155deg, var(--paper-raised), color-mix(in srgb, var(--group-color) 3%, var(--paper))); box-shadow: 0 12px 30px -30px rgb(15 23 42 / 0.42); }
  .guide-card::after { content: ''; position: absolute; right: -2.5rem; bottom: -2.5rem; width: 8rem; height: 8rem; border: 1px solid color-mix(in srgb, var(--group-color) 18%, transparent); border-radius: 50%; }
  .guide-card:hover { border-color: color-mix(in srgb, var(--group-color) 48%, var(--line)); transform: translateY(-3px); }
  .guide-card[hidden] { display: none; }
  .guide-card__hit { position: absolute; inset: 0; z-index: 2; }
  .guide-card__top { display: flex; align-items: start; justify-content: space-between; }
  .guide-card__top > span { padding: 0.35rem 0.5rem; border-radius: 999px; background: var(--paper-sunk); color: var(--muted); font: 650 var(--step--2)/1 var(--font-mono); }
  .guide-card > p { margin: 1rem 0 0.35rem; color: var(--group-color); font: 700 var(--step--2)/1 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .guide-card h3 { margin: 0; font-size: var(--step-1); }
  .guide-card > div:not(.guide-card__top) { margin-top: 0.7rem; color: var(--ink-2); font-size: var(--step--1); line-height: 1.55; }
  .guide-card > strong { margin-top: auto; padding-top: 1.2rem; color: var(--accent); font-size: var(--step--1); }
  .help-empty { margin: 2rem 0; padding: 2rem; border: 1px dashed var(--line-strong); border-radius: calc(var(--radius) * 1.15); text-align: center; }
  .help-empty p { margin: 0 0 0.4rem; font-weight: 700; }
  .help-empty span { color: var(--muted); }
  .help-close { margin-top: clamp(5rem, 10vw, 9rem); padding: clamp(1.5rem, 5vw, 3.2rem); border: 1px solid var(--line); border-radius: calc(var(--radius) * 1.3); background: var(--paper-sunk); }
  .help-close > p { margin: 0 0 0.5rem; color: var(--accent); font: 700 var(--step--2)/1 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; }
  .help-close h2 { max-width: 18ch; margin: 0; font-size: var(--step-3); }
  .help-close > div { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.75rem; margin-top: 2rem; }
  .help-close span { display: grid; gap: 0.5rem; padding-top: 0.8rem; border-top: 1px solid var(--line-strong); color: var(--ink-2); font-size: var(--step--1); }
  .help-close b { color: var(--accent); font: 650 var(--step--2)/1 var(--font-mono); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  @media (max-width: 60rem) { .guide-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 44rem) {
    .help-home { padding-top: 1.5rem; }
    h1 { max-width: 10ch; font-size: clamp(2.55rem, 13vw, 4rem); overflow-wrap: anywhere; }
    .popular__grid, .guide-grid { grid-template-columns: 1fr; }
    .guide-card { min-height: 17rem; }
    .section-head { align-items: start; flex-direction: column; gap: 0.45rem; }
    .help-close > div { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (prefers-reduced-motion: reduce) { .popular__grid a, .guide-card { transition: none; } }
</style>
