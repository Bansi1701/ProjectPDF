---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import PdfTool from '../components/PdfTool.astro';
import ToolGuide from '../components/ToolGuide.astro';
---

<BaseLayout title="PowerPoint to PDF — HatePDF" description="One page per slide, with text and pictures exactly where PowerPoint put them. Converted in this tab.">
  <Masthead />
  <main id="main">
    <PdfTool mode="powerpoint-to-pdf" eyebrow="Converted here, not on a server" title="PowerPoint to PDF" description="One page per slide, with text and pictures exactly where PowerPoint put them. Converted in this tab." />
    <ToolGuide slug="powerpoint-to-pdf" />
  </main>
</BaseLayout>
