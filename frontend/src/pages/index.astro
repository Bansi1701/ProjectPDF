---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Lens from '../components/Lens.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { SERVER_ONLY_REASONS, SITE, TOOLS } from '../config/site';
import { NAVIGATION_GROUPS } from '../config/navigation';

const steps = [
  { n: '1', title: 'You pick a file', body: 'The browser hands the tool a copy in memory. No request is made.' },
  { n: '2', title: 'Your CPU does the work', body: 'A Web Worker runs the operation off the main thread, so the page stays responsive.' },
  { n: '3', title: 'You save the result', body: 'Close the tab and every trace of it is gone. There was never a second copy.' },
];

/* What a completed job is allowed to log. Mirrors the repo's logging rule:
   job id, tool, duration, byte counts — never filenames or content. */
const crossings: [string, string][] = [
  ['job', 'a3f9c1'],
  ['tool', 'merge'],
  ['duration', '412ms'],
  ['bytes out', '0'],
];

const promises = [
  { figure: '0', label: 'bytes uploaded' },
  { figure: '0', label: 'files stored' },
  { figure: '0', label: 'accounts required' },
];

/* Spelled from the array, so the prose can never drift from the list again —
   it already had, claiming six where four were printed. */
const NUMBER_WORDS = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight'];
const serverOnlyCount = NUMBER_WORDS[SERVER_ONLY_REASONS.length] ?? String(SERVER_ONLY_REASONS.length);

const liveTools = TOOLS.filter((tool) => tool.status === 'live');

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const brandMark = `${baseUrl}brand/pdfcraft-fold-mark.png`;
---

<BaseLayout title={`${SITE.name} — ${SITE.tagline}`} description={SITE.description}>
  <Masthead />

  <main id="main" class="home-main">
    <div class="page-watermarks" aria-hidden="true">
      <span class="page-watermark page-watermark--a"><img src={brandMark} alt="" /></span>
      <span class="page-watermark page-watermark--b"><img src={brandMark} alt="" /></span>
      <span class="page-watermark page-watermark--c"><img src={brandMark} alt="" /></span>
      <span class="page-watermark page-watermark--d"><img src={brandMark} alt="" /></span>
      <span class="page-watermark page-watermark--e"><img src={brandMark} alt="" /></span>
      <span class="page-watermark page-watermark--f"><img src={brandMark} alt="" /></span>
    </div>
    <!-- ── Hero: the desk ─────────────────────────────────────────────── -->
    <section class="hero wrap">
      <div class="brand-cascade" aria-hidden="true">
        <span class="brand-watermark brand-watermark--one"><img src={brandMark} alt="" /></span>
        <span class="brand-watermark brand-watermark--two"><img src={brandMark} alt="" /></span>
        <span class="brand-watermark brand-watermark--three"><img src={brandMark} alt="" /></span>
      </div>
      <div class="hero__copy">
        <p class="eyebrow"><span class="dot"></span>Private document workspace</p>

        <h1>Private PDF tools.<br />No upload. No account.</h1>

        <p class="lede">
          Merge, split, compress, edit, sign, and convert PDFs on this device. There is no
          daily limit, and the result stays yours.
        </p>

        <div class="hero__actions">
          <a class="btn btn--primary" href={`${baseUrl}merge-pdf/`}>Merge PDFs</a>
          <a class="btn btn--quiet" href="#tools">Choose another tool</a>
        </div>

        <ul class="hero__proof" aria-label={`${SITE.name} benefits`}>
          <li><span>01</span> Free to use</li>
          <li><span>02</span> {liveTools.length} working tools</li>
          <li><span>03</span> No daily limit</li>
        </ul>

        <nav class="shortcuts category-shortcuts" aria-label="Jump to a PDF tool category">
          {
            NAVIGATION_GROUPS.map((group) => (
              <a class={`shortcuts__item shortcuts__item--${group.tone}`} href={`#${group.anchor}`}>
                <span class="shortcuts__mark" aria-hidden="true"><i></i></span>
                <span>{group.label}</span>
                <small>{group.tools.length}</small>
              </a>
            ))
          }
          <a class="shortcuts__all" href="#tools">All {liveTools.length} tools <span aria-hidden="true">↓</span></a>
        </nav>

        <p class="hero__meta">Your file stays on this device · <a href="#proof">See the browser measure it</a></p>
      </div>

      <!-- The metaphor: a sheet of paper with a glass lens laid across it -->
      <figure class="hero__desk" aria-hidden="true">
        <div class="sheet page">
          <div class="page__topline"><span>{SITE.name.toUpperCase()} / DOCUMENT STUDIO</span><i></i></div>
          <div class="page__rule page__rule--title"></div>
          <div class="page__rule" style="width: 92%"></div>
          <div class="page__rule" style="width: 86%"></div>
          <div class="page__rule" style="width: 94%"></div>
          <div class="page__rule" style="width: 61%"></div>
          <div class="page__gap"></div>
          <div class="page__rule" style="width: 88%"></div>
          <div class="page__rule" style="width: 95%"></div>
          <div class="page__rule" style="width: 72%"></div>
          <div class="page__footer"><span></span><span></span><span></span></div>
        </div>

        <Lens variant="loupe" class="loupe">
          <p class="loupe__label">Document stage</p>
          <p class="loupe__figure">Ready <span>to work</span></p>
          <p class="loupe__status"><i class="led"></i>processing: on device</p>
        </Lens>

        <ul class="hero__tool-orbit">
          <li class="orbit-card orbit-card--merge"><b>↗</b><span>Merge</span></li>
          <li class="orbit-card orbit-card--split"><b>✦</b><span>Split</span></li>
          <li class="orbit-card orbit-card--secure"><b>⌁</b><span>Protect</span></li>
        </ul>
      </figure>
    </section>

    <!-- ── Tools ──────────────────────────────────────────────────────── -->
    <section class="tools wrap reveal" id="tools">
      <header class="section-head">
        <h2>Choose your next step</h2>
        <p class="section-head__deck">
          Start with a clear outcome. Every tool labelled <em>in your browser</em> handles the
          document on your machine.
        </p>
      </header>

      <div class="cluster cluster--yours" id="yours" data-yours hidden>
        <h3 class="cluster__name">Your tools</h3>
        <nav class="shortcuts" data-yours-row aria-label="Your saved tools"></nav>
      </div>

      {
        NAVIGATION_GROUPS.map((group) => (
          <div class={`cluster cluster--${group.tone}`} id={group.anchor}>
            <header class="cluster__head">
              <div>
                <span class="cluster__signal" aria-hidden="true"></span>
                <h3 class="cluster__name">{group.label}</h3>
                <small>{group.tools.length} tools</small>
              </div>
              <p>{group.description}</p>
            </header>
            <ul class="grid">
              {group.tools.map((tool) => (
                <li class={`sheet card card--${group.tone}`} data-tool-card data-slug={tool.slug} data-name={tool.name} data-search={`${tool.searchName} ${tool.name} ${tool.blurb} ${group.label}`.toLowerCase()}>
                  <a class="card__link" href={`${baseUrl}${tool.slug}/`} aria-label={`Open ${tool.name}`}></a>
                  <button class="card__star" type="button" data-fav={tool.slug} aria-pressed="false" aria-label={`Keep ${tool.name} in your tools`} title="Keep in your tools">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3.5 2.6 5.6 6.1.8-4.5 4.2 1.2 6L12 17.2 6.6 20.1l1.2-6-4.5-4.2 6.1-.8Z" /></svg>
                  </button>
                  <ToolIcon slug={tool.slug} tone={group.tone} size="3.9rem" class="card__icon" />
                  <p class="card__category">{group.label}</p>
                  <h4 class="card__name">{tool.name}</h4>
                  <p class="card__blurb">{tool.blurb}</p>
                  <p class="card__where">in your browser</p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <!-- ── The receipt ────────────────────────────────────────────────── -->
    <section class="receipt" id="proof">
      <div class="wrap">
        <ul class="receipt__row">
          {
            promises.map((item) => (
              <li>
                <span class="receipt__figure">{item.figure}</span>
                <span class="receipt__label">{item.label}</span>
              </li>
            ))
          }
          <li class="receipt__verdict">
            <span class="receipt__verdict-line">Privacy the browser can report</span>
            <span class="receipt__label">measured after you choose a file</span>
          </li>
        </ul>
        <div data-proof-counter-home></div>
        <p class="receipt__note">
          The counter separates support assets such as the PDF engine from non-asset requests.
          A competitor can copy the words; it cannot keep this reading at zero while uploading a PDF.
        </p>

        <div class="boundary"><span>device boundary</span></div>

        <ul class="telemetry">
          {
            crossings.map(([key, value]) => (
              <li><span>{key}</span><b>{value}</b></li>
            ))
          }
        </ul>
        <p class="telemetry__note">Job timing and byte counts can be shown without a filename, page text, or document content leaving this tab.</p>
      </div>
    </section>

    <!-- ── How it works ───────────────────────────────────────────────── -->
    <section class="how reveal" id="how">
      <div class="wrap">
        <header class="section-head">
          <h2>How it works</h2>
          <p class="section-head__deck">
            The mechanism is the trust. If you can follow it, you do not have to take our
            word for anything — and you can see exactly which step is missing.
          </p>
        </header>

        <ol class="steps">
          {
            steps.map((step) => (
              <li class="sheet step">
                <span class="step__n">{step.n}</span>
                <h3 class="step__title">{step.title}</h3>
                <p class="step__body">{step.body}</p>
              </li>
            ))
          }

          <!-- The absence is the argument. Deliberately empty. -->
          <li class="step step--absent">
            <span class="step__n">4</span>
            <h3 class="step__title">Upload to our server</h3>
            <p class="step__body">Not implemented. There is no endpoint to call.</p>
          </li>
        </ol>

        <p class="how__never">
          <span class="how__strike">Your file → our server → back to you</span>
          <span class="how__seal">never happens</span>
        </p>
      </div>
    </section>

    <!-- ── Honest limits ──────────────────────────────────────────────── -->
    <section class="limits wrap reveal">
      <div class="limits__intro">
        <h2>What we can't do in your browser</h2>
        <p class="lede">
          {serverOnlyCount} things genuinely need a server. We would rather name them than quietly
          route your file somewhere and hope you don't check.
        </p>
        <p class="limits__closing">
          These are labelled wherever they appear. The file is deleted the moment the job
          finishes — and it is the only time a file of yours leaves your machine at all.
        </p>
      </div>

      <dl class="limits__list">
        {
          SERVER_ONLY_REASONS.map((item) => (
            <div class="limits__item">
              <dt>{item.what}</dt>
              <dd>{item.why}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- ── Close ──────────────────────────────────────────────────────── -->
    <section class="close reveal">
      <div class="wrap">
        <h2 class="close__line">Pick a file. Shape the result.<br />Keep it private.</h2>
        <p class="close__note">
          Every local tool keeps the document in the browser tab. When you save, you take the
          result with you — nothing is left behind.
        </p>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap">
      <div class="footer__cols">
        {
          NAVIGATION_GROUPS.map((group) => (
            <div>
              <h4>{group.label}</h4>
              <ul>
                {group.tools.map((tool) => (
                  <li><a href={`${baseUrl}${tool.slug}/`}>{tool.name}</a></li>
                ))}
              </ul>
            </div>
          ))
        }
        <div>
          <h4>Project</h4>
          <ul>
            <li><a href={`${baseUrl}how-to/`}>Connected recipes</a></li>
            <li><a href={`${baseUrl}privacy/`}>Privacy</a></li>
            <li><a href={`${baseUrl}terms/`}>Terms</a></li>
            <li><a href={`${baseUrl}about/`}>About</a></li>
            <li><a href={`${baseUrl}vs/ilovepdf/`}>Compare with iLovePDF</a></li>
            <li><a href={`${baseUrl}vs/smallpdf/`}>Compare with Smallpdf</a></li>
          </ul>
        </div>
      </div>

      <div class="footer__base">
        <span class="footer__brand">{SITE.name}</span>
        <span class="footer__colophon">
          Appearance follows your system · Built so that we couldn't read your documents
          even if we wanted to.
        </span>
      </div>
    </div>
  </footer>
</BaseLayout>

<script>
  /* ── Your tools ────────────────────────────────────────────────────────
     Kept in this browser, like everything else here. Nobody is asked to make
     an account to remember which five of forty tools they actually use. */
  const FAVOURITES = 'projectpdf-favourites';
  const yours = document.querySelector<HTMLElement>('[data-yours]');
  const yoursRow = document.querySelector<HTMLElement>('[data-yours-row]');
  const stars = [...document.querySelectorAll<HTMLButtonElement>('[data-fav]')];

  const readFavourites = (): string[] => {
    try {
      const raw = JSON.parse(localStorage.getItem(FAVOURITES) ?? '[]');
      return Array.isArray(raw) ? raw.filter((item): item is string => typeof item === 'string') : [];
    } catch {
      // Private mode, or storage the browser refuses. Not worth an error.
      return [];
    }
  };

  function paintFavourites() {
    const saved = readFavourites();
    const set = new Set(saved);
    for (const star of stars) {
      star.setAttribute('aria-pressed', String(set.has(star.dataset.fav ?? '')));
    }

    if (!yours || !yoursRow) return;
    yoursRow.replaceChildren(
      ...saved
        .map((slug) => document.querySelector<HTMLElement>(`[data-tool-card][data-slug="${slug}"]`))
        .filter((card): card is HTMLElement => Boolean(card))
        .map((card) => {
          const link = document.createElement('a');
          link.className = 'shortcuts__item';
          link.href = card.querySelector<HTMLAnchorElement>('.card__link')?.href ?? '#';
          link.textContent = card.dataset.name ?? '';
          return link;
        })
    );
    yours.hidden = yoursRow.childElementCount === 0;
  }

  for (const star of stars) {
    star.addEventListener('click', () => {
      const slug = star.dataset.fav;
      if (!slug) return;
      const saved = readFavourites();
      const next = saved.includes(slug) ? saved.filter((item) => item !== slug) : [...saved, slug];
      try {
        localStorage.setItem(FAVOURITES, JSON.stringify(next));
      } catch {
        // Nothing to do but leave the star as it was.
      }
      paintFavourites();
    });
  }

  paintFavourites();

</script>

<style>
  /* Home-only brand field: this stops before a visitor opens a real tool.
     It sits above the page's broad surfaces but remains too faint to interfere
     with controls, text, or document previews. */
  .home-main {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }

  .page-watermarks {
    position: absolute;
    z-index: 3;
    inset: 0;
    pointer-events: none;
  }

  .page-watermark {
    position: absolute;
    display: block;
    width: 10rem;
    opacity: 0.038;
    filter: grayscale(0.25) drop-shadow(0 10px 12px rgb(15 23 42 / 0.14));
  }

  .page-watermark::before {
    content: '';
    position: absolute;
    bottom: 100%;
    left: 50%;
    width: 1px;
    height: 3.5rem;
    background: linear-gradient(transparent, color-mix(in srgb, var(--accent) 36%, var(--line)));
  }

  .page-watermark img { display: block; width: 100%; height: auto; }
  .page-watermark--a { top: 3%; left: -3%; width: 12rem; transform: rotate(-18deg); }
  .page-watermark--b { top: 18%; right: 4%; width: 8.5rem; transform: rotate(12deg); }
  .page-watermark--c { top: 34%; left: 6%; width: 10rem; transform: rotate(9deg); }
  .page-watermark--d { top: 51%; right: -2%; width: 13rem; transform: rotate(-14deg); }
  .page-watermark--e { top: 69%; left: 13%; width: 8rem; transform: rotate(-10deg); }
  .page-watermark--f { top: 84%; right: 10%; width: 11rem; transform: rotate(15deg); }

  :global(:root[data-theme='dark']) .page-watermark {
    opacity: 0.075;
    filter: grayscale(0.2) brightness(2.4) contrast(0.65) drop-shadow(0 10px 16px rgb(0 0 0 / 0.46));
    mix-blend-mode: screen;
  }

  /* ── Hero ─────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: clamp(3rem, 2rem + 5vw, 5rem);
    padding-block: clamp(2.75rem, 2rem + 3.5vw, 4.75rem) clamp(2.75rem, 2rem + 3vw, 4.25rem);
  }

  .hero::before {
    content: '';
    position: absolute;
    z-index: -2;
    width: min(43vw, 39rem);
    aspect-ratio: 1;
    right: -16rem;
    top: 6%;
    border-radius: 50%;
    background: radial-gradient(circle at 32% 36%, rgb(251 113 133 / 0.45), transparent 25%),
      radial-gradient(circle at 65% 57%, rgb(125 211 252 / 0.38), transparent 36%),
      radial-gradient(circle at 48% 47%, rgb(196 181 253 / 0.34), transparent 67%);
    filter: blur(6px);
  }

  .hero::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: auto 0 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--line), transparent);
  }

  /* The brand appears as a physical impression on the workspace, never as a
     competing hero illustration. The primary mark is exactly 3× the header
     mark (5.25rem vs. 1.75rem); the two small marks make the motif memorable. */
  .brand-cascade {
    position: absolute;
    z-index: -1;
    inset: -5rem 0 auto;
    height: 23rem;
    overflow: hidden;
    pointer-events: none;
  }

  .brand-watermark {
    position: absolute;
    display: block;
    padding-top: 1.6rem;
    opacity: 0.11;
    filter: drop-shadow(0 9px 9px rgb(15 23 42 / 0.18));
  }

  .brand-watermark::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 1px;
    height: 1.6rem;
    background: linear-gradient(transparent, color-mix(in srgb, var(--accent) 45%, var(--line)));
  }

  .brand-watermark img { display: block; width: 100%; height: auto; }

  .brand-watermark--one {
    top: 0.75rem;
    left: 7%;
    width: 15.75rem;
    transform: rotate(-7deg);
  }

  .brand-watermark--two {
    top: 6rem;
    left: 56%;
    width: 4.5rem;
    opacity: 0.07;
    transform: rotate(11deg);
  }

  .brand-watermark--three {
    top: 1.5rem;
    right: 5%;
    width: 5.25rem;
    opacity: 0.08;
    transform: rotate(-14deg);
  }

  :global(:root[data-theme='dark']) .brand-watermark {
    opacity: 0.23;
    filter: grayscale(0.2) brightness(2.8) contrast(0.65) drop-shadow(0 10px 16px rgb(0 0 0 / 0.55));
    mix-blend-mode: screen;
  }

  :global(:root[data-theme='dark']) .brand-watermark--one { opacity: 0.3; }
  :global(:root[data-theme='dark']) .brand-watermark--two { opacity: 0.16; }
  :global(:root[data-theme='dark']) .brand-watermark--three { opacity: 0.18; }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--ok);
  }

  h1 {
    font-size: clamp(2.6rem, 1.9rem + 3vw, 4.15rem);
    margin-block: 1rem 1.1rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.4rem;
  }

  .hero__meta {
    margin-top: 1.25rem;
    font-size: var(--step--2);
    color: var(--muted);
  }

  /* the desk: a sheet with a lens lying across its lower edge */
  .hero__desk {
    position: relative;
    isolation: isolate;
    margin: 0;
    padding: 1.5rem 1.5rem 4.5rem;
    border: 1px solid color-mix(in srgb, var(--line) 88%, transparent);
    border-radius: 28px;
    background: linear-gradient(145deg, color-mix(in srgb, var(--paper-raised) 88%, transparent), color-mix(in srgb, var(--paper-sunk) 76%, transparent));
    box-shadow: 0 32px 60px -46px rgb(15 23 42 / 0.5);
  }

  /* Light falling across the desk. Without something varied behind it, the
     lens has nothing to refract and reads as a flat card. */
  .hero__desk::before {
    content: '';
    position: absolute;
    inset: -14% -10% -8%;
    z-index: -1;
    background:
      radial-gradient(58% 52% at 74% 14%, var(--desk-warm), transparent 68%),
      radial-gradient(52% 48% at 16% 84%, var(--desk-cool), transparent 70%),
      radial-gradient(44% 40% at 92% 76%, var(--desk-blush), transparent 72%);
    filter: blur(10px);
    pointer-events: none;
  }

  .hero__proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.1rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--ink-2);
    font-size: var(--step--2);
    font-weight: 600;
  }

  .hero__proof li { display: inline-flex; align-items: center; gap: 0.4rem; }
  .hero__proof span {
    display: grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    font-family: var(--font-mono);
    font-size: 0.56rem;
  }

  .hero__desk::after {
    content: '';
    position: absolute;
    width: 11rem;
    height: 4.5rem;
    right: 18%;
    top: -1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--accent) 45%, var(--line));
    border-radius: 50%;
    transform: rotate(-18deg);
    opacity: 0.55;
    pointer-events: none;
  }

  .page {
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    display: grid;
    gap: 0.75rem;
    transform: rotate(-1.1deg) translateX(-0.35rem);
    box-shadow: 0 20px 45px -32px rgb(15 23 42 / 0.45);
  }

  .page__topline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.12em;
  }

  .page__topline i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .page__rule {
    height: 0.5rem;
    border-radius: 2px;
    background: var(--line);
    width: 100%;
  }

  .page__rule--title {
    height: 0.875rem;
    width: 54%;
    background: var(--line-strong);
    margin-bottom: 0.5rem;
