---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Lens from '../components/Lens.astro';
import { CATEGORIES, SERVER_ONLY_REASONS, SITE, TOOLS, toolsByCategory } from '../config/site';

const steps = [
  { n: '1', title: 'You pick a file', body: 'The browser hands the tool a copy in memory. No request is made.' },
  { n: '2', title: 'Your CPU does the work', body: 'A Web Worker runs the operation off the main thread, so the page stays responsive.' },
  { n: '3', title: 'You save the result', body: 'Close the tab and every trace of it is gone. There was never a second copy.' },
];

/* What a completed job is allowed to log. Mirrors the repo's logging rule:
   job id, tool, duration, byte counts — never filenames or content. */
const crossings: [string, string][] = [
  ['job', 'a3f9c1'],
  ['tool', 'merge'],
  ['duration', '412ms'],
  ['bytes out', '0'],
];

const promises = [
  { figure: '0', label: 'bytes uploaded' },
  { figure: '0', label: 'files stored' },
  { figure: '0', label: 'accounts required' },
];

/* Spelled from the array, so the prose can never drift from the list again —
   it already had, claiming six where four were printed. */
const NUMBER_WORDS = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight'];
const serverOnlyCount = NUMBER_WORDS[SERVER_ONLY_REASONS.length] ?? String(SERVER_ONLY_REASONS.length);

/* The eight jobs people most often arrive wanting. On a return visit the
   browser replaces these with the visitor's own most-used tools. */
const SHORTCUTS = ['merge-pdf', 'split-pdf', 'compress-pdf', 'edit-pdf', 'sign-pdf', 'scan-pdf', 'protect-pdf', 'pdf-to-word'];
const shortcuts = SHORTCUTS.map((slug) => TOOLS.find((tool) => tool.slug === slug)!).filter(Boolean);
const liveTools = TOOLS.filter((tool) => tool.status === 'live');

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const brandMark = `${baseUrl}brand/pdfcraft-fold-mark.png`;
---

<BaseLayout title={`${SITE.name} — ${SITE.tagline}`} description={SITE.description}>
  <Masthead />

  <main id="main" class="home-main">
    <div class="page-watermarks" aria-hidden="true">
      <span class="page-watermark page-watermark--a"><img src={brandMark} alt="" /></span>
      <span class="page-watermark page-watermark--b"><img src={brandMark} alt="" /></span>
      <span class="page-watermark page-watermark--c"><img src={brandMark} alt="" /></span>
      <span class="page-watermark page-watermark--d"><img src={brandMark} alt="" /></span>
      <span class="page-watermark page-watermark--e"><img src={brandMark} alt="" /></span>
      <span class="page-watermark page-watermark--f"><img src={brandMark} alt="" /></span>
    </div>
    <!-- ── Hero: the desk ─────────────────────────────────────────────── -->
    <section class="hero wrap">
      <div class="brand-cascade" aria-hidden="true">
        <span class="brand-watermark brand-watermark--one"><img src={brandMark} alt="" /></span>
        <span class="brand-watermark brand-watermark--two"><img src={brandMark} alt="" /></span>
        <span class="brand-watermark brand-watermark--three"><img src={brandMark} alt="" /></span>
      </div>
      <div class="hero__copy">
        <p class="eyebrow"><span class="dot"></span>Private document workspace</p>

        <h1>Free PDF tools.<br />No sign-up. No daily limit.</h1>

        <p class="lede">
          Merge, split, compress, edit, sign, and convert PDFs without sending the document
          away. The work happens in this browser and the result stays yours.
        </p>

        <ul class="hero__proof" aria-label={`${SITE.name} benefits`}>
          <li><span>01</span> Free to use</li>
          <li><span>02</span> No account</li>
          <li><span>03</span> No daily limit</li>
        </ul>

        <!-- Search that answers where you type it. Filtering a grid a thousand
             pixels further down is a search box that appears to do nothing. -->
        <div class="quickfind">
          <label class="quickfind__field">
            <span class="sr-only">Search tools</span>
            <svg class="quickfind__icon" viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="9" cy="9" r="6"></circle><path d="m13.5 13.5 4 4" stroke-linecap="round"></path>
            </svg>
            <input
              type="search"
              data-tool-search
              placeholder={`Search ${liveTools.length} tools — merge, sign, redact…`}
              autocomplete="off"
              role="combobox"
              aria-expanded="false"
              aria-controls="quickfind-results"
            />
          </label>

          <ul class="quickfind__results" id="quickfind-results" data-tool-search-results hidden>
            {
              liveTools.map((tool) => (
                <li data-search={`${tool.searchName} ${tool.name} ${tool.blurb} ${tool.category}`.toLowerCase()} hidden>
                  <a href={`${baseUrl}${tool.slug}/`}>
                    <strong>{tool.name}</strong>
                    <span>{tool.blurb}</span>
                  </a>
                </li>
              ))
            }
            <li class="quickfind__empty" data-tool-search-empty hidden>No tool matches that yet.</li>
          </ul>
        </div>

        <nav class="shortcuts" aria-label="Popular tools" data-popular-tools>
          {
            shortcuts.map((tool) => (
              <a class="shortcuts__item" href={`${baseUrl}${tool.slug}/`} data-shortcut-slug={tool.slug}>
                {tool.name}
              </a>
            ))
          }
          <a class="shortcuts__all" href="#tools">All {liveTools.length} tools →</a>
        </nav>

        <p class="hero__meta">Your file stays on this device · <a href="#proof">See the browser measure it</a></p>
      </div>

      <!-- The metaphor: a sheet of paper with a glass lens laid across it -->
      <figure class="hero__desk" aria-hidden="true">
        <div class="sheet page">
          <div class="page__topline"><span>{SITE.name.toUpperCase()} / DOCUMENT STUDIO</span><i></i></div>
          <div class="page__rule page__rule--title"></div>
          <div class="page__rule" style="width: 92%"></div>
          <div class="page__rule" style="width: 86%"></div>
          <div class="page__rule" style="width: 94%"></div>
          <div class="page__rule" style="width: 61%"></div>
          <div class="page__gap"></div>
          <div class="page__rule" style="width: 88%"></div>
          <div class="page__rule" style="width: 95%"></div>
          <div class="page__rule" style="width: 72%"></div>
          <div class="page__footer"><span></span><span></span><span></span></div>
        </div>

        <Lens variant="loupe" class="loupe">
          <p class="loupe__label">Document stage</p>
          <p class="loupe__figure">Ready <span>to work</span></p>
          <p class="loupe__status"><i class="led"></i>processing: on device</p>
        </Lens>

        <ul class="hero__tool-orbit">
          <li class="orbit-card orbit-card--merge"><b>↗</b><span>Merge</span></li>
          <li class="orbit-card orbit-card--split"><b>✦</b><span>Split</span></li>
          <li class="orbit-card orbit-card--secure"><b>⌁</b><span>Protect</span></li>
        </ul>
      </figure>
    </section>

    <!-- ── Tools ──────────────────────────────────────────────────────── -->
    <section class="tools wrap reveal" id="tools">
      <header class="section-head">
        <h2>Choose your next step</h2>
        <p class="section-head__deck">
          Start with a clear outcome. Every tool labelled <em>in your browser</em> handles the
          document on your machine.
        </p>
      </header>

      <div class="cluster cluster--yours" id="yours" data-yours hidden>
        <h3 class="cluster__name">Your tools</h3>
        <nav class="shortcuts" data-yours-row aria-label="Your saved tools"></nav>
      </div>

      {
        CATEGORIES.map((category) => (
          <div class="cluster" id={category.toLowerCase()}>
            <h3 class="cluster__name">{category}</h3>
            <ul class="grid">
              {toolsByCategory(category).map((tool) => (
                <li class="sheet card" data-tool-card data-slug={tool.slug} data-name={tool.name} data-search={`${tool.searchName} ${tool.name} ${tool.blurb} ${category}`.toLowerCase()}>
                  {tool.status === 'live' && <a class="card__link" href={`${baseUrl}${tool.slug}/`} aria-label={`Open ${tool.name}`}></a>}
                  {tool.status === 'live' && (
                    <button class="card__star" type="button" data-fav={tool.slug} aria-pressed="false" aria-label={`Keep ${tool.name} in your tools`} title="Keep in your tools">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3.5 2.6 5.6 6.1.8-4.5 4.2 1.2 6L12 17.2 6.6 20.1l1.2-6-4.5-4.2 6.1-.8Z" /></svg>
                    </button>
                  )}
                  <p class="card__category">{category}</p>
                  <h4 class="card__name">{tool.name}</h4>
                  <p class="card__blurb">{tool.blurb}</p>
                  <p class:list={['card__where', tool.runsWhere === 'server' && 'is-server']}>
                    {tool.runsWhere === 'local' ? 'in your browser' : 'needs our server'}
                    {tool.status === 'building' && <span class="card__soon">· building now</span>}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <!-- ── The receipt ────────────────────────────────────────────────── -->
    <section class="receipt" id="proof">
      <div class="wrap">
        <ul class="receipt__row">
          {
            promises.map((item) => (
              <li>
                <span class="receipt__figure">{item.figure}</span>
                <span class="receipt__label">{item.label}</span>
              </li>
            ))
          }
          <li class="receipt__verdict">
            <span class="receipt__verdict-line">Privacy the browser can report</span>
            <span class="receipt__label">measured after you choose a file</span>
          </li>
        </ul>
        <div data-proof-counter-home></div>
        <p class="receipt__note">
          The counter separates support assets such as the PDF engine from non-asset requests.
          A competitor can copy the words; it cannot keep this reading at zero while uploading a PDF.
        </p>

        <div class="boundary"><span>device boundary</span></div>

        <ul class="telemetry">
          {
            crossings.map(([key, value]) => (
              <li><span>{key}</span><b>{value}</b></li>
            ))
          }
        </ul>
        <p class="telemetry__note">Job timing and byte counts can be shown without a filename, page text, or document content leaving this tab.</p>
      </div>
    </section>

    <!-- ── How it works ───────────────────────────────────────────────── -->
    <section class="how reveal" id="how">
      <div class="wrap">
        <header class="section-head">
          <h2>How it works</h2>
          <p class="section-head__deck">
            The mechanism is the trust. If you can follow it, you do not have to take our
            word for anything — and you can see exactly which step is missing.
          </p>
        </header>

        <ol class="steps">
          {
            steps.map((step) => (
              <li class="sheet step">
                <span class="step__n">{step.n}</span>
                <h3 class="step__title">{step.title}</h3>
                <p class="step__body">{step.body}</p>
              </li>
            ))
          }

          <!-- The absence is the argument. Deliberately empty. -->
          <li class="step step--absent">
            <span class="step__n">4</span>
            <h3 class="step__title">Upload to our server</h3>
            <p class="step__body">Not implemented. There is no endpoint to call.</p>
          </li>
        </ol>

        <p class="how__never">
          <span class="how__strike">Your file → our server → back to you</span>
          <span class="how__seal">never happens</span>
        </p>
      </div>
    </section>

    <!-- ── Honest limits ──────────────────────────────────────────────── -->
    <section class="limits wrap reveal">
      <div class="limits__intro">
        <h2>What we can't do in your browser</h2>
        <p class="lede">
          {serverOnlyCount} things genuinely need a server. We would rather name them than quietly
          route your file somewhere and hope you don't check.
        </p>
        <p class="limits__closing">
          These are labelled wherever they appear. The file is deleted the moment the job
          finishes — and it is the only time a file of yours leaves your machine at all.
        </p>
      </div>

      <dl class="limits__list">
        {
          SERVER_ONLY_REASONS.map((item) => (
            <div class="limits__item">
              <dt>{item.what}</dt>
              <dd>{item.why}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- ── Close ──────────────────────────────────────────────────────── -->
    <section class="close reveal">
      <div class="wrap">
        <h2 class="close__line">Pick a file. Shape the result.<br />Keep it private.</h2>
        <p class="close__note">
          Every local tool keeps the document in the browser tab. When you save, you take the
          result with you — nothing is left behind.
        </p>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap">
      <div class="footer__cols">
        {
          CATEGORIES.map((category) => (
            <div>
              <h4>{category}</h4>
              <ul>
                {toolsByCategory(category).map((tool) => (
                  <li>
                    {tool.status === 'live' ? (
                      <a href={`${baseUrl}${tool.slug}/`}>{tool.name}</a>
                    ) : (
                      <span class="footer__building" title="This tool is still being built">
                        {tool.name}<small>Building</small>
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <div>
          <h4>Project</h4>
          <ul>
            <li><a href={`${baseUrl}how-to/`}>Connected recipes</a></li>
            <li><a href={`${baseUrl}privacy/`}>Privacy</a></li>
            <li><a href={`${baseUrl}terms/`}>Terms</a></li>
            <li><a href={`${baseUrl}about/`}>About</a></li>
            <li><a href={`${baseUrl}vs/ilovepdf/`}>Compare with iLovePDF</a></li>
            <li><a href={`${baseUrl}vs/smallpdf/`}>Compare with Smallpdf</a></li>
          </ul>
        </div>
      </div>

      <div class="footer__base">
        <span class="footer__brand">{SITE.name}</span>
        <span class="footer__colophon">
          Appearance follows your system · Built so that we couldn't read your documents
          even if we wanted to.
        </span>
      </div>
    </div>
  </footer>
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('[data-tool-search]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-tool-card]')];
  const results = document.querySelector<HTMLElement>('[data-tool-search-results]');
  const empty = document.querySelector<HTMLElement>('[data-tool-search-empty]');
  const options = results ? [...results.querySelectorAll<HTMLElement>('li[data-search]')] : [];

  /* Six is what fits above the fold on a phone without the list becoming the
     page. Anything longer is better answered by the grid below. */
  const SHOWN = 6;

  const links = () => options.filter((option) => !option.hidden).map((o) => o.querySelector('a')!);

  function close() {
    if (results) results.hidden = true;
    search?.setAttribute('aria-expanded', 'false');
  }

  function filterTools(writeUrl = true) {
    if (!search) return;
    const query = search.value.trim().toLowerCase();

    // The grid stays in step, so scrolling down after a search is not confusing.
    cards.forEach((card) => {
      card.hidden = Boolean(query) && !card.dataset.search?.includes(query);
    });

    if (!query) {
      options.forEach((option) => { option.hidden = true; });
      if (empty) empty.hidden = true;
      close();
    } else {
      let shown = 0;
      options.forEach((option) => {
        const match = option.dataset.search?.includes(query) ?? false;
        option.hidden = !match || shown >= SHOWN;
        if (match && shown < SHOWN) shown += 1;
      });

      if (empty) empty.hidden = shown !== 0;
      if (results) results.hidden = false;
      search.setAttribute('aria-expanded', 'true');
    }

    if (writeUrl) {
      const url = new URL(location.href);
      if (query) url.searchParams.set('q', query);
      else url.searchParams.delete('q');
      url.searchParams.delete('focus');
      history.replaceState(null, '', url);
    }
  }

  search?.addEventListener('input', () => filterTools());

  const initial = new URLSearchParams(location.search);
  if (search && initial.get('q')) {
    search.value = initial.get('q') ?? '';
    filterTools(false);
  }
  if (search && initial.get('focus') === 'search') {
    requestAnimationFrame(() => search.focus());
  }

  // A combobox people can drive from the keyboard, not just the mouse.
  search?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') { close(); return; }
    if (event.key === 'ArrowDown') {
      const first = links()[0];
      if (first) { event.preventDefault(); first.focus(); }
    }
  });

  results?.addEventListener('keydown', (event) => {
    const all = links();
    const at = all.indexOf(document.activeElement as HTMLAnchorElement);
    if (at < 0) return;
    if (event.key === 'ArrowDown') { event.preventDefault(); (all[at + 1] ?? all[0]).focus(); }
    if (event.key === 'ArrowUp') { event.preventDefault(); (at === 0 ? search : all[at - 1])?.focus(); }
    if (event.key === 'Escape') { close(); search?.focus(); }
  });

  document.addEventListener('click', (event) => {
    if (!(event.target as HTMLElement).closest('.quickfind')) close();
  });

  /* ── Your tools ────────────────────────────────────────────────────────
     Kept in this browser, like everything else here. Nobody is asked to make
     an account to remember which five of forty tools they actually use. */
  const FAVOURITES = 'projectpdf-favourites';
  const yours = document.querySelector<HTMLElement>('[data-yours]');
  const yoursRow = document.querySelector<HTMLElement>('[data-yours-row]');
  const stars = [...document.querySelectorAll<HTMLButtonElement>('[data-fav]')];

  const readFavourites = (): string[] => {
    try {
      const raw = JSON.parse(localStorage.getItem(FAVOURITES) ?? '[]');
      return Array.isArray(raw) ? raw.filter((item): item is string => typeof item === 'string') : [];
    } catch {
      // Private mode, or storage the browser refuses. Not worth an error.
      return [];
    }
  };

  function paintFavourites() {
    const saved = readFavourites();
    const set = new Set(saved);
    for (const star of stars) {
      star.setAttribute('aria-pressed', String(set.has(star.dataset.fav ?? '')));
    }

    if (!yours || !yoursRow) return;
    yoursRow.replaceChildren(
      ...saved
        .map((slug) => document.querySelector<HTMLElement>(`[data-tool-card][data-slug="${slug}"]`))
        .filter((card): card is HTMLElement => Boolean(card))
        .map((card) => {
          const link = document.createElement('a');
          link.className = 'shortcuts__item';
          link.href = card.querySelector<HTMLAnchorElement>('.card__link')?.href ?? '#';
          link.textContent = card.dataset.name ?? '';
          return link;
        })
    );
    yours.hidden = yoursRow.childElementCount === 0;
  }

  for (const star of stars) {
    star.addEventListener('click', () => {
      const slug = star.dataset.fav;
      if (!slug) return;
      const saved = readFavourites();
      const next = saved.includes(slug) ? saved.filter((item) => item !== slug) : [...saved, slug];
      try {
        localStorage.setItem(FAVOURITES, JSON.stringify(next));
      } catch {
        // Nothing to do but leave the star as it was.
      }
      paintFavourites();
    });
  }

  paintFavourites();

  /* Return visits show actual behavior rather than a generic popularity list. */
  const popular = document.querySelector<HTMLElement>('[data-popular-tools]');
  try {
    const visitKey = 'projectpdf-home-visits';
    const priorVisits = Number(localStorage.getItem(visitKey) ?? '0');
    localStorage.setItem(visitKey, String(priorVisits + 1));
    const raw: unknown = JSON.parse(localStorage.getItem('projectpdf-tool-usage') ?? '{}');
    const usage = raw && typeof raw === 'object' ? raw as Record<string, number> : {};
    const used = Object.entries(usage).filter(([, count]) => Number(count) > 0).sort((a, b) => b[1] - a[1]).slice(0, 8);
    if (priorVisits > 0 && popular && used.length > 0) {
      const allLink = popular.querySelector<HTMLAnchorElement>('.shortcuts__all');
      const defaults = [...popular.querySelectorAll<HTMLElement>('[data-shortcut-slug]')]
        .map((link) => link.dataset.shortcutSlug)
        .filter((slug): slug is string => Boolean(slug));
      const ranked = [...new Set([...used.map(([slug]) => slug), ...defaults])].slice(0, 8);
      const personal = ranked.flatMap((slug) => {
        const card = document.querySelector<HTMLElement>(`[data-tool-card][data-slug="${CSS.escape(slug)}"]`);
        if (!card) return [];
        const link = document.createElement('a');
        link.className = 'shortcuts__item';
        link.href = card.querySelector<HTMLAnchorElement>('.card__link')?.href ?? '#';
        link.textContent = card.dataset.name ?? slug;
        return [link];
      });
      popular.replaceChildren(...personal, ...(allLink ? [allLink] : []));
      popular.setAttribute('aria-label', 'Your most-used tools');
    }
  } catch {}
</script>

<style>
  /* Home-only brand field: this stops before a visitor opens a real tool.
     It sits above the page's broad surfaces but remains too faint to interfere
     with controls, text, or document previews. */
  .home-main {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }

  .page-watermarks {
    position: absolute;
    z-index: 3;
    inset: 0;
    pointer-events: none;
  }

  .page-watermark {
    position: absolute;
    display: block;
    width: 10rem;
    opacity: 0.038;
    filter: grayscale(0.25) drop-shadow(0 10px 12px rgb(15 23 42 / 0.14));
  }

  .page-watermark::before {
    content: '';
    position: absolute;
    bottom: 100%;
    left: 50%;
    width: 1px;
    height: 3.5rem;
    background: linear-gradient(transparent, color-mix(in srgb, var(--accent) 36%, var(--line)));
  }

  .page-watermark img { display: block; width: 100%; height: auto; }
  .page-watermark--a { top: 3%; left: -3%; width: 12rem; transform: rotate(-18deg); }
  .page-watermark--b { top: 18%; right: 4%; width: 8.5rem; transform: rotate(12deg); }
  .page-watermark--c { top: 34%; left: 6%; width: 10rem; transform: rotate(9deg); }
  .page-watermark--d { top: 51%; right: -2%; width: 13rem; transform: rotate(-14deg); }
  .page-watermark--e { top: 69%; left: 13%; width: 8rem; transform: rotate(-10deg); }
  .page-watermark--f { top: 84%; right: 10%; width: 11rem; transform: rotate(15deg); }

  :global(:root[data-theme='dark']) .page-watermark {
    opacity: 0.075;
    filter: grayscale(0.2) brightness(2.4) contrast(0.65) drop-shadow(0 10px 16px rgb(0 0 0 / 0.46));
    mix-blend-mode: screen;
  }

  /* ── Hero ─────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: clamp(3rem, 2rem + 5vw, 5rem);
    padding-block: clamp(4.5rem, 3rem + 6vw, 7.75rem) clamp(4rem, 3rem + 5vw, 7rem);
  }

  .hero::before {
    content: '';
    position: absolute;
    z-index: -2;
    width: min(43vw, 39rem);
    aspect-ratio: 1;
    right: -16rem;
    top: 6%;
    border-radius: 50%;
    background: radial-gradient(circle at 32% 36%, rgb(251 113 133 / 0.45), transparent 25%),
      radial-gradient(circle at 65% 57%, rgb(125 211 252 / 0.38), transparent 36%),
      radial-gradient(circle at 48% 47%, rgb(196 181 253 / 0.34), transparent 67%);
    filter: blur(6px);
  }

  .hero::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: auto 0 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--line), transparent);
  }

  /* The brand appears as a physical impression on the workspace, never as a
     competing hero illustration. The primary mark is exactly 3× the header
     mark (5.25rem vs. 1.75rem); the two small marks make the motif memorable. */
  .brand-cascade {
    position: absolute;
    z-index: -1;
    inset: -5rem 0 auto;
    height: 23rem;
    overflow: hidden;
    pointer-events: none;
  }

  .brand-watermark {
    position: absolute;
    display: block;
    padding-top: 1.6rem;
    opacity: 0.11;
    filter: drop-shadow(0 9px 9px rgb(15 23 42 / 0.18));
  }

  .brand-watermark::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 1px;
    height: 1.6rem;
    background: linear-gradient(transparent, color-mix(in srgb, var(--accent) 45%, var(--line)));
  }

  .brand-watermark img { display: block; width: 100%; height: auto; }

  .brand-watermark--one {
    top: 0.75rem;
    left: 7%;
    width: 15.75rem;
    transform: rotate(-7deg);
  }

  .brand-watermark--two {
    top: 6rem;
    left: 56%;
    width: 4.5rem;
    opacity: 0.07;
    transform: rotate(11deg);
  }

  .brand-watermark--three {
    top: 1.5rem;
    right: 5%;
    width: 5.25rem;
    opacity: 0.08;
    transform: rotate(-14deg);
  }

  :global(:root[data-theme='dark']) .brand-watermark {
    opacity: 0.23;
    filter: grayscale(0.2) brightness(2.8) contrast(0.65) drop-shadow(0 10px 16px rgb(0 0 0 / 0.55));
    mix-blend-mode: screen;
  }

  :global(:root[data-theme='dark']) .brand-watermark--one { opacity: 0.3; }
  :global(:root[data-theme='dark']) .brand-watermark--two { opacity: 0.16; }
  :global(:root[data-theme='dark']) .brand-watermark--three { opacity: 0.18; }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--ok);
  }

  h1 {
    font-size: var(--step-5);
    margin-block: 1.25rem 1.5rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero__meta {
    margin-top: 1.25rem;
    font-size: var(--step--2);
    color: var(--muted);
  }

  /* the desk: a sheet with a lens lying across its lower edge */
  .hero__desk {
    position: relative;
    isolation: isolate;
    margin: 0;
    padding: 1.5rem 1.5rem 4.5rem;
    border: 1px solid color-mix(in srgb, var(--line) 88%, transparent);
    border-radius: 28px;
    background: linear-gradient(145deg, color-mix(in srgb, var(--paper-raised) 88%, transparent), color-mix(in srgb, var(--paper-sunk) 76%, transparent));
    box-shadow: 0 32px 60px -46px rgb(15 23 42 / 0.5);
  }

  /* Light falling across the desk. Without something varied behind it, the
     lens has nothing to refract and reads as a flat card. */
  .hero__desk::before {
    content: '';
    position: absolute;
    inset: -14% -10% -8%;
    z-index: -1;
    background:
      radial-gradient(58% 52% at 74% 14%, var(--desk-warm), transparent 68%),
      radial-gradient(52% 48% at 16% 84%, var(--desk-cool), transparent 70%),
      radial-gradient(44% 40% at 92% 76%, var(--desk-blush), transparent 72%);
    filter: blur(10px);
    pointer-events: none;
  }

  .hero__proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.1rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--ink-2);
    font-size: var(--step--2);
    font-weight: 600;
  }

  .hero__proof li { display: inline-flex; align-items: center; gap: 0.4rem; }
  .hero__proof span {
    display: grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    font-family: var(--font-mono);
    font-size: 0.56rem;
  }

  .hero__desk::after {
    content: '';
    position: absolute;
    width: 11rem;
    height: 4.5rem;
    right: 18%;
    top: -1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--accent) 45%, var(--line));
    border-radius: 50%;
    transform: rotate(-18deg);
    opacity: 0.55;
    pointer-events: none;
  }

  .page {
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    display: grid;
    gap: 0.75rem;
    transform: rotate(-1.1deg) translateX(-0.35rem);
    box-shadow: 0 20px 45px -32px rgb(15 23 42 / 0.45);
  }

  .page__topline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.12em;
  }

  .page__topline i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .page__rule {
    height: 0.5rem;
    border-radius: 2px;
    background: var(--line);
    width: 100%;
  }

  .page__rule--title {
    height: 0.875rem;
    width: 54%;
    background: var(--line-strong);
    margin-bottom: 0.5rem;
  }

  .page__gap {
    height: 0.75rem;
  }

  .page__footer {
    display: flex;
    gap: 0.3rem;
    margin-top: 0.55rem;
  }

  .page__footer span {
    display: block;
    width: 1.25rem;
    height: 0.25rem;
    border-radius: 99px;
    background: var(--line);
  }

  .page__footer span:first-child { background: var(--accent); width: 2.1rem; }

  /* Rendered by <Lens>, so it needs :global() constrained to this section. */
  .hero__desk :global(.loupe) {
    position: absolute;
    right: clamp(-1.75rem, -3vw, 0.75rem);
    bottom: -0.35rem;
    width: min(16rem, 70%);
    padding: 1.125rem 1.25rem;
  }

  .loupe__label {
    font-size: var(--step--2);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .loupe__figure {
    font-family: var(--font-mono);
    font-size: var(--step-3);
    font-weight: 500;
    color: var(--ink);
    letter-spacing: -0.03em;
    margin-block: 0.25rem;
  }

  .loupe__figure span {
    font-size: var(--step-1);
    color: var(--muted);
  }

  .loupe__status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-2);
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
  }

  .led {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 8px color-mix(in oklab, var(--ok) 60%, transparent);
  }

  .hero__tool-orbit {
    position: absolute;
    left: -1rem;
    bottom: 1.1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .orbit-card {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.65rem;
    border: 1px solid color-mix(in srgb, var(--line-strong) 78%, transparent);
    border-radius: 10px;
    color: var(--ink);
    background: color-mix(in srgb, var(--paper-raised) 92%, transparent);
    box-shadow: 0 9px 20px -16px rgb(15 23 42 / 0.48);
    font-size: var(--step--2);
    font-weight: 600;
  }

  .orbit-card b {
    display: grid;
    place-items: center;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 5px;
    color: white;
    background: var(--accent);
    font-size: 0.7rem;
  }

  .orbit-card--split b { background: #7c3aed; }
  .orbit-card--secure b { background: #0f766e; }

  @media (min-width: 62em) {
    .hero {
      grid-template-columns: 1.05fr 0.95fr;
      align-items: center;
      padding-block: clamp(3rem, 2rem + 2vw, 4.5rem) clamp(3rem, 2rem + 2vw, 4.5rem);
    }
  }

  /* ── Receipt ──────────────────────────────────────────────────────── */
  .receipt {
    background: var(--paper-sunk);
    border-block: 1px solid var(--line);
    padding-block: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .receipt__row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .receipt__row li {
    background: var(--paper-sunk);
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .receipt__figure {
    font-family: var(--font-mono);
    font-size: var(--step-3);
    color: var(--ok);
    line-height: 1;
  }

  .receipt__label {
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  /* The conclusion the three zeros add up to, so it reads as the end of the
     row rather than a fourth measurement. */
  .receipt__verdict {
    background: color-mix(in oklab, var(--ok) 9%, var(--paper-sunk));
    box-shadow: inset 3px 0 0 var(--ok);
  }

  .receipt__verdict-line {
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.15;
    color: var(--ink);
    text-wrap: balance;
  }

  .receipt__note {
    margin-top: 1.5rem;
    max-width: var(--measure);
    color: var(--ink-2);
  }

  /* A drawn line, so "crosses the boundary" is a place and not a phrase. */
  .boundary {
    position: relative;
    margin: 2.75rem 0 1.25rem;
    border-top: 1px solid var(--ok);
  }

  .boundary span {
    position: absolute;
    top: -0.62rem;
    left: 0;
    padding-right: 0.75rem;
    background: var(--paper-sunk);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ok);
  }

  .telemetry {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .telemetry li {
    display: flex;
    gap: 0.5rem;
  }

  .telemetry span {
    color: var(--muted);
  }

  .telemetry b {
    font-weight: 500;
    color: var(--ink);
  }

  .telemetry__note {
    margin-top: 1rem;
    max-width: var(--measure);
    font-size: var(--step--1);
    color: var(--muted);
  }

  @media (min-width: 48em) {
    .receipt__row {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* ── Sections ─────────────────────────────────────────────────────── */
  .section-head {
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .section-head h2 {
    font-size: var(--step-3);
  }

  .section-head__deck {
    margin-top: 0.875rem;
    max-width: var(--measure);
    color: var(--ink-2);
  }

  .section-head__deck em {
    font-style: normal;
    color: var(--ok);
  }

  @media (max-width: 48em) {
    .hero__desk { display: none; }
  }

  @media (max-width: 30em) {
    .hero__desk { padding: 1rem 1rem 4rem; }
    .hero__tool-orbit { left: 0.25rem; bottom: 0.65rem; }
    .orbit-card { padding: 0.35rem 0.45rem; }
    .orbit-card span { display: none; }
  }

  /* ── Quickfind ──────────────────────────────────────────────────────
     One search box, at the top, that answers in place. */
  .quickfind {
    position: relative;
    max-width: 32rem;
    margin-top: 1.75rem;
  }

  .quickfind__field {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-left: 0.9rem;
    background: var(--paper-raised);
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.03);
  }

  .quickfind__field:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent) 16%, transparent);
  }

  .quickfind__icon { width: 1.05rem; height: 1.05rem; color: var(--muted); flex: none; }

  .quickfind__field input {
    flex: 1;
    min-width: 0;
    min-height: 3rem;
    padding: 0.75rem 1rem 0.75rem 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
  }

  .quickfind__field input:focus { outline: none; }
  .quickfind__field input::placeholder { color: var(--muted); }
  .quickfind__field input::-webkit-search-cancel-button { cursor: pointer; }

  .quickfind__results {
    position: absolute;
    z-index: 12;
    inset-inline: 0;
    top: calc(100% + 0.4rem);
    margin: 0;
    padding: 0.3rem;
    list-style: none;
    background: var(--paper-raised);
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    box-shadow: 0 24px 48px -28px rgb(15 23 42 / 0.45);
  }

  .quickfind__results a {
    display: grid;
    gap: 0.1rem;
    padding: 0.55rem 0.7rem;
    border-radius: 8px;
    color: var(--ink);
    text-decoration: none;
  }

  .quickfind__results a:hover,
  .quickfind__results a:focus-visible {
    background: color-mix(in oklab, var(--accent) 8%, transparent);
    outline: none;
  }

  .quickfind__results strong { font-size: var(--step--1); font-weight: 600; }
  .quickfind__results span {
    font-size: var(--step--2);
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .quickfind__empty {
    padding: 0.6rem 0.7rem;
    color: var(--muted);
    font-size: var(--step--1);
  }

  .cluster--yours .shortcuts { margin-top: 0; }

  .card__star {
    position: absolute;
    z-index: 2;
    top: 0.6rem;
    right: 0.6rem;
    width: 1.9rem;
    height: 1.9rem;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--line-strong);
    cursor: pointer;
    transition: color 140ms ease-out;
  }

  .card__star svg { width: 1.05rem; height: 1.05rem; fill: currentColor; }
  .card__star:hover { color: var(--accent); }
  .card__star[aria-pressed='true'] { color: var(--accent); }

  /* ── Shortcuts ──────────────────────────────────────────────────────
     Named destinations, not a generic "explore". Above the fold on a phone. */
  .shortcuts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .shortcuts__item,
  .shortcuts__all {
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--paper-raised);
    color: var(--ink);
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .shortcuts__item:hover,
  .shortcuts__all:hover { border-color: var(--accent); color: var(--accent); }

  .shortcuts__all {
    border-style: dashed;
    background: none;
    color: var(--muted);
    font-weight: 400;
  }

  @media (max-width: 48em) {
    .shortcuts {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-right: calc(var(--gutter) * -1);
      padding-right: var(--gutter);
      padding-bottom: 0.35rem;
      scrollbar-width: none;
    }
    .shortcuts::-webkit-scrollbar { display: none; }
  }

  .hero__meta a { color: var(--ink-2); }

  .tools,
  .limits {
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem);
  }

  .how,
  .close {
    background: var(--paper-sunk);
    border-block: 1px solid var(--line);
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem);
  }

  /* ── Tool grid ────────────────────────────────────────────────────── */
  .cluster {
    margin-bottom: 2.5rem;
    scroll-margin-top: 6rem;
  }

  .cluster__name {
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 1.25rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    position: relative;
    padding: 1.125rem 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    overflow: hidden;
    transition:
      border-color 180ms ease-out,
      box-shadow 180ms ease-out,
      transform 180ms ease-out;
  }

  .card::after {
    content: '';
    position: absolute;
    width: 4.75rem;
    height: 4.75rem;
    right: -2.25rem;
    bottom: -2.5rem;
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
    border-radius: 50%;
    pointer-events: none;
  }

  .card__link { position: absolute; inset: 0; border-radius: inherit; }

  .card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 48%, var(--line));
    box-shadow:
      0 1px 3px rgb(15 23 42 / 0.05),
      0 20px 40px -28px color-mix(in srgb, var(--accent) 45%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover {
      transform: none;
    }
  }

  .card__name {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .card__category {
    margin: 0 0 0.35rem;
    color: var(--accent);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .card__blurb {
    font-size: var(--step--1);
    color: var(--ink-2);
    flex: 1;
  }

  .card__where {
    font-size: var(--step--2);
    color: var(--ok);
    letter-spacing: 0.04em;
    margin-top: 0.375rem;
  }

  .card__where.is-server {
    color: var(--disclose);
  }

  .card__soon {
    color: var(--muted);
  }

  /* ── Steps ────────────────────────────────────────────────────────── */
  .steps {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }

  .step {
    padding: 1.5rem;
  }

  .step__n {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent);
  }

  .step__title {
    font-size: var(--step-1);
    margin-block: 0.5rem 0.5rem;
  }

  .step__body {
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  /* No paper, no shadow — a dotted outline where a step would have been. */
  .step--absent {
    padding: 1.5rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    background: none;
    box-shadow: none;
    opacity: 0.62;
  }

  .step--absent .step__n {
    color: var(--muted);
    text-decoration: line-through;
    text-decoration-color: var(--seal);
  }

  .step--absent .step__title {
    color: var(--muted);
  }

  .how__never {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    font-size: var(--step--1);
  }

  .how__strike {
    color: var(--muted);
    text-decoration: line-through;
    text-decoration-color: var(--seal);
    text-decoration-thickness: 1.5px;
    font-family: var(--font-mono);
  }

  .how__seal {
    color: var(--seal);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: var(--step--2);
    font-weight: 600;
  }

  /* ── Limits ───────────────────────────────────────────────────────── */
  .limits {
    display: grid;
    gap: clamp(2rem, 1.5rem + 3vw, 4rem);
  }

  .limits__intro h2 {
    font-size: var(--step-3);
    margin-bottom: 0.875rem;
  }

  .limits__closing {
    margin-top: 1.25rem;
    font-size: var(--step--1);
    color: var(--muted);
    max-width: 46ch;
  }

  .limits__list {
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .limits__item {
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .limits__item dt {
    font-weight: 600;
    font-size: var(--step-0);
  }

  .limits__item dd {
    margin: 0.25rem 0 0;
    font-size: var(--step--1);
    color: var(--ink-2);
    max-width: 54ch;
  }

  @media (min-width: 62em) {
    .limits {
      grid-template-columns: 0.85fr 1.15fr;
    }
  }

  /* ── Close ────────────────────────────────────────────────────────── */
  .close__line {
    font-size: var(--step-4);
  }

  .close__note {
    margin-top: 1.25rem;
    color: var(--ink-2);
    max-width: var(--measure);
  }

  /* ── Footer ───────────────────────────────────────────────────────── */
  .footer {
