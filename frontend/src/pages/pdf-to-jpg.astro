---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import PdfTool from '../components/PdfTool.astro';
---

<BaseLayout title="PDF to image — HatePDF" description="Export every page as a PNG or JPG at 72, 150 or 300 DPI. Rendered in this tab, not on a server.">
  <Masthead />
  <main id="main">
    <PdfTool mode="pdf-to-images" title="PDF to image" description="Export every page as a PNG or JPG at the resolution you pick. Rendered in this tab." />
  </main>
</BaseLayout>
