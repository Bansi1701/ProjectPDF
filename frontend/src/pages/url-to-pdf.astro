---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import PdfTool from '../components/PdfTool.astro';
---

<BaseLayout
  title="Web page to PDF — ProjectPDF"
  description="Save a public web page as a PDF. No document of yours is involved."
>
  <Masthead />
  <main id="main">
    <PdfTool
      mode="url-to-pdf"
      eyebrow="The one tool that uses our server"
      title="Web page to PDF"
      description="Give us a public address and we render it. This is the only tool here that runs remotely, because a browser is not allowed to fetch another site — and it is also the only one where you are not handing over a document."
    />
  </main>
</BaseLayout>
