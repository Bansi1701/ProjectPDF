---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import PdfTool from '../components/PdfTool.astro';

const description =
  'See what your file is quietly carrying — author, dates, the software that made it — then change or remove it.';
---

<BaseLayout title="PDF metadata — ProjectPDF" description={description}>
  <Masthead />
  <main id="main">
    <PdfTool
      mode="metadata"
      eyebrow="Runs entirely in your browser"
      title="PDF metadata"
      description={description}
    />
  </main>
</BaseLayout>
