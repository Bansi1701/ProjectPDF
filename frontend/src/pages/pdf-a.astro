---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import PdfTool from '../components/PdfTool.astro';
---

<BaseLayout title="Convert to PDF/A — ProjectPDF" description="Archival format, converted in your browser — and refused when the document cannot honestly claim it.">
  <Masthead />
  <main id="main">
    <PdfTool mode="pdf-a" title="Convert to PDF/A" description="Archival format, converted in your browser — and refused when the document cannot honestly claim it." />
  </main>
</BaseLayout>
