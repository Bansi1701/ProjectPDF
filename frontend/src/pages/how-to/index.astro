---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Masthead from '../../components/Masthead.astro';
import { RECIPES } from '../../config/recipes';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Private PDF workflow recipes | ProjectPDF" description="Complete multi-step PDF jobs without uploading or choosing the same file at every step.">
  <Masthead />
  <main id="main" class="recipes">
    <header><p>Connected workflows</p><h1>Finish the job, not just one PDF step.</h1><span>Choose a file once. ProjectPDF carries it between tools in your browser, then deletes each handoff as soon as it is used.</span></header>
    <div class="recipes__grid">
      {RECIPES.map((recipe) => <a href={`${base}/how-to/${recipe.slug}/`}><small>{recipe.steps.length} steps</small><h2>{recipe.title}</h2><p>{recipe.outcome}</p><strong>Open recipe →</strong></a>)}
    </div>
  </main>
</BaseLayout>

<style>
  .recipes { width: min(70rem, calc(100% - 2rem)); margin: 0 auto; padding: clamp(4rem, 10vw, 8rem) 0; }
  header { max-width: 50rem; margin-bottom: 3rem; }
  header > p { color: var(--accent); font-size: var(--step--2); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  h1 { margin: 0; font-family: var(--font-display); font-size: var(--step-5); line-height: 1; letter-spacing: -0.05em; }
  header span { display: block; margin-top: 1.2rem; color: var(--ink-2); font-size: var(--step-1); line-height: 1.6; }
  .recipes__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .recipes__grid a { min-height: 16rem; padding: 1.5rem; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--paper-raised); color: inherit; text-decoration: none; transition: 160ms ease; }
  .recipes__grid a:hover { transform: translateY(-3px); border-color: var(--accent); }
  small { color: var(--accent); font-weight: 700; text-transform: uppercase; }
  h2 { font-family: var(--font-display); }
  .recipes__grid p { color: var(--ink-2); line-height: 1.6; }
  .recipes__grid strong { color: var(--accent); }
  @media (max-width: 42rem) { h1 { font-size: var(--step-4); } .recipes__grid { grid-template-columns: 1fr; } }
</style>
