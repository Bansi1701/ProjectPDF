---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import PdfTool from '../components/PdfTool.astro';
---

<BaseLayout title="Images to PDF — ProjectPDF" description="JPG, PNG and WebP into one document, one image per page. JPG and PNG go in without being re-encoded.">
  <Masthead />
  <main id="main">
    <PdfTool mode="images-to-pdf" title="Images to PDF" description="JPG, PNG and WebP into one document, one image per page, in the order you choose them." multiple />
  </main>
</BaseLayout>
