---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import PdfTool from '../components/PdfTool.astro';
---

<BaseLayout title="Excel to PDF — ProjectPDF" description="Lays each sheet out as a table — cells, dates and the values Excel already calculated. Converted in this tab.">
  <Masthead />
  <main id="main">
    <PdfTool mode="excel-to-pdf" eyebrow="Converted here, not on a server" title="Excel to PDF" description="Lays each sheet out as a table — cells, dates and the values Excel already calculated. Converted in this tab." />
  </main>
</BaseLayout>
