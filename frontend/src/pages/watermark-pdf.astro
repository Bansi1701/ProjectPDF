---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import PdfTool from '../components/PdfTool.astro';
import ToolGuide from '../components/ToolGuide.astro';
---

<BaseLayout title="Watermark a PDF — HatePDF" description="Stamp text diagonally across every page.">
  <Masthead />
  <main id="main">
    <PdfTool mode="watermark" title="Watermark a PDF" description="Stamp text diagonally across every page." />
    <ToolGuide slug="watermark-pdf" />
  </main>
</BaseLayout>
