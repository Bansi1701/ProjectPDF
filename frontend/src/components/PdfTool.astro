  }
  .preview__pages[data-size='sm'] { grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr)); }
  .preview__pages[data-size='lg'] { grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); }

  /*
   * Everything below targets elements the client script builds with
   * document.createElement — thumbnails, frames, overlays. Astro's scoped
   * styles rewrite every compound in a selector to require this component's
   * data-astro-cid attribute, which an element assembled at runtime never
   * carries, so an unqualified rule here silently matches nothing. :global()
   * is Astro's documented escape for exactly this case.
   */
  :global(.preview__pages figure) {
    margin: 0; padding: 0.5rem; border: 1px solid var(--line);
    border-radius: calc(var(--radius) - 4px); background: var(--paper-raised);
  }

  :global(.preview__frame) { position: relative; overflow: hidden; border-radius: 4px; }
  :global(.preview__pages img) {
    display: block; width: 100%; height: auto; border: 1px solid var(--line);
  }
  :global(.preview__pages figcaption) {
    margin-top: 0.35rem; color: var(--muted); font-family: var(--font-mono); font-size: var(--step--2);
  }

