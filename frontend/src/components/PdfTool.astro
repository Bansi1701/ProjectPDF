---
import PageGrid from './PageGrid.astro';
import SaveDialog from './SaveDialog.astro';
import Lens from './Lens.astro';
import LivePdfEditor from './LivePdfEditor.astro';
import type { Operation } from '../lib/pdf/types';

interface Props {
  mode: Operation;
  title: string;
  description: string;
  multiple?: boolean;
  /** Shown above the dropzone. */
  eyebrow?: string;
}

const {
  mode,
  title,
  description,
  multiple = false,
  eyebrow = 'Runs entirely in your browser',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const ACTIONS: Record<Operation, string> = {
  compress: 'Compress',
  merge: 'Merge PDFs',
  split: 'Split PDF',
  rotate: 'Rotate',
  'images-to-pdf': 'Build the PDF',
  'pdf-to-images': 'Export images',
  reorder: 'Reorder pages',
  extract: 'Extract pages',
  delete: 'Delete pages',
  edit: 'Save edited PDF',
  watermark: 'Add watermark',
  'page-numbers': 'Add numbers',
  compare: 'Compare',
  protect: 'Protect',
  unlock: 'Unlock',
  'pdf-to-markdown': 'Convert to Markdown',
  forms: 'Fill the form',
  sign: 'Place the signature',
  'pdf-a': 'Convert to PDF/A',
  repair: 'Repair',
  ocr: 'Read the text',
  'word-to-pdf': 'Convert to PDF',
  'url-to-pdf': 'Render the page',
  'excel-to-pdf': 'Convert to PDF',
  'powerpoint-to-pdf': 'Convert to PDF',
  'pdf-to-word': 'Convert to Word',
  'pdf-to-excel': 'Extract the tables',
  crop: 'Crop the pages',
  grayscale: 'Convert to greyscale',
  'auto-crop': 'Trim the margins',
  scan: 'Build the PDF',
  compose: 'Save the changes',
};

/** Modes whose ranges field means "pages to act on", not "groups". */
const RANGE_MODES = new Set<Operation>(['extract', 'delete']);

/**
 * Tools whose whole job is choosing pages. Each gets the visual grid, because
 * "1-3, 7, 10-12" asks you to know what is on page 7 before you can say
 * anything about it. The typed box stays alongside it, and they stay in sync.
 */
const GRID_MODES: Partial<Record<Operation, import('../lib/pdf/types').GridMode>> = {
  reorder: 'organise',
  rotate: 'rotate',
  delete: 'delete',
  extract: 'extract',
  split: 'split',
  merge: 'merge',
};
const gridMode = GRID_MODES[mode];

const action = ACTIONS[mode];

/** The only tool whose input is not a PDF. */
const takesImages = mode === 'images-to-pdf';
const takesWord = mode === 'word-to-pdf';
const takesExcel = mode === 'excel-to-pdf';
const takesSlides = mode === 'powerpoint-to-pdf';
const takesText = mode === 'text-to-pdf';

/**
 * The page workspace needs one readable PDF. Organise tools already have the
 * specialised all-page grid; conversion inputs such as DOCX and XLSX do not
 * have a PDF page to preview until after their conversion.
 */
const supportsLiveEditor =
  !gridMode &&
  !takesImages &&
  !takesWord &&
  !takesExcel &&
  !takesSlides &&
  !takesText &&
  !['url-to-pdf', 'compare', 'overlay', 'unlock', 'repair'].includes(mode);

const accept = takesImages
  ? 'image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp'
  : takesWord
    ? 'application/vnd.openxmlformats-officedocument.wordprocessingml.document,.docx'
    : takesExcel
      ? 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,.xlsx'
      : takesSlides
        ? 'application/vnd.openxmlformats-officedocument.presentationml.presentation,.pptx'
        : takesText
          ? 'text/plain,text/csv,text/markdown,.txt,.csv,.md,.markdown,.tsv,.log'
          : 'application/pdf,.pdf';

const dropTitle = takesExcel
  ? 'Choose a spreadsheet, or drop one here'
  : takesSlides
  ? 'Choose a presentation, or drop one here'
  : takesWord
  ? 'Choose a Word document, or drop one here'
  : takesImages
  ? 'Choose images, or drop them here'
  : multiple
    ? 'Choose PDFs, or drop them here'
    : 'Choose a PDF, or drop one here';
---

<section class="tool wrap" data-pdf-tool data-mode={mode} data-live-workspace={supportsLiveEditor || undefined}>
  <a class="back" href={`${base}/#tools`}>← All tools</a>

  <header class="tool__head">
    <p class="eyebrow"><span class="dot"></span>{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lede">{description}</p>
  </header>

  {
    mode === 'url-to-pdf' && (
      <Fragment>
        <label class="field field--url">
          <span>Address</span>
          <input data-url type="url" placeholder="https://example.com/article" />
          <small>
            Must be a page anyone can reach. Addresses inside a private network are refused.
          </small>
        </label>

        <aside class="server-note">
          <strong>This one runs on our server.</strong>
          <span>
            A browser cannot fetch someone else's page — the security rules that protect you
            from other sites also stop us reading them. So we fetch it. No document of yours
            is involved: you give us a public address, and we render what anyone could see.
            Nothing is stored.
          </span>
        </aside>

        <div class="workspace__actions">
          <button class="btn btn--primary" data-run type="button">{action}</button>
        </div>
        <p class="status" data-status role="status" aria-live="polite"></p>
      </Fragment>
    )
  }

  <Lens variant="loupe" class="drop">
    <label class="drop__zone" data-drop>
      <input class="sr-only" data-input type="file" accept={accept} multiple={multiple} />
      <span class="drop__icon" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M8 3h11l6 6v20a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z" stroke-linejoin="round"></path>
          <path d="M19 3v6h6" stroke-linejoin="round"></path>
          <path d="M16 22v-8m0 0-3.2 3.2M16 14l3.2 3.2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
      <span class="drop__title">{dropTitle}</span>
      <span class="drop__meta">Stays on this device · no account</span>
    </label>
  </Lens>

  <div class="file-bar" data-file-bar hidden>
    <span class="file-bar__label" data-file-bar-label></span>
    <button class="btn btn--quiet" type="button" data-change-file>Change file</button>
  </div>

  <div class="workspace" data-workspace hidden>
    <ol class="files" data-files></ol>

    {gridMode && <PageGrid mode={gridMode} />}

    {supportsLiveEditor && <LivePdfEditor />}

    <section class="preview" data-preview hidden>
      <div class="preview__head">
        <p class="preview__note" data-preview-note hidden></p>
        <div class="preview__sizes" data-preview-sizes role="group" aria-label="Preview size">
          <button type="button" data-size="sm">S</button>
          <button type="button" data-size="md">M</button>
          <button type="button" data-size="lg">L</button>
        </div>
      </div>
      <div class="preview__pages" data-preview-pages data-size="md"></div>
    </section>

    {
      mode === 'split' && (
        <label class="field">
          <span>Page groups</span>
          <input data-ranges value="1" placeholder="1-3, 4-6, 9" />
          <small>Each comma-separated group becomes its own PDF.</small>
        </label>
      )
    }

    {
      mode === 'rotate' && (
        <fieldset class="field field--turns">
          <legend>Turn</legend>
          <label><input type="radio" name="turn" value="90" checked /> 90° right</label>
          <label><input type="radio" name="turn" value="180" /> 180°</label>
          <label><input type="radio" name="turn" value="270" /> 90° left</label>
        </fieldset>
      )
    }

    {
      RANGE_MODES.has(mode) && (
        <label class="field">
          <span>Pages</span>
          <input data-ranges value="1" placeholder="1-3, 7, 10-12" />
          <small>
            {mode === 'extract'
              ? 'These pages are pulled into a new document. The original is untouched.'
              : 'These pages are removed. Everything else is kept, in order.'}
          </small>
        </label>
      )
    }

    {
      mode === 'reorder' && (
        <label class="field">
          <span>New page order</span>
          <input data-order placeholder="3, 1, 2" />
          <small>
            Every page number, once each, in the order you want them. Leave empty to keep the
            current order.
          </small>
        </label>
      )
    }

    {
      mode === 'edit' && !supportsLiveEditor && (
        <Fragment>
          <label class="field">
            <span>Text to add</span>
            <input data-text placeholder="Approved — 12 March" />
          </label>
          <label class="field">
            <span>Page</span>
            <input data-target-page type="number" min="1" value="1" />
            <small>The text is placed near the bottom-left corner of that page.</small>
          </label>
        </Fragment>
      )
    }

    {
      mode === 'watermark' && (
        <label class="field">
          <span>Watermark text</span>
          <input data-text placeholder="DRAFT" />
          <small>Drawn diagonally across every page at low opacity.</small>
        </label>
      )
    }

    {
      mode === 'page-numbers' && (
        <Fragment>
          <label class="field">
            <span>Start at</span>
            <input data-start-number type="number" min="1" value="1" />
          </label>
          <label class="field">
            <span>Prefix</span>
            <input data-prefix placeholder="Page " />
            <small>Optional. Numbers are drawn in the bottom-right corner.</small>
          </label>
        </Fragment>
      )
    }

    {
      mode === 'ocr' && (
        <label class="check">
          <input type="checkbox" data-searchable checked />
          <span>
            Also make a searchable PDF
            <small>
              Keeps your scan exactly as it is and puts the recognised words behind it,
              invisibly. Roughly 5 MB of recognition engine downloads the first time you run
              this — from this site, not a CDN.
            </small>
          </span>
        </label>
      )
    }

    {
      mode === 'sign' && (
        <Fragment>
          <div class="sign">
            <div class="sign__tabs" role="group" aria-label="Signature style">
              <button type="button" data-sign-tab="draw" class="is-on">Draw</button>
              <button type="button" data-sign-tab="type">Type</button>
            </div>

            <div data-sign-panel="draw">
              <canvas data-signature-canvas width="720" height="240"></canvas>
              <div class="sign__row">
                <button class="btn btn--quiet" type="button" data-sign-clear>Clear</button>
                <span class="sign__hint">Draw with a mouse, trackpad or finger.</span>
              </div>
            </div>

            <div data-sign-panel="type" hidden>
              <input data-sign-text placeholder="Your name" />
              <span class="sign__hint">Rendered in a handwriting-like italic.</span>
            </div>
          </div>

          <label class="field">
            <span>Page</span>
            <input data-target-page type="number" min="1" placeholder="last page" />
            <small>Leave empty to sign the last page.</small>
          </label>

          <label class="field">
            <span>Position</span>
            <select data-corner>
              <option value="bottom-right">Bottom right</option>
              <option value="bottom-left">Bottom left</option>
              <option value="top-right">Top right</option>
              <option value="top-left">Top left</option>
            </select>
          </label>
        </Fragment>
      )
    }

    {
      mode === 'forms' && (
        <Fragment>
          <div class="fields" data-fields>
            <p class="fields__empty">Reading the form…</p>
          </div>
          <label class="check">
            <input type="checkbox" data-flatten />
            <span>
              Flatten when saving
              <small>
                Bakes the answers into the page. Nobody can change them afterwards — including
                you, so keep the original.
              </small>
            </span>
          </label>
        </Fragment>
      )
    }

    {
      mode === 'protect' && (
        <Fragment>
          <label class="field">
            <span>Password to open the document</span>
            <input data-user-password type="password" autocomplete="new-password" />
            <small data-strength>
              This is the one that encrypts. Leave it empty to set permissions only.
            </small>
          </label>

          <fieldset class="field field--turns">
            <legend>Allow</legend>
            <label><input type="checkbox" data-perm="printing" checked /> Printing</label>
            <label><input type="checkbox" data-perm="copying" /> Copying text</label>
            <label><input type="checkbox" data-perm="modifying" /> Editing</label>
            <label><input type="checkbox" data-perm="annotating" /> Commenting</label>
            <small>
              These are flags a reader is asked to honour, not enforced limits. Anything that
              can open the file can ignore them. Only the password above actually protects
              the contents.
            </small>
          </fieldset>
        </Fragment>
      )
    }

    {
      mode === 'unlock' && (
        <label class="field">
          <span>Password</span>
          <input data-user-password type="password" autocomplete="current-password" />
          <small>
            Only removes protection from a document you can already open. Leave empty if the
            file opens without a password but restricts printing or copying.
          </small>
        </label>
      )
    }

    {
      mode === 'images-to-pdf' && (
        <label class="field">
          <span>Page size</span>
          <select data-page-size>
            <option value="fit">Fit each page to its image</option>
            <option value="a4">A4</option>
            <option value="letter">Letter</option>
          </select>
          <small>
            JPG and PNG are embedded byte-for-byte — not decoded, not re-encoded, nothing lost.
            WebP has no PDF equivalent, so those images alone are converted to JPEG at quality
            0.92. On A4 or Letter the image is centred and scaled to fit.
          </small>
        </label>
      )
    }

    {
      mode === 'pdf-to-images' && (
        <Fragment>
          <fieldset class="field field--turns">
            <legend>Format</legend>
            <label>
              <input type="radio" name="format" value="png" checked /> PNG · lossless
            </label>
            <label>
              <input type="radio" name="format" value="jpeg" /> JPG · smaller
            </label>
          </fieldset>

          <fieldset class="field field--turns">
            <legend>Resolution</legend>
            <label>
              <input type="radio" name="dpi" value="72" /> 72 DPI
            </label>
            <label>
              <input type="radio" name="dpi" value="150" checked /> 150 DPI
            </label>
            <label>
              <input type="radio" name="dpi" value="300" /> 300 DPI
            </label>
            <small data-dpi-note hidden />
            <small>
              Capped at 12 million pixels a page. Above roughly 16.7 million, Safari on iOS
              stops allocating the canvas and hands back a blank image instead of an error.
            </small>
          </fieldset>
        </Fragment>
      )
    }

    {
      mode === 'auto-crop' && (
        <Fragment>
          <label class="field">
            <span>Crop</span>
            <select data-ac-mode>
              <option value="uniform" selected>Every page to the same box</option>
              <option value="per-page">Each page to its own content</option>
            </select>
            <small>
              The same box keeps a book steady as you page through it. Per-page trims tighter and
              makes the page size jump around.
            </small>
          </label>
          <label class="field">
            <span>Leave a margin of</span>
            <input data-ac-pad type="number" min="0" max="72" step="1" value="6" />
            <small>Points. A little breathing room so the crop does not sit flush against the text.</small>
          </label>
        </Fragment>
      )
    }

    {
      mode === 'grayscale' && (
        <label class="field">
          <span>JPEG quality, where a photo has to be re-encoded</span>
          <input data-gs-q type="number" min="0.3" max="1" step="0.02" value="0.82" />
          <small>
            Only photographs are re-encoded; everything else converts without a second lossy
            pass. Greyscale usually shrinks a file because three channels become one — but on a
            scan that was already packed hard it can come out larger, and you will be told which
            happened rather than left to guess.
          </small>
        </label>
      )
    }

    {
      mode === 'crop' && (
        <Fragment>
          <label class="field">
            <span>Trim from each edge</span>
            <span class="triple">
              <input data-crop-top type="number" min="0" max="45" value="0" placeholder="top %" />
              <input data-crop-side type="number" min="0" max="45" value="0" placeholder="sides %" />
              <input data-crop-bottom type="number" min="0" max="45" value="0" placeholder="bottom %" />
            </span>
            <small>
              A percentage of the page as you see it, so it works the same on a rotated scan.
              Nothing is deleted: cropping moves the page box, and the trimmed margins stay one
              edit away from coming back.
            </small>
          </label>
          <label class="field">
            <span>Pages</span>
            <input data-crop-pages placeholder="all, or 1-4, 9" />
          </label>
        </Fragment>
      )
    }

    {
      mode === 'flatten' && (
        <fieldset class="field">
          <legend>Make permanent</legend>
          <label><input type="checkbox" data-flat-fields checked /> Form fields — keep how they look, stop them being edited</label>
          <label><input type="checkbox" data-flat-annots checked /> Comments, highlights and stamps</label>
          <label><input type="checkbox" data-flat-layers /> Layers — keep only what is visible now</label>
          <label><input type="checkbox" data-flat-links checked /> Keep links clickable</label>
          <small>Anything this cannot bake in is reported rather than dropped quietly.</small>
        </fieldset>
      )
    }

    {
      mode === 'impose' && (
        <Fragment>
          <label class="field">
            <span>Layout</span>
            <select data-imp-kind>
              <option value="n-up">Several pages per sheet</option>
              <option value="booklet">Booklet — fold and staple</option>
              <option value="poster">Poster — one page across many sheets</option>
            </select>
          </label>
          <label class="field">
            <span>Pages per sheet</span>
            <select data-imp-per>
              <option value="2" selected>2</option>
              <option value="4">4</option>
              <option value="6">6</option>
              <option value="8">8</option>
              <option value="9">9</option>
              <option value="16">16</option>
            </select>
            <small>Ignored for a booklet, which is always two to a side.</small>
          </label>
          <label class="field">
            <span>Sheet</span>
            <select data-imp-sheet>
              <option value="a4" selected>A4</option>
              <option value="letter">Letter</option>
              <option value="a3">A3</option>
            </select>
          </label>
          <label class="field"><input type="checkbox" data-imp-sep /> Draw a hairline between pages</label>
        </Fragment>
      )
    }

    {
      mode === 'extract-images' && (
        <Fragment>
          <label class="field">
            <span>Ignore images smaller than</span>
            <input data-ext-min type="number" min="0" value="64" />
            <small>Pixels on the shorter side. Rules, bullets and spacers are images too; this leaves them out.</small>
          </label>
          <label class="field"><input type="checkbox" data-ext-masks checked /> Apply transparency masks</label>
        </Fragment>
      )
    }

    {
      mode === 'overlay' && (
        <Fragment>
          <label class="field">
            <span>Apply the second file</span>
            <select data-ov-mode>
              <option value="repeat" selected>Its first page, onto every page</option>
              <option value="pairwise">Page for page</option>
            </select>
          </label>
          <label class="field">
            <span>Draw it</span>
            <select data-ov-layer>
              <option value="over" selected>Over the page</option>
              <option value="under">Under the page — for letterhead</option>
            </select>
          </label>
          <label class="field">
            <span>Opacity</span>
            <input data-ov-opacity type="number" min="0.05" max="1" step="0.05" value="1" />
          </label>
          <small>Drop the base document first, then the one to lay over it.</small>
        </Fragment>
      )
    }

    {
      mode === 'text-to-pdf' && (
        <Fragment>
          <label class="field">
            <span>Paper</span>
            <select data-td-paper>
              <option value="a4" selected>A4</option>
              <option value="letter">Letter</option>
            </select>
          </label>
          <label class="field">
            <span>Text size</span>
            <input data-td-size type="number" min="6" max="24" step="0.5" value="10.5" />
          </label>
          <small>Plain text, CSV and Markdown. The kind is read from the file, not guessed from the name.</small>
        </Fragment>
      )
    }

    {
      mode === 'metadata' && (
        <Fragment>
          <div class="fields" data-meta-current />
          <label class="field"><span>Title</span><input data-meta-title /></label>
          <label class="field"><span>Author</span><input data-meta-author /></label>
          <label class="field"><span>Subject</span><input data-meta-subject /></label>
          <label class="field"><span>Keywords</span><input data-meta-keywords /></label>
          <label class="field"><input type="checkbox" data-meta-strip /> Remove everything instead, including the XMP packet</label>
        </Fragment>
      )
    }

    {
      mode === 'header-footer' && (
        <Fragment>
          <label class="field">
            <span>Header — left, centre, right</span>
            <span class="triple">
              <input data-hf-hl placeholder="left" />
              <input data-hf-hc placeholder="centre" />
              <input data-hf-hr placeholder="right" />
            </span>
          </label>
          <label class="field">
            <span>Footer — left, centre, right</span>
            <span class="triple">
              <input data-hf-fl placeholder="left" />
              <input data-hf-fc placeholder="centre" />
              <input data-hf-fr placeholder="right" value="{page} of {pages}" />
            </span>
            <small>Tokens: {'{page}'}, {'{pages}'}, {'{date}'}, {'{filename}'}.</small>
          </label>
          <label class="field">
            <span>Bates prefix</span>
            <input data-hf-bates placeholder="ABC" />
            <small>
              A fixed prefix and a padded number running across the whole document, for legal
              and discovery work. It takes the footer's right slot, so clear that first.
            </small>
          </label>
          <label class="field"><span>Start numbering at</span><input data-hf-start type="number" min="1" value="1" /></label>
          <label class="field"><span>Leave the first N pages alone</span><input data-hf-skip type="number" min="0" value="0" /></label>
          <label class="field"><input type="checkbox" data-hf-mirror /> Mirror on odd and even pages</label>
        </Fragment>
      )
    }

    {
      mode === 'split-by' && (
        <Fragment>
          <label class="field">
            <span>Split</span>
            <select data-sb-mode>
              <option value="every" selected>Every N pages</option>
              <option value="parts">Into N files of equal length</option>
              <option value="size">At a size limit</option>
              <option value="bookmarks">At every top-level bookmark</option>
            </select>
          </label>
          <label class="field"><span>N</span><input data-sb-n type="number" min="1" value="10" /></label>
          <label class="field">
            <span>Size limit (MB)</span>
            <input data-sb-mb type="number" min="0.1" step="0.1" value="5" />
            <small>Approximate: pages share fonts and images, so size is not proportional to page count.</small>
          </label>
        </Fragment>
      )
    }

    <div class="workspace__actions">
      <button class="btn btn--primary" data-run type="button">{action}</button>
      <button class="btn btn--quiet" data-clear type="button">Clear</button>
    </div>

    <p class="status" data-status role="status" aria-live="polite"></p>
  </div>

  <section class="result" data-result hidden aria-live="polite">
    <div class="result__headline">
      <span class="result__pct" data-pct></span>
      <span class="result__sizes" data-sizes></span>
    </div>

    <div class="result__bar" data-bar-wrap aria-hidden="true">
      <span class="result__bar-fill" data-bar></span>
    </div>

    <p class="result__why" data-why hidden></p>
    <ul class="result__notes" data-notes></ul>

    <div class="result__actions" data-downloads></div>

    <p class="result__receipt" data-receipt></p>
  </section>

  <p class="error" data-error hidden role="alert"></p>

  <SaveDialog />

  <aside class="privacy">
    <strong>Private by construction.</strong>
    <span>No upload starts when you choose a file. The work happens in this tab.</span>
  </aside>
</section>

<script>
  import type { WorkerRequest, WorkerResponse } from '../lib/pdf/types';
  import type { EditMark } from '../lib/pdf/types';

  const root = document.querySelector<HTMLElement>('[data-pdf-tool]');

  if (root) {
    const mode = root.dataset.mode as WorkerRequest['op'];
    const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;

    const input = q<HTMLInputElement>('[data-input]');
    const drop = q('[data-drop]');
    const workspace = q('[data-workspace]');
    const list = q<HTMLOListElement>('[data-files]');
    const runBtn = q<HTMLButtonElement>('[data-run]');
    const clearBtn = q<HTMLButtonElement>('[data-clear]');
    const status = q('[data-status]');
    const result = q('[data-result]');
    const pct = q('[data-pct]');
    const sizes = q('[data-sizes]');
    const barWrap = q('[data-bar-wrap]');
    const bar = q('[data-bar]');
    const why = q('[data-why]');
    const notes = q('[data-notes]');
    const downloads = q('[data-downloads]');
    const receipt = q('[data-receipt]');
    const errorEl = q('[data-error]');
    const previewSection = q('[data-preview]');
    const previewNote = q('[data-preview-note]');
    const previewPages = q<HTMLElement>('[data-preview-pages]');
    interface LiveEditorElement extends HTMLElement {
      open(file: File): Promise<void>;
      release(): Promise<void>;
      getEdits(): EditMark[];
      setToolPreview(guide: { kind: 'none' | 'watermark' | 'page-number'; text?: string; start?: number }): void;
    }
    const liveEditor = root.querySelector('live-pdf-editor') as LiveEditorElement | null;
    /* Lens is an Astro component: it forwards `class` but not arbitrary data
       attributes, so the dropzone can only be found by its class. */
    const fileUi = q<HTMLElement>('.drop');
    const fileBar = q<HTMLElement>('[data-file-bar]');
    const fileBarLabel = q('[data-file-bar-label]');
    const changeFileBtn = q<HTMLButtonElement>('[data-change-file]');

    let files: File[] = [];
    let worker: Worker | null = null;
    let jobId = 0;
    let urls: string[] = [];
    let previewUrls: string[] = [];
    /** Id of the in-flight page-size probe, so its answer is never shown as a result. */
    let probeId = -1;
    /** Id of the in-flight thumbnail preview, so its answer is never shown as a result. */
    let previewId = -1;

    /**
     * The page grid speaks to the worker in request/response pairs rather than
     * fire-and-forget, so its messages resolve promises here instead of
     * landing in the result panel.
     */
    const gridWaiting = new Map<number, (result: OpResult) => void>();

    interface GridElement extends HTMLElement {
      attach(host: { request(message: Partial<WorkerRequest>): Promise<OpResult> }): void;
      load(): Promise<string | null>;
      release(): Promise<void>;
      getPlan(): { file: number; page: number; rotate: number }[];
      getCuts(): number[];
      getRanges(): string;
      applyRanges(text: string): void;
      readonly touched: boolean;
    }

    const grid = root.querySelector('page-grid') as GridElement | null;

    /** Identifies the grid's open documents across messages, unlike a job id. */
    let gridSession = 0;

    interface SaveDialogElement extends HTMLElement {
      ask(request: { name: string; siblings: string[]; index: number }): Promise<{
        name: string;
        all: string[] | null;
      } | null>;
    }

    const saveDialog = root.querySelector('save-dialog') as SaveDialogElement | null;

    /**
     * Asks what the file should be called before it is written.
     *
     * If the dialog is somehow not there, saving still works with the name the
     * tool produced — naming is a convenience, and losing it should never cost
     * someone the file they just waited for.
     */
    async function saveAs(request: { name: string; siblings: string[]; index: number }) {
      if (!saveDialog?.ask) return { name: request.name, all: null };
      return saveDialog.ask(request);
    }

    // Nothing should outlive the tab: a session holds a parsed PDF.
    window.addEventListener('pagehide', () => {
      if (grid) void grid.release();
    });

    const takesImages = mode === 'images-to-pdf';
    const takesMany = mode === 'merge' || mode === 'compare' || mode === 'overlay' || takesImages;

    const kb = (n: number) => `${(n / 1024).toFixed(1)} KB`;
    const size = (n: number) => (n >= 1048576 ? `${(n / 1048576).toFixed(2)} MB` : kb(n));

    /**
     * An empty page box means "the default for this tool", not page zero.
     * Number('') is 0, which reads as an out-of-range page and rejects the job.
     */
    function readTargetPage(): number {
      const raw = root.querySelector<HTMLInputElement>('[data-target-page]')?.value?.trim() ?? '';
      if (raw === '') return mode === 'sign' ? -1 : 1;
      const value = Number(raw);
      return Number.isFinite(value) && value > 0 ? value : 1;
    }

    const perm = (name: string): boolean =>
      root.querySelector<HTMLInputElement>(`[data-perm="${name}"]`)?.checked ?? false;

    /**
     * The signature pad.
     *
     * Drawn at 3x the placed size so the mark stays crisp when a reader zooms,
     * and trimmed to its ink before embedding — a canvas-sized PNG would put a
     * large transparent rectangle on the page and push the mark out of place.
     */
    function setupSignature() {
      const canvas = root.querySelector<HTMLCanvasElement>('[data-signature-canvas]');
      if (!canvas) return;

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      ctx.lineWidth = 3.5;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.strokeStyle = '#1a2340';

      let drawing = false;

      const at = (event: PointerEvent) => {
        const box = canvas.getBoundingClientRect();
        return {
          x: ((event.clientX - box.left) / box.width) * canvas.width,
          y: ((event.clientY - box.top) / box.height) * canvas.height,
        };
      };

      canvas.addEventListener('pointerdown', (event) => {
        drawing = true;
        canvas.setPointerCapture(event.pointerId);
        const { x, y } = at(event);
        ctx.beginPath();
        ctx.moveTo(x, y);
      });

      canvas.addEventListener('pointermove', (event) => {
        if (!drawing) return;
        event.preventDefault();
        const { x, y } = at(event);
        ctx.lineTo(x, y);
        ctx.stroke();
      });

      for (const name of ['pointerup', 'pointercancel', 'pointerleave'] as const) {
        canvas.addEventListener(name, () => {
          drawing = false;
        });
      }

      root.querySelector('[data-sign-clear]')?.addEventListener('click', () => {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
      });

      for (const tab of root.querySelectorAll<HTMLButtonElement>('[data-sign-tab]')) {
        tab.addEventListener('click', () => {
          const wanted = tab.dataset.signTab;
          for (const other of root.querySelectorAll<HTMLButtonElement>('[data-sign-tab]')) {
            other.classList.toggle('is-on', other === tab);
          }
          for (const panel of root.querySelectorAll<HTMLElement>('[data-sign-panel]')) {
            panel.hidden = panel.dataset.signPanel !== wanted;
          }
        });
      }
    }

    /** Crops a canvas to its drawn pixels. */
    function trimmed(source: HTMLCanvasElement): HTMLCanvasElement | null {
      const ctx = source.getContext('2d');
      if (!ctx) return null;

      const { data } = ctx.getImageData(0, 0, source.width, source.height);
      let minX = source.width;
      let minY = source.height;
      let maxX = -1;
      let maxY = -1;

      for (let y = 0; y < source.height; y += 1) {
        for (let x = 0; x < source.width; x += 1) {
          if (data[(y * source.width + x) * 4 + 3] < 8) continue;
          if (x < minX) minX = x;
          if (x > maxX) maxX = x;
          if (y < minY) minY = y;
          if (y > maxY) maxY = y;
        }
      }

      if (maxX < 0) return null; // nothing drawn

      const pad = 6;
      minX = Math.max(0, minX - pad);
      minY = Math.max(0, minY - pad);
      maxX = Math.min(source.width - 1, maxX + pad);
      maxY = Math.min(source.height - 1, maxY + pad);

      const out = document.createElement('canvas');
      out.width = maxX - minX + 1;
      out.height = maxY - minY + 1;
      out.getContext('2d')?.drawImage(source, minX, minY, out.width, out.height, 0, 0, out.width, out.height);
      return out;
    }

    function signatureBytes(): ArrayBuffer | undefined {
      if (mode !== 'sign') return undefined;

      const typed = root.querySelector<HTMLInputElement>('[data-sign-text]');
      const typePanel = root.querySelector<HTMLElement>('[data-sign-panel="type"]');

      if (typePanel && !typePanel.hidden && typed?.value.trim()) {
        const canvas = document.createElement('canvas');
        canvas.width = 900;
        canvas.height = 260;
        const ctx = canvas.getContext('2d');
        if (!ctx) return undefined;
        ctx.fillStyle = '#1a2340';
        ctx.font = 'italic 120px ui-serif, Georgia, serif';
        ctx.textBaseline = 'middle';
        ctx.fillText(typed.value.trim(), 20, canvas.height / 2);
        const cropped = trimmed(canvas);
        return cropped ? dataToBytes(cropped) : undefined;
      }

      const pad = root.querySelector<HTMLCanvasElement>('[data-signature-canvas]');
      if (!pad) return undefined;
      const cropped = trimmed(pad);
      return cropped ? dataToBytes(cropped) : undefined;
    }

    function dataToBytes(canvas: HTMLCanvasElement): ArrayBuffer {
      const url = canvas.toDataURL('image/png');
      const binary = atob(url.slice(url.indexOf(',') + 1));
      const bytes = new Uint8Array(binary.length);
      for (let i = 0; i < binary.length; i += 1) bytes[i] = binary.charCodeAt(i);
      return bytes.buffer;
    }

    /**
     * Builds an input per field the document actually has. A form is different
     * in every PDF, so this markup cannot be written ahead of time.
     */
    function renderFields(fields: import('../lib/pdf/types').FormField[]) {
      const host = root.querySelector<HTMLElement>('[data-fields]');
      if (!host) return;

      if (fields.length === 0) {
        host.innerHTML = '<p class="fields__empty">This PDF has no fillable fields.</p>';
        runBtn.disabled = true;
        return;
      }

      runBtn.disabled = false;
      const frag = document.createDocumentFragment();

      for (const field of fields) {
        const row = document.createElement('label');
        row.className = 'field';

        const label = document.createElement('span');
        label.textContent = field.name + (field.readOnly ? ' (read-only)' : '');
        row.append(label);

        let control: HTMLElement;

        if (field.type === 'checkbox') {
          const box = document.createElement('input');
          box.type = 'checkbox';
          box.checked = field.value === 'on';
          control = box;
        } else if ((field.type === 'dropdown' || field.type === 'radio') && field.options?.length) {
          const select = document.createElement('select');
          for (const option of ['', ...field.options]) {
            const item = document.createElement('option');
            item.value = option;
            item.textContent = option || '—';
            if (option === field.value) item.selected = true;
            select.append(item);
          }
          control = select;
        } else if (field.type === 'unsupported') {
          const note = document.createElement('small');
          note.textContent = 'Not a fillable field — left as it is.';
          row.append(note);
          frag.append(row);
          continue;
        } else {
          const input = document.createElement('input');
          input.type = 'text';
          input.value = field.value;
          control = input;
        }

        (control as HTMLInputElement).disabled = Boolean(field.readOnly);
        control.setAttribute('data-field', field.name);
        control.setAttribute('data-field-type', field.type);
        row.append(control);
        frag.append(row);
      }

      host.replaceChildren(frag);
    }

    function readFields(): Record<string, string> {
      const out: Record<string, string> = {};
      for (const el of root.querySelectorAll<HTMLInputElement>('[data-field]')) {
        if (el.disabled) continue;
        const name = el.getAttribute('data-field');
        if (!name) continue;
        out[name] = el.type === 'checkbox' ? (el.checked ? 'on' : '') : el.value;
      }
      return out;
    }

    /** "3, 1, 2" → [2, 0, 1]. Empty means "leave the order alone". */
    function readOrder(): number[] {
      const raw = root.querySelector<HTMLInputElement>('[data-order]')?.value ?? '';
      if (!raw.trim()) return [];
      return raw
        .split(/[\s,]+/)
        .filter(Boolean)
        .map((n) => Number(n) - 1);
    }

    /** Created on first use — a tool page costs no JS until someone acts. */
    function ensureWorker(): Worker {
      if (!worker) {
        worker = new Worker(new URL('../lib/pdf/worker.ts', import.meta.url), { type: 'module' });
        worker.onmessage = (e: MessageEvent<WorkerResponse>) => onDone(e.data);
        worker.onerror = () => fail('The engine failed to start.');
      }
      return worker;
    }

    function revoke() {
      for (const url of urls) URL.revokeObjectURL(url);
      urls = [];
    }

    function fail(message: string) {
      errorEl.textContent = message;
      errorEl.hidden = false;
      runBtn.disabled = false;
      status.textContent = '';
    }

    const usable = (file: File) => {
      if (takesImages) {
        return /^image\/(jpeg|png|webp)$/.test(file.type) || /\.(jpe?g|png|webp)$/i.test(file.name);
      }
      if (mode === 'word-to-pdf') return /\.docx$/i.test(file.name);
      if (mode === 'excel-to-pdf') return /\.xlsx$/i.test(file.name);
      if (mode === 'powerpoint-to-pdf') return /\.pptx$/i.test(file.name);
      // The kind is decided from the CONTENT inside the converter; the name
      // only decides what the picker offers.
      if (mode === 'text-to-pdf') return /\.(txt|csv|tsv|md|markdown|log)$/i.test(file.name);
      return file.type === 'application/pdf' || file.name.toLowerCase().endsWith('.pdf');
    };

    /**
     * How much resolution a page can take depends on how big the page is, so
     * the DPI choices are narrowed once there is a file to measure. This costs
     * one pdf-lib parse and downloads no renderer.
     */
    function limitDpi(maxDpi: number) {
      const radios = [...root!.querySelectorAll<HTMLInputElement>('input[name="dpi"]')];
      const note = root!.querySelector<HTMLElement>('[data-dpi-note]');
      let blocked = 0;

      for (const radio of radios) {
        const allowed = Number(radio.value) <= maxDpi;
        radio.disabled = !allowed;
        radio.parentElement?.toggleAttribute('data-off', !allowed);
        if (!allowed) {
          blocked += 1;
          radio.checked = false;
        }
      }

      const enabled = radios.filter((radio) => !radio.disabled);
      if (enabled.length > 0 && !enabled.some((radio) => radio.checked)) {
        enabled[enabled.length - 1]!.checked = true;
      }

      if (note) {
        note.textContent = blocked
          ? `This document's pages are large enough that anything above ${maxDpi} DPI would exceed the canvas limit, so the higher settings are off.`
          : '';
        note.hidden = blocked === 0;
      }
    }

    async function probe(file: File) {
      probeId = ++jobId;
      const bytes = await file.arrayBuffer();
      ensureWorker().postMessage(
        { id: probeId, op: mode, files: [{ name: file.name, bytes }], probe: true },
        [bytes]
      );
    }

    /** Only modes whose input file is a PDF pdf.js can open. */
    const NON_PDF_INPUT = new Set(['images-to-pdf', 'word-to-pdf', 'excel-to-pdf', 'powerpoint-to-pdf', 'text-to-pdf', 'url-to-pdf']);
    const previewable = !NON_PDF_INPUT.has(mode) && !liveEditor;

    async function preview(file: File) {
      previewId = ++jobId;
      const bytes = await file.arrayBuffer();
      ensureWorker().postMessage(
        { id: previewId, op: mode, files: [{ name: file.name, bytes }], preview: true },
        [bytes]
      );
    }

    function renderThumbnailStrip(thumbnails: { page: number; bytes: Uint8Array }[], totalPages: number) {
      for (const url of previewUrls) URL.revokeObjectURL(url);
      previewUrls = [];

      previewPages.replaceChildren(
        ...thumbnails.map(({ page, bytes }) => {
          const url = URL.createObjectURL(new Blob([bytes as BlobPart], { type: 'image/png' }));
          previewUrls.push(url);
          const figure = document.createElement('figure');
          figure.dataset.page = String(page);
          const frame = document.createElement('div');
          frame.className = 'preview__frame';
          const img = document.createElement('img');
          img.src = url;
          img.alt = `Page ${page}`;
          img.loading = 'lazy';
          frame.append(img);
          const caption = document.createElement('figcaption');
          caption.textContent = `Page ${page}`;
          figure.append(frame, caption);
          return figure;
        })
      );

      previewNote.textContent =
        totalPages > thumbnails.length
          ? `Showing the first ${thumbnails.length} of ${totalPages} pages.`
          : '';
      previewNote.hidden = totalPages <= thumbnails.length;
      previewSection.hidden = false;
      updateLiveOverlay();
    }

    /**
     * Best-effort, non-throwing page-set parser for the live preview only.
     * The real page maths lives in the worker; this just has to be forgiving
     * enough not to blank the preview while someone is mid-keystroke.
     */
    function clearOverlay(figure: HTMLElement) {
      figure.querySelector('.preview__overlay')?.remove();
    }

    function addOverlay(figure: HTMLElement, text: string, kind: string) {
      if (!text.trim()) return;
      const frame = figure.querySelector('.preview__frame');
      if (!frame) return;
      const el = document.createElement('div');
      el.className = `preview__overlay preview__overlay--${kind}`;
      el.textContent = text;
      frame.append(el);
    }

    /**
     * Turns the read-only thumbnail strip into a live before/after for the
     * text tools: the overlay updates as the fields change, with no worker
     * round trip. Purely visual — running the tool still does the real work.
     * Page-arrangement tools (rotate, reorder, extract, delete, split, merge)
     * get the interactive grid instead and never reach this strip at all.
     */
    function updateLiveOverlay() {
      if (liveEditor) {
        if (mode === 'watermark') {
          liveEditor.setToolPreview({
            kind: 'watermark',
            text: root.querySelector<HTMLInputElement>('[data-text]')?.value ?? '',
          });
        } else if (mode === 'page-numbers') {
          const start = Number(root.querySelector<HTMLInputElement>('[data-start-number]')?.value || 1);
          const prefix = root.querySelector<HTMLInputElement>('[data-prefix]')?.value ?? '';
          liveEditor.setToolPreview({ kind: 'page-number', text: prefix, start });
        } else {
          liveEditor.setToolPreview({ kind: 'none' });
        }
        return;
      }

      const figures = [...previewPages.querySelectorAll<HTMLElement>('figure[data-page]')];
      if (!figures.length) return;
      for (const figure of figures) clearOverlay(figure);

      if (mode === 'watermark') {
        const text = root.querySelector<HTMLInputElement>('[data-text]')?.value ?? '';
        for (const figure of figures) addOverlay(figure, text, 'watermark');
      } else if (mode === 'page-numbers') {
        const start = Number(root.querySelector<HTMLInputElement>('[data-start-number]')?.value || 1);
        const prefix = root.querySelector<HTMLInputElement>('[data-prefix]')?.value ?? '';
        figures.forEach((figure, index) => addOverlay(figure, `${prefix}${start + index}`, 'page-number'));
      } else if (mode === 'edit') {
        const text = root.querySelector<HTMLInputElement>('[data-text]')?.value ?? '';
        const targetPage = Number(root.querySelector<HTMLInputElement>('[data-target-page]')?.value || 1);
        const figure = figures.find((f) => Number(f.dataset.page) === targetPage);
        if (figure) addOverlay(figure, text, 'edit');
      }
    }

    function showFiles(next: File[]) {
      const kept = next.filter(usable);

      files = takesMany ? kept : kept.slice(0, 1);

      list.replaceChildren(
        ...files.map((file) => {
          const li = document.createElement('li');
          li.textContent = `${file.name} · ${size(file.size)}`;
          return li;
        })
      );

      workspace.hidden = files.length === 0;
      result.hidden = true;
      errorEl.hidden = true;
      status.textContent = '';
      revoke();

      previewSection.hidden = true;
      previewPages.replaceChildren();
      for (const url of previewUrls) URL.revokeObjectURL(url);
      previewUrls = [];
      if (liveEditor) void liveEditor.release();

      // The dropzone is only useful before a file is picked — once one is,
      // showing it alongside the file list and preview just eats space.
      const hasFiles = files.length > 0;
      fileUi.hidden = hasFiles;
      fileBar.hidden = !hasFiles;
      if (hasFiles) {
        fileBarLabel.textContent =
          files.length === 1 ? files[0].name : `${files.length} files selected`;
      }

      if ((mode === 'pdf-to-images' || mode === 'forms' || mode === 'metadata') && files[0]) {
        void probe(files[0]);
      }

      // A tool with a grid gets the grid instead of the thumbnail strip: the
      // strip shows the first eight pages, the grid shows all of them and
      // lets you act on what you see.
      if (grid) void openGrid();
      else if (liveEditor && files[0]) void liveEditor.open(files[0]).then(updateLiveOverlay);
      else if (previewable && files[0]) void preview(files[0]);
    }

    changeFileBtn.addEventListener('click', () => input.click());

    // Purely visual — reruns on every keystroke or toggle so the preview
    // tracks whatever the tool's own fields currently say, with no worker
    // round trip. The worker call on Run is the source of truth.
    workspace.addEventListener('input', updateLiveOverlay);
    workspace.addEventListener('change', updateLiveOverlay);

    const PREVIEW_SIZE_KEY = 'pdftool-preview-size';
    const sizeButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-preview-sizes] [data-size]')];

    function setPreviewSize(sizeValue: string) {
      previewPages.dataset.size = sizeValue;
      for (const button of sizeButtons) {
        button.setAttribute('aria-pressed', String(button.dataset.size === sizeValue));
      }
      localStorage.setItem(PREVIEW_SIZE_KEY, sizeValue);
    }

    for (const button of sizeButtons) {
      button.addEventListener('click', () => setPreviewSize(button.dataset.size ?? 'md'));
    }
    setPreviewSize(localStorage.getItem(PREVIEW_SIZE_KEY) ?? 'md');

    /**
     * Shows what the file is already carrying, and seeds the inputs with it.
     *
     * The point of this tool is the surprise: an author name that survived in
     * the XMP packet long after the document properties were cleared is the
     * kind of thing people want to know before they send a file out.
     */
    function showMetadata(report: {
      title: string;
      author: string;
      subject: string;
      keywords: string;
      creator: string;
      producer: string;
      extraPackets: number;
      custom: { key: string; value: string }[];
      xmp: { present: boolean };
    }) {
      const set = (selector: string, value: string) => {
        const input = root.querySelector<HTMLInputElement>(selector);
        if (input && !input.value) input.value = value;
      };
      set('[data-meta-title]', report.title);
      set('[data-meta-author]', report.author);
      set('[data-meta-subject]', report.subject);
      set('[data-meta-keywords]', report.keywords);

      const current = root.querySelector('[data-meta-current]');
      if (!current) return;

      const rows: string[] = [];
      if (report.creator) rows.push(`Made with ${report.creator}`);
      if (report.producer && report.producer !== report.creator) {
        rows.push(`Written by ${report.producer}`);
      }
      if (report.xmp.present) rows.push('Carries an XMP packet');
      if (report.extraPackets > 0) {
        rows.push(`${report.extraPackets} further XMP packet(s) on pages or images`);
      }
      for (const entry of report.custom.slice(0, 6)) rows.push(`${entry.key}: ${entry.value}`);

      current.replaceChildren(
        ...(rows.length === 0
          ? [Object.assign(document.createElement('p'), { textContent: 'This file carries no metadata beyond the fields below.', className: 'hint' })]
          : rows.map((row) => Object.assign(document.createElement('p'), { textContent: row, className: 'hint' })))
      );
    }

    function onDone({ id, result: res }: WorkerResponse) {
      // Grid traffic is answered where it was asked from.
      const waiting = gridWaiting.get(id);
      if (waiting) {
        gridWaiting.delete(id);
        waiting(res);
        return;
      }

      // A probe answers a question the UI asked, not one the user did. If the
      // file turns out to be unreadable, the real run will say so properly.
      if (id === probeId) {
        probeId = -1;
        if (res.ok && 'pages' in res && mode === 'metadata' && 'xmp' in res) {
          showMetadata(res);
          return;
        }
        if (res.ok && 'probe' in res) {
          if (mode === 'forms') renderFields(res.fields ?? []);
          else limitDpi(res.maxDpi);
        } else if (!res.ok && mode === 'forms') {
          fail(res.error);
        }
        return;
      }

      // Same idea: a preview answers what the dropzone should show, not what
      // the tool produced, so a failure here is quiet — the real run still says so.
      if (id === previewId) {
        previewId = -1;
        if (res.ok && 'preview' in res) renderThumbnailStrip(res.thumbnails, res.pages);
        return;
      }

      if (id !== jobId) return;
      runBtn.disabled = false;
      status.textContent = '';

      if (!res.ok) {
        fail(res.error);
        return;
      }

      if ('probe' in res) return;

      const isCompress = typeof res.ratio === 'number';
      const percent = Math.round((res.ratio ?? 0) * 100);
      const weak = String(Boolean(res.unchanged) || (isCompress && percent < 8));

      pct.textContent = isCompress
        ? res.unchanged
          ? 'Already optimal'
          : `${percent}% smaller`
        : res.summary;
      pct.dataset.weak = isCompress ? weak : 'false';

      sizes.textContent = isCompress
        ? res.unchanged
          ? `${size(res.bytesIn)} — nothing to remove`
          : `${size(res.bytesIn)} → ${size(res.bytesOut)}`
        : `${res.pages} page${res.pages === 1 ? '' : 's'} · ${size(res.bytesOut)}`;

      barWrap.hidden = !isCompress;
      bar.style.width = `${Math.max(2, percent)}%`;
      bar.dataset.weak = weak;

      if (res.explanation) {
        why.textContent = res.explanation;
        why.hidden = false;
      } else {
        why.hidden = true;
      }

      notes.replaceChildren(
        ...(res.notes ?? []).map((note) => {
          const li = document.createElement('li');
          li.textContent = note;
          return li;
        })
      );

      revoke();
      downloads.dataset.many = String(res.files.length > 6);

      const produced = res.files.map((file) => file.name);
      // Names chosen in the dialog, so a second click on the same result does
      // not ask again for something already answered.
      const chosen = new Map<number, string>();

      downloads.replaceChildren(
        ...res.files.map((file, i) => {
          const url = URL.createObjectURL(
            new Blob([file.bytes as BlobPart], { type: file.type ?? 'application/pdf' })
          );
          urls.push(url);
          const a = document.createElement('a');
          a.className = i === 0 ? 'btn btn--primary' : 'btn btn--quiet';
          a.href = url;
          a.download = file.name;
          a.textContent = res.files.length === 1 ? 'Save the file' : file.name;

          a.addEventListener('click', async (event) => {
            if (a.dataset.confirmed === 'true') {
              // The second, synthetic click — let it through and reset.
              delete a.dataset.confirmed;
              return;
            }

            event.preventDefault();

            const answer = await saveAs({
              name: chosen.get(i) ?? file.name,
              siblings: produced,
              index: i,
            });
            if (!answer) return;

            if (answer.all) {
              answer.all.forEach((name, at) => chosen.set(at, name));
              relabel(chosen);
            } else {
              chosen.set(i, answer.name);
            }

            a.download = answer.all ? (answer.all[i] ?? answer.name) : answer.name;
            a.dataset.confirmed = 'true';
            a.click();
          });

          return a;
        })
      );

      /** Keeps the visible list matching what each link will actually save. */
      function relabel(names: Map<number, string>) {
        if (res.files.length === 1) return;
        [...downloads.children].forEach((node, at) => {
          const link = node as HTMLAnchorElement;
          const name = names.get(at);
          if (!name) return;
          link.download = name;
          link.textContent = name;
        });
      }

      receipt.textContent = `${res.pages} pages · ${Math.round(res.durationMs)}ms · 0 bytes sent`;
      result.hidden = false;
    }

    // Real crypto makes the password the weak link, so say so as it is typed.
    const pw = root.querySelector<HTMLInputElement>('[data-user-password]');
    const strength = root.querySelector<HTMLElement>('[data-strength]');
    if (pw && strength && mode === 'protect') {
      const baseline = strength.textContent ?? '';
      pw.addEventListener('input', async () => {
        if (!pw.value) {
          strength.textContent = baseline;
          return;
        }
        const { passwordBits, describeStrength } = await import('../lib/pdf/security');
        const bits = passwordBits(pw.value);
        strength.textContent = `About ${bits} bits of entropy. ${describeStrength(bits)}`;
      });
    }

    if (mode === 'sign') setupSignature();

    // The URL tool has no file to pick, so the dropzone and worker are unused.
    if (mode === 'url-to-pdf') {
      fileUi.hidden = true;

      /**
     * Hands the grid a way to talk to the worker.
     *
     * The file bytes are copied rather than transferred here: the grid keeps
     * its documents open for the whole session, and the run afterwards needs
     * the same bytes again. Transferring would detach them and the export
     * would find an empty buffer.
     */
    async function openGrid(): Promise<void> {
      if (!grid) return;

      // Whatever was open belongs to the file that just went away. Releasing
      // first matters: the worker holds a parsed document per session, and
      // swapping files without closing would keep every one of them alive.
      await grid.release();
      if (files.length === 0) return;

      gridSession += 1;

      const payload = await Promise.all(
        files.map(async (file) => ({ name: file.name, bytes: await file.arrayBuffer() }))
      );

      // Until the grid has its pages, running would silently fall back to the
      // typed box and give a different answer for the same click. Better to
      // wait the moment it takes than to be non-deterministic.
      runBtn.disabled = true;

      grid.attach({
        request(message) {
          return new Promise<OpResult>((resolve) => {
            const id = ++jobId;
            gridWaiting.set(id, resolve);
            ensureWorker().postMessage({
              id,
              op: mode,
              sessionId: gridSession,
              // Only opening needs the bytes; later messages name the session.
              files: message.session === 'open' ? payload : [],
              ...message,
            });
          });
        },
      });

      const failure = await grid.load();
      runBtn.disabled = false;

      if (failure) {
        // The grid failing is not the tool failing — the typed box still works.
        grid.hidden = true;
        return;
      }

      syncRangesFromGrid();
    }

    const rangesInput = q<HTMLInputElement>('[data-ranges]');
    const orderInput = q<HTMLInputElement>('[data-order]');

    /** Grid edited → mirror it into whichever text box this tool shows. */
    function syncRangesFromGrid() {
      if (!grid) return;
      if (rangesInput) rangesInput.value = grid.getRanges();
      if (orderInput) {
        orderInput.value = grid
          .getPlan()
          .map((entry) => entry.page)
          .join(', ');
      }
    }

    if (grid) {
      grid.addEventListener('gridchange', syncRangesFromGrid);

      // Text box edited → mirror it into the grid. Both edit one plan, so
      // neither can quietly disagree with the other.
      rangesInput?.addEventListener('input', () => {
        if (document.activeElement === rangesInput) grid.applyRanges(rangesInput.value);
      });
    }

    runBtn.addEventListener('click', async () => {
        const url = root.querySelector<HTMLInputElement>('[data-url]')?.value?.trim() ?? '';
        if (!url) return fail('Enter a web address first.');

        runBtn.disabled = true;
        errorEl.hidden = true;
        result.hidden = true;
        status.textContent = 'Rendering on our server…';

        try {
          // Unset in a static deploy: the renderer is a separate service and
          // is not running yet. Say so rather than failing with a fetch error.
          const api = import.meta.env.PUBLIC_API_URL;
          if (!api) {
            throw new Error(
              'The renderer is not deployed yet, so this tool only works when you run the project locally. Every other tool here runs in your browser and works right now.'
            );
          }

          let response: Response;
          try {
            response = await fetch(`${api}/api/v1/convert/url-to-pdf`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ url, landscape: false }),
            });
          } catch {
            throw new Error('The renderer could not be reached. It runs as a separate service — check it is running.');
          }

          if (!response.ok) {
            const detail = await response.json().catch(() => ({}));
            throw new Error(detail.detail ?? `The renderer returned ${response.status}.`);
          }

          const blob = await response.blob();
          const objectUrl = URL.createObjectURL(blob);
          urls.push(objectUrl);

          pct.textContent = 'Rendered';
          sizes.textContent = `${size(blob.size)}`;
          barWrap.hidden = true;
          why.hidden = true;
          notes.replaceChildren(
            Object.assign(document.createElement('li'), {
              textContent:
                'Fetched and rendered on our server, because a browser cannot read another site. The page was public; nothing of yours was sent.',
            })
          );

          const link = document.createElement('a');
          link.className = 'btn btn--primary';
          link.href = objectUrl;
          link.download = 'page.pdf';
          link.textContent = 'Save the PDF';
          downloads.replaceChildren(link);

          receipt.textContent = 'rendered remotely · no document uploaded';
          result.hidden = false;
        } catch (error) {
          fail((error as Error).message);
        } finally {
          runBtn.disabled = false;
          status.textContent = '';
        }
      });
    }

    input.addEventListener('change', () => showFiles(Array.from(input.files ?? [])));
    clearBtn.addEventListener('click', () => {
      input.value = '';
      showFiles([]);
    });

    for (const event of ['dragenter', 'dragover'] as const) {
      drop.addEventListener(event, (e) => {
        e.preventDefault();
        drop.dataset.over = 'true';
      });
    }
    for (const event of ['dragleave', 'drop'] as const) {
      drop.addEventListener(event, (e) => {
        e.preventDefault();
        delete drop.dataset.over;
      });
    }
    drop.addEventListener('drop', (e) => showFiles(Array.from(e.dataTransfer?.files ?? [])));

    /**
     * Hands the grid a way to talk to the worker.
     *
     * The file bytes are copied rather than transferred here: the grid keeps
     * its documents open for the whole session, and the run afterwards needs
     * the same bytes again. Transferring would detach them and the export
     * would find an empty buffer.
     */
    async function openGrid(): Promise<void> {
      if (!grid) return;

      // Whatever was open belongs to the file that just went away. Releasing
      // first matters: the worker holds a parsed document per session, and
      // swapping files without closing would keep every one of them alive.
      await grid.release();
      if (files.length === 0) return;

      gridSession += 1;

      const payload = await Promise.all(
        files.map(async (file) => ({ name: file.name, bytes: await file.arrayBuffer() }))
      );

      // Until the grid has its pages, running would silently fall back to the
      // typed box and give a different answer for the same click. Better to
      // wait the moment it takes than to be non-deterministic.
      runBtn.disabled = true;

      grid.attach({
        request(message) {
          return new Promise<OpResult>((resolve) => {
            const id = ++jobId;
            gridWaiting.set(id, resolve);
            ensureWorker().postMessage({
              id,
              op: mode,
              sessionId: gridSession,
              // Only opening needs the bytes; later messages name the session.
              files: message.session === 'open' ? payload : [],
              ...message,
            });
          });
        },
      });

      const failure = await grid.load();
      runBtn.disabled = false;

      if (failure) {
        // The grid failing is not the tool failing — the typed box still works.
        grid.hidden = true;
        return;
      }

      syncRangesFromGrid();
    }

    const rangesInput = q<HTMLInputElement>('[data-ranges]');
    const orderInput = q<HTMLInputElement>('[data-order]');

    /** Grid edited → mirror it into whichever text box this tool shows. */
    function syncRangesFromGrid() {
      if (!grid) return;
      if (rangesInput) rangesInput.value = grid.getRanges();
      if (orderInput) {
        orderInput.value = grid
          .getPlan()
          .map((entry) => entry.page)
          .join(', ');
      }
    }

    if (grid) {
      grid.addEventListener('gridchange', syncRangesFromGrid);

      // Text box edited → mirror it into the grid. Both edit one plan, so
      // neither can quietly disagree with the other.
      rangesInput?.addEventListener('input', () => {
        if (document.activeElement === rangesInput) grid.applyRanges(rangesInput.value);
      });
    }

    runBtn.addEventListener('click', async () => {
      if (!files.length) return;

      runBtn.disabled = true;
      errorEl.hidden = true;
      result.hidden = true;
      status.textContent = 'Working on this device…';

      const payload = await Promise.all(
        files.map(async (file) => ({ name: file.name, bytes: await file.arrayBuffer() }))
      );

      const picked = (name: string) =>
        root.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value;

      const request: WorkerRequest = {
        id: ++jobId,
        op: mode,
        files: payload,
        ranges: root.querySelector<HTMLInputElement>('[data-ranges]')?.value,
        pageOrder: readOrder(),
        text: root.querySelector<HTMLInputElement>('[data-text]')?.value,
        edits: liveEditor?.getEdits() ?? [],
        targetPage: readTargetPage(),
        startNumber: Number(root.querySelector<HTMLInputElement>('[data-start-number]')?.value ?? 1),
        prefix: root.querySelector<HTMLInputElement>('[data-prefix]')?.value ?? '',
        searchable: root.querySelector<HTMLInputElement>('[data-searchable]')?.checked ?? true,
        signature: signatureBytes(),
        corner: root.querySelector<HTMLSelectElement>('[data-corner]')?.value as WorkerRequest['corner'],
        signatureWidth: 180,
        fieldValues: readFields(),
        flatten: root.querySelector<HTMLInputElement>('[data-flatten]')?.checked ?? false,
        userPassword: root.querySelector<HTMLInputElement>('[data-user-password]')?.value ?? '',
        permissions: {
          printing: perm('printing'),
          copying: perm('copying'),
          modifying: perm('modifying'),
          annotating: perm('annotating'),
        },
        turn: Number(picked('turn') ?? 90),
        pageSize: root.querySelector<HTMLSelectElement>('[data-page-size]')
          ?.value as WorkerRequest['pageSize'],
        format: picked('format') as WorkerRequest['format'],
        dpi: Number(picked('dpi') ?? 150),
      };

      const val = (sel: string) => root.querySelector<HTMLInputElement>(sel)?.value ?? '';
      const on = (sel: string) => root.querySelector<HTMLInputElement>(sel)?.checked ?? false;
      const num = (sel: string, fallback: number) => {
        const raw = Number(val(sel));
        return Number.isFinite(raw) ? raw : fallback;
      };
      const sel = (s2: string) => root.querySelector<HTMLSelectElement>(s2)?.value ?? '';

      if (mode === 'auto-crop') {
        request.autoCropOptions = {
          mode: sel('[data-ac-mode]') === 'per-page' ? 'per-page' : 'uniform',
          padding: num('[data-ac-pad]', 6),
        };
      } else if (mode === 'grayscale') {
        request.grayscaleOptions = { jpegQuality: num('[data-gs-q]', 0.82) };
      } else if (mode === 'crop') {
        const top = Math.min(Math.max(num('[data-crop-top]', 0), 0), 45) / 100;
        const side = Math.min(Math.max(num('[data-crop-side]', 0), 0), 45) / 100;
        const bottom = Math.min(Math.max(num('[data-crop-bottom]', 0), 0), 45) / 100;
        request.cropBox = {
          x: side,
          y: top,
          width: Math.max(1 - side * 2, 0.05),
          height: Math.max(1 - top - bottom, 0.05),
        };
        const pages = val('[data-crop-pages]').trim();
        if (pages && !/^all$/i.test(pages)) {
          const wanted: number[] = [];
          for (const part of pages.split(',')) {
            const m = /^\s*(\d+)\s*(?:-\s*(\d+))?\s*$/.exec(part);
            if (!m) continue;
            const from = Number(m[1]);
            const to = m[2] ? Number(m[2]) : from;
            for (let n = Math.min(from, to); n <= Math.max(from, to); n += 1) wanted.push(n);
          }
          if (wanted.length > 0) request.cropPages = wanted;
        }
      } else if (mode === 'flatten') {
        request.flattenOptions = {
          fields: on('[data-flat-fields]'),
          annotations: on('[data-flat-annots]'),
          layers: on('[data-flat-layers]'),
          keepLinks: on('[data-flat-links]'),
        };
      } else if (mode === 'impose') {
        const kind = sel('[data-imp-kind]');
        const sheet = sel('[data-imp-sheet]') as 'a4' | 'letter' | 'a3';
        request.imposeOptions =
          kind === 'booklet'
            ? { kind: 'booklet', sheet }
            : kind === 'poster'
              ? { kind: 'poster', sheet }
              : {
                  kind: 'n-up',
                  perSheet: num('[data-imp-per]', 2) as 2 | 4 | 6 | 8 | 9 | 16,
                  sheet,
                  separators: on('[data-imp-sep]'),
                };
      } else if (mode === 'extract-images') {
        request.extractOptions = {
          minSize: num('[data-ext-min]', 64),
          includeMasks: on('[data-ext-masks]'),
        };
      } else if (mode === 'overlay') {
        request.overlayOptions = {
          mode: sel('[data-ov-mode]') as 'repeat' | 'pairwise',
          layer: sel('[data-ov-layer]') as 'over' | 'under',
          opacity: num('[data-ov-opacity]', 1),
        };
      } else if (mode === 'text-to-pdf') {
        request.textDocOptions = {
          paper: sel('[data-td-paper]') as 'a4' | 'letter',
          fontSize: num('[data-td-size]', 10.5),
        };
      } else if (mode === 'metadata') {
        // The inputs are pre-filled with what the file already says, so
        // sending all four is right: untouched ones are a no-op, an edited one
        // applies, and one someone emptied is a deliberate clear.
        request.metadataChanges = on('[data-meta-strip]')
          ? { strip: true }
          : {
              fields: {
                title: val('[data-meta-title]'),
                author: val('[data-meta-author]'),
                subject: val('[data-meta-subject]'),
                keywords: val('[data-meta-keywords]'),
              },
            };
      } else if (mode === 'header-footer') {
        const bates = val('[data-hf-bates]').trim();
        request.headerFooterOptions = {
          header: {
            left: val('[data-hf-hl]'),
            centre: val('[data-hf-hc]'),
            right: val('[data-hf-hr]'),
          },
          footer: {
            left: val('[data-hf-fl]'),
            centre: val('[data-hf-fc]'),
            right: val('[data-hf-fr]'),
          },
          ...(bates ? { bates: { prefix: bates } } : {}),
          startNumber: num('[data-hf-start]', 1),
          skipPages: num('[data-hf-skip]', 0),
          mirror: on('[data-hf-mirror]'),
        };
      } else if (mode === 'split-by') {
        const how = sel('[data-sb-mode]') as 'every' | 'parts' | 'size' | 'bookmarks';
        request.splitByOptions = {
          mode: how,
          every: num('[data-sb-n]', 10),
          parts: num('[data-sb-n]', 2),
          targetBytes: Math.round(num('[data-sb-mb]', 5) * 1024 * 1024),
        };
      }

      // A grid tool always exports what the grid holds. The typed box feeds
      // the same plan, so there is one path here rather than two that drift.
      if (grid && !grid.hidden) {
        const plan = grid.getPlan();
        if (plan.length === 0) {
          runBtn.disabled = false;
          status.textContent = '';
          fail(
            mode === 'extract'
              ? 'No pages are picked yet. Click the ones you want to pull out.'
              : 'Every page is marked for removal, so there would be nothing left. Keep at least one.'
          );
          return;
        }

        request.op = 'compose';
        request.plan = plan;
        request.cuts = grid.getCuts();
        request.label = (files[0]?.name ?? 'pages').replace(/\.pdf$/i, '');
      }

      // Transfer, don't copy — a 50 MB file should not exist twice in memory.
      ensureWorker().postMessage(request, payload.map((f) => f.bytes));
    });
  }
</script>

<style>
  .tool {
    padding-block: clamp(2rem, 1.5rem + 2vw, 3rem) clamp(3.5rem, 3rem + 4vw, 6rem);
    display: grid;
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    max-width: 46rem;
  }
  .tool[data-live-workspace] { max-width: 78rem; }

  .back {
    font-size: var(--step--1);
    color: var(--muted);
    text-decoration: none;
    justify-self: start;
  }

  .back:hover { color: var(--ink); }

  .tool__head h1 { font-size: var(--step-4); margin-block: 1rem 1.25rem; }
