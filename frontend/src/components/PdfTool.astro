  .drop__title { font-size: var(--step-1); font-weight: 500; }
  .drop__meta { font-size: var(--step--2); color: var(--muted); }

  .workspace { display: grid; gap: 1rem; }

  .files {
    margin: 0; padding-left: 1.2rem; display: grid; gap: 0.3rem;
    font-size: var(--step--1); color: var(--ink-2);
  }

  .preview__head {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.6rem;
  }
  .preview__note { margin: 0; color: var(--muted); font-size: var(--step--2); }
  .preview__note:not([hidden]) ~ .preview__sizes { margin-left: auto; }

  .preview__sizes { display: inline-flex; border: 1px solid var(--line-strong); border-radius: 8px; overflow: hidden; }
