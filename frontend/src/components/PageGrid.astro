---
/**
 * The visual page editor: see the pages, then move, turn, drop or cut them.
 *
 * Six tools used to ask for page numbers in a text box — "1-3, 7, 10-12" —
 * which requires knowing what is on page 7 before you can say anything about
 * it. This is the same instruction given by pointing at the page instead.
 *
 * The text box has NOT been replaced, it has been joined: both edit one plan,
 * and each reflects what the other did. Typing "1-20" is still far quicker
 * than clicking twenty times, and a keyboard remains a first-class way to
 * drive the whole thing.
 */
import type { GridMode } from '../lib/pdf/types';

interface Props {
  mode: GridMode;
}

const { mode } = Astro.props;
---

<page-grid class="page-grid" data-mode={mode} hidden>
  <div class="page-grid__bar">
    <div class="page-grid__count" data-grid-count aria-live="polite"></div>

    <div class="page-grid__actions">
      {
        (mode === 'delete' || mode === 'extract') && (
          <>
            <button type="button" class="page-grid__btn" data-grid-all>Select all</button>
            <button type="button" class="page-grid__btn" data-grid-none>Select none</button>
            <button type="button" class="page-grid__btn" data-grid-invert>Invert</button>
          </>
        )
      }
      {
        (mode === 'rotate' || mode === 'organise' || mode === 'merge') && (
          <>
            <button type="button" class="page-grid__btn" data-grid-turn-all="-90">⟲ Turn all left</button>
            <button type="button" class="page-grid__btn" data-grid-turn-all="90">⟳ Turn all right</button>
          </>
        )
      }
      <button type="button" class="page-grid__btn" data-grid-undo disabled>Undo</button>
      <button type="button" class="page-grid__btn" data-grid-redo disabled>Redo</button>
    </div>
  </div>

  <p class="page-grid__hint" data-grid-hint></p>
  <div class="page-grid__pages" data-grid-pages role="list"></div>

  <dialog class="page-view" data-grid-view aria-label="Page preview">
    <div class="page-view__frame" data-grid-view-frame></div>
    <div class="page-view__bar">
      <button type="button" class="page-grid__btn" data-grid-view-prev>‹ Previous</button>
      <span class="page-view__label" data-grid-view-label aria-live="polite"></span>
      <button type="button" class="page-grid__btn" data-grid-view-next>Next ›</button>
      <button type="button" class="page-grid__btn" data-grid-view-close>Close</button>
    </div>
  </dialog>
  <p class="page-grid__limit" data-grid-limit hidden></p>
</page-grid>

<style is:global>
  /* Cells are built at runtime, so they never receive Astro's scoped
     attribute. Everything is namespaced under .page-grid instead. */
  .page-grid {
    display: block;
    min-width: 0;
    max-width: 100%;
    margin: 0 0 1.25rem;
  }

  .page-grid__bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6rem;
  }

  .page-grid__count {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .page-grid__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .page-grid__btn {
    font: inherit;
    font-size: 0.78rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) * 0.5);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  .page-grid__btn:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .page-grid__btn:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .page-grid__hint,
  .page-grid__limit {
    font-size: 0.8rem;
    color: var(--muted);
    margin: 0 0 0.6rem;
  }

  .page-grid__pages {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(108px, 1fr));
    min-width: 0;
    max-width: 100%;
    gap: 0.85rem;
    max-height: 62vh;
    overflow-y: auto;
    padding: 0.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .page-cell {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem;
    border: 1px solid transparent;
    border-radius: calc(var(--radius) * 0.6);
    background: transparent;
    cursor: pointer;
    user-select: none;
    touch-action: manipulation;
    min-width: 0;
    box-sizing: border-box;
  }

  .page-cell:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* The frame always reserves the box the page occupies AS TURNED, so the
     grid never reflows when a page is rotated and a turned page cannot spill
     out of its own cell. */
  .page-cell__frame {
    position: relative;
    width: 100%;
    /* One height for every cell, with the page contained inside it.
       Reserving each page's own aspect ratio made rows ragged — a landscape
       or quarter-turned page is much shorter than a portrait one, so its
       caption rode up and the row broke. A fixed box also means turning a
       page reflows nothing at all. */
    height: var(--cell-height, 8.25rem);
    container-type: size;
    background: color-mix(in srgb, var(--ink) 4%, transparent);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) * 0.4);
    overflow: hidden;
  }

  .page-cell__frame canvas {
    position: absolute;
    top: 50%;
    left: 50%;
    display: block;
    width: auto;
    height: auto;
    /* Container units, so the page fits the cell whichever way round it is:
       a quarter turn swaps which side of the box constrains it. */
    max-width: 100cqw;
    max-height: 100cqh;
    transform: translate(-50%, -50%) rotate(var(--turn, 0deg));
    transition: transform 160ms ease;
  }

  .page-cell[data-quarter='true'] .page-cell__frame canvas {
    max-width: 100cqh;
    max-height: 100cqw;
  }

  /* A rail in the colour of the file the page came from. Merging three
     documents produces one grid of pages that all look alike, and knowing
     which came from where is the whole reason the order matters. */
  .page-cell[data-source]::before {
    content: '';
    position: absolute;
    left: 0.3rem;
    right: 0.3rem;
    top: 0.3rem;
    height: 3px;
    border-radius: 3px;
    background: var(--source-colour, transparent);
  }

  /* A page whose picture has not arrived, or is past the preview limit. */
  .page-cell__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--muted);
    font-size: 0.75rem;
  }

  .page-cell__label {
    font-size: 0.72rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .page-cell__tools {
    position: absolute;
    inset-inline: 0.3rem;
    top: 0.3rem;
    display: flex;
    justify-content: space-between;
    gap: 0.2rem;
    opacity: 0;
    transition: opacity 120ms ease;
    pointer-events: none;
  }

  .page-cell:hover .page-cell__tools,
  .page-cell:focus-within .page-cell__tools {
    opacity: 1;
    pointer-events: auto;
  }

  .page-cell__tool {
    font: inherit;
    font-size: 0.7rem;
    line-height: 1;
    padding: 0.22rem 0.34rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--paper, #fff);
    color: var(--ink);
    cursor: pointer;
  }

  .page-cell__tool:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Marked for removal: struck through, not hidden — you can put it back. */
  .page-cell[data-removed='true'] .page-cell__frame {
    opacity: 0.32;
  }

  .page-cell[data-removed='true']::after {
    content: '';
    position: absolute;
    inset: 12% 8% auto;
    height: 2px;
    background: var(--accent);
    transform: rotate(-8deg);
  }

  .page-cell[data-picked='true'] {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .page-cell[data-dragging='true'] {
    opacity: 0.35;
  }

  /* Where the dragged page would land. */
  .page-cell[data-drop='before']::before,
  .page-cell[data-drop='after']::before {
    content: '';
    position: absolute;
    top: 4%;
    bottom: 4%;
    width: 3px;
    border-radius: 3px;
    background: var(--accent);
  }

  .page-cell[data-drop='before']::before { left: -0.5rem; }
  .page-cell[data-drop='after']::before { right: -0.5rem; }

  /* Split marks sit between pages. */
  /* Always visible: in delete and extract this is the primary action, and a
     hover-only control does not exist at all on a touch screen. */
  .page-cell__pick {
    position: absolute;
    top: 0.45rem;
    left: 0.45rem;
    width: 1.35rem;
    height: 1.35rem;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1.5px solid var(--line-strong);
    border-radius: 50%;
    background: var(--paper, #fff);
    color: transparent;
    font-size: 0.8rem;
    line-height: 1;
    cursor: pointer;
    z-index: 2;
  }

  .page-cell__pick::after { content: '✓'; }

  .page-cell__pick:hover {
    border-color: var(--accent);
  }

  .page-cell[data-marked='true'] .page-cell__pick {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .page-cell__cut {
    position: absolute;
    right: -0.55rem;
    top: 8%;
    bottom: 8%;
    width: 1.1rem;
    display: grid;
    place-items: center;
    border: 0;
    background: transparent;
    color: var(--line);
    cursor: pointer;
    font-size: 0.9rem;
    line-height: 1;
    padding: 0;
  }

  .page-cell__cut:hover { color: var(--accent); }

  .page-cell[data-cut='true'] .page-cell__cut {
    color: var(--accent);
  }

  .page-cell[data-cut='true'] .page-cell__cut::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--accent);
  }

  .page-view {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0;
    background: var(--paper, #fff);
    color: var(--ink);
    max-width: min(94vw, 900px);
    max-height: 94vh;
    overflow: hidden;
  }

  .page-view::backdrop {
    background: rgb(0 0 0 / 0.55);
  }

  .page-view__frame {
    display: grid;
    place-items: center;
    padding: 1rem 1rem 0;
    /* The page itself decides the height; the dialog just must not exceed the
       viewport, or a landscape page pushes the controls off the bottom. */
    max-height: calc(94vh - 4rem);
    overflow: auto;
  }

  .page-view__frame canvas,
  .page-view__frame img {
    display: block;
    max-width: 100%;
    max-height: calc(94vh - 5rem);
    height: auto;
    width: auto;
    background: #fff;
    box-shadow: 0 8px 28px rgb(0 0 0 / 0.22);
    border-radius: 2px;
  }

  .page-view__loading {
    padding: 4rem 2rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .page-view__bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
    padding: 0.75rem 1rem 1rem;
  }

  .page-view__label {
    font-size: 0.85rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    min-width: 9rem;
    text-align: center;
  }

  .page-grid__float {
    position: fixed;
    z-index: 60;
    pointer-events: none;
    width: 120px;
    opacity: 0.9;
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.24);
    border-radius: calc(var(--radius) * 0.4);
    overflow: hidden;
  }

  .page-grid__float canvas,
  .page-grid__float img { display: block; width: 100%; height: auto; }

  @media (prefers-reduced-motion: reduce) {
    .page-cell__frame { transition: none; }
  }

  @media (hover: none), (max-width: 42rem) {
    .page-grid__pages {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.65rem;
      overflow-x: hidden;
    }

    /* Touch has no hover state. Page-level actions must be available before
       somebody taps a thumbnail, not appear only after an accidental focus. */
    .page-cell__tools {
      opacity: 1;
      pointer-events: auto;
    }

    .page-cell__cut { right: -0.25rem; }
  }
</style>

<script>
  import { parsePageSet } from '../lib/pdf/pageset';
  import type {
    GridMode,
    OpResult,
    PageGeometry,
    PagePlan,
    WorkerRequest,
  } from '../lib/pdf/types';

  /** How the tool talks to the worker. The grid never owns one of its own. */
  interface GridHost {
    request(message: Partial<WorkerRequest>): Promise<OpResult>;
  }

  interface Cell {
    file: number;
    page: number;
    /** Extra clockwise degrees on top of the page's own rotation. */
    rotate: number;
    removed: boolean;
    width: number;
    height: number;
    el: HTMLElement;
    frame: HTMLElement;
    canvas: HTMLCanvasElement | null;
    rendered: boolean;
    /** Position in `order` the last time a render was requested. */
    queued: boolean;
  }

  interface Snapshot {
    order: { file: number; page: number; rotate: number; removed: boolean }[];
    cuts: number[];
  }

  /**
   * One per source document, in order. Chosen to stay apart for the common
   * kinds of colour blindness rather than to look like a palette.
   */
  const SOURCE_COLOURS = [
    'oklch(62% 0.17 250)',
    'oklch(66% 0.16 35)',
    'oklch(68% 0.15 150)',
    'oklch(64% 0.16 300)',
    'oklch(72% 0.14 90)',
    'oklch(60% 0.14 200)',
  ];

  /**
   * Live bitmaps kept at once.
   *
   * Scrolling a long document past the grid would otherwise accumulate every
   * page it ever showed. Cells beyond this are cleared and re-render if they
   * come back into view, which is cheap because the document stays open.
   */
  const LIVE_BITMAPS = 240;

  const MODE_HINTS: Record<GridMode, string> = {
    organise: 'Click a page to see it full size. Drag to move it, and hover for turn and remove. Arrow keys move the focus, [ and ] move the page, R turns it, Delete removes it.',
    merge: 'Click a page to see it full size. Drag pages into the order you want — across files as well as within them — and hover for turn and remove.',
    rotate: 'Hover a page and use ⟲ or ⟳ to turn it, or press R on the focused page and Shift+R to turn it back. Click a page to see it full size.',
    delete: 'Tick the pages you want gone — they stay visible, struck through, until you export. Click a page to see it full size first.',
    extract: 'Tick the pages you want to keep; everything unticked is left behind. Click a page to see it full size first.',
    split: 'Click the ✂ between two pages to cut there — each run becomes its own file. Click a page itself to see it full size.',
  };

  class PageGridElement extends HTMLElement {
    private host: GridHost | null = null;
    private mode: GridMode = 'organise';
    private cells: Cell[] = [];
    private cuts = new Set<number>();
    private undoStack: Snapshot[] = [];
    private redoStack: Snapshot[] = [];
    private observer: IntersectionObserver | null = null;
    private pending = new Set<Cell>();
    private flushTimer = 0;
    private recent: Cell[] = [];
    private previewLimit = Number.POSITIVE_INFINITY;
    /** How many distinct files the grid is showing. */
    private sources = 1;
    private viewer: HTMLDialogElement | null = null;
    private viewing: Cell | null = null;
    private viewToken = 0;
    /** Set when a drag just finished, so its release does not read as a click. */
    private suppressClick = false;
    private sessionOpen = false;

    private pagesEl!: HTMLElement;
    private countEl!: HTMLElement;
    private hintEl!: HTMLElement;
    private limitEl!: HTMLElement;

    connectedCallback(): void {
      this.mode = (this.dataset.mode as GridMode) ?? 'organise';
      this.pagesEl = this.querySelector('[data-grid-pages]') as HTMLElement;
      this.countEl = this.querySelector('[data-grid-count]') as HTMLElement;
      this.hintEl = this.querySelector('[data-grid-hint]') as HTMLElement;
      this.limitEl = this.querySelector('[data-grid-limit]') as HTMLElement;
      this.hintEl.textContent = MODE_HINTS[this.mode];

      this.viewer = this.querySelector('[data-grid-view]');

      this.wireToolbar();
      this.wirePointer();
      this.wireKeyboard();
      this.wireViewer();
    }

    attach(host: GridHost): void {
      this.host = host;
    }

    // ── loading ───────────────────────────────────────────────────────

    /** Opens a session and lays out a cell per page, pictures to follow. */
    async load(): Promise<string | null> {
      if (!this.host) return 'The page grid was not connected to a worker.';

      this.teardown();
      const result = await this.host.request({ session: 'open' });

      if (!result.ok) return result.error;
      if (!('session' in result)) return 'Unexpected answer while opening the preview.';

      this.sessionOpen = true;
      this.previewLimit = result.previewLimit ?? Number.POSITIVE_INFINITY;
      this.build(result.geometry);
      this.hidden = this.cells.length === 0;
      return null;
    }

    private build(geometry: PageGeometry[]): void {
      this.sources = new Set(geometry.map((page) => page.file)).size;
      const fragment = document.createDocumentFragment();
      this.cells = geometry.map((page) => this.makeCell(page));
      for (const cell of this.cells) fragment.append(cell.el);
      this.pagesEl.replaceChildren(fragment);

      this.observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const cell = this.cells.find((candidate) => candidate.el === entry.target);
            if (!cell) continue;
            if (entry.isIntersecting) this.queue(cell);
          }
        },
        // Start a screen early so pictures are usually there by the time the
        // cell is looked at.
        { root: this.pagesEl, rootMargin: '400px 0px' }
      );

      for (const cell of this.cells) this.observer.observe(cell.el);

      const beyond = Math.max(0, this.cells.length - this.previewLimit);
      this.limitEl.hidden = beyond === 0;
      if (beyond > 0) {
        this.limitEl.textContent = `Showing pictures for the first ${this.previewLimit} pages. The remaining ${beyond} are listed by number and can still be moved, turned and removed — drawing thousands of previews would cost more memory than it is worth.`;
      }

      this.refresh();
    }

    private makeCell(page: PageGeometry): Cell {
      const el = document.createElement('div');
      el.className = 'page-cell';
      el.setAttribute('role', 'listitem');
      el.tabIndex = 0;

      const frame = document.createElement('div');
      frame.className = 'page-cell__frame';

      const placeholder = document.createElement('div');
      placeholder.className = 'page-cell__placeholder';
      placeholder.textContent = String(page.page);
      frame.append(placeholder);

      const label = document.createElement('span');
      label.className = 'page-cell__label';

      const tools = document.createElement('div');
      tools.className = 'page-cell__tools';

      if (this.mode !== 'delete' && this.mode !== 'extract' && this.mode !== 'split') {
        tools.append(
          this.makeTool('⟲', 'Turn left', 'turn-left'),
          this.makeTool('⟳', 'Turn right', 'turn-right')
        );
      }
      if (this.mode === 'organise' || this.mode === 'merge') {
        tools.append(this.makeTool('✕', 'Remove this page', 'remove'));
      }

      // Picking is the whole job in these two modes, so its control is always
      // visible rather than appearing on hover: a control you have to discover
      // is a poor primary action, and on a touch screen there is no hover at
      // all.
      if (this.mode === 'delete' || this.mode === 'extract') {
        const pick = document.createElement('button');
        pick.type = 'button';
        pick.className = 'page-cell__pick';
        pick.dataset.gridAction = 'pick';
        el.append(pick);
      }

      // Rotate keeps its turn buttons and nothing else; turning used to be
      // what a click did, and a click now opens the page instead.

      el.append(frame, label, tools);

      if (this.mode === 'split') {
        const cut = document.createElement('button');
        cut.type = 'button';
        cut.className = 'page-cell__cut';
        cut.dataset.gridCut = '';
        cut.textContent = '✂';
        cut.title = 'Cut after this page';
        el.append(cut);
      }

      // Only worth showing when there is more than one file to tell apart;
      // a single document does not need a legend.
      if (this.sources > 1) {
        el.dataset.source = String(page.file);
        el.style.setProperty('--source-colour', SOURCE_COLOURS[page.file % SOURCE_COLOURS.length]);
      }

      return {
        file: page.file,
        page: page.page,
        rotate: 0,
        // Extract starts with nothing picked; everything else starts whole.
        removed: this.mode === 'extract',
        width: page.width,
        height: page.height,
        el,
        frame,
        canvas: null,
        rendered: false,
        queued: false,
      };
    }

    private makeTool(glyph: string, title: string, action: string): HTMLButtonElement {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'page-cell__tool';
      button.dataset.gridAction = action;
      button.title = title;
      button.setAttribute('aria-label', title);
      button.textContent = glyph;
      return button;
    }

    // ── lazy rendering ────────────────────────────────────────────────

    private queue(cell: Cell): void {
      if (cell.rendered || cell.queued) {
        this.touch(cell);
        return;
      }
      if (this.cells.indexOf(cell) >= this.previewLimit) return;

      cell.queued = true;
      this.pending.add(cell);

      if (this.flushTimer) return;
      // Coalesce a scroll's worth of cells into one message.
      this.flushTimer = window.setTimeout(() => {
        this.flushTimer = 0;
        void this.flush();
      }, 40);
    }

    private async flush(): Promise<void> {
      if (!this.host || !this.sessionOpen || this.pending.size === 0) return;

      const batch = [...this.pending].slice(0, 24);
      for (const cell of batch) this.pending.delete(cell);

      const result = await this.host.request({
        session: 'render',
        wanted: batch.map((cell) => ({ file: cell.file, page: cell.page })),
      });

      if (result.ok && 'thumbs' in result) {
        for (const frame of result.frames) {
          const cell = batch.find(
            (candidate) => candidate.file === frame.file && candidate.page === frame.page
          );
          if (!cell) {
            frame.bitmap.close();
            continue;
          }
          this.paint(cell, frame.bitmap);
        }
      }

      for (const cell of batch) cell.queued = false;
      if (this.pending.size > 0) void this.flush();
    }

    private paint(cell: Cell, bitmap: ImageBitmap): void {
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('bitmaprenderer');

      // Size the element from the bitmap BEFORE handing it over.
      //
      // transferFromImageBitmap is documented to adopt the bitmap's
      // dimensions, and Chromium does not: the canvas keeps its default
      // 300x150 and is LAID OUT at that size. Every thumbnail therefore drew
      // into a 2:1 letterbox inside a cell whose own aspect ratio was correct,
      // which is why the pages appeared as a band across the middle with dead
      // space above and below.
      //
      // Reading the size first is also the only chance to read it: the
      // transfer neuters the bitmap and it reports 0x0 afterwards.
      canvas.width = bitmap.width;
      canvas.height = bitmap.height;

      if (ctx) {
        // Hands the pixels over without a copy or a decode.
        ctx.transferFromImageBitmap(bitmap);
      } else {
        canvas.getContext('2d')?.drawImage(bitmap, 0, 0);
        bitmap.close();
      }

      cell.canvas = canvas;
      cell.rendered = true;
      cell.frame.replaceChildren(canvas);
      this.applyRotation(cell);
      this.touch(cell);
    }

    /** Marks a cell as recently seen and releases the ones that are not. */
    private touch(cell: Cell): void {
      const at = this.recent.indexOf(cell);
      if (at >= 0) this.recent.splice(at, 1);
      this.recent.push(cell);

      while (this.recent.length > LIVE_BITMAPS) {
        const stale = this.recent.shift();
        if (!stale || stale === cell || !stale.rendered) continue;
        const placeholder = document.createElement('div');
        placeholder.className = 'page-cell__placeholder';
        placeholder.textContent = String(stale.page);
        stale.frame.replaceChildren(placeholder);
        stale.canvas = null;
        stale.rendered = false;
      }
    }

    // ── the plan ──────────────────────────────────────────────────────

    /** The output, page by page, as the tools consume it. */
    getPlan(): PagePlan[] {
      return this.cells
        .filter((cell) => !cell.removed)
        .map((cell) => ({ file: cell.file, page: cell.page, rotate: cell.rotate }));
    }

    /**
     * Turns every page a selection names, in one undoable step.
     *
     * Tapping ⟲ on each page is fine for one crooked scan and miserable for
     * "every even page is upside down", which is what a duplex scanner
     * produces. Returns how many were turned so the caller can say so.
     */
    turnPages(spec: string, by: number): number {
      const total = this.cells.length;
      const wanted = new Set(parsePageSet(spec, total).pages);
      if (wanted.size === 0) return 0;

      this.commit();
      let turned = 0;
      this.cells.forEach((cell, index) => {
        if (!wanted.has(index + 1)) return;
        cell.rotate = ((cell.rotate + by) % 360 + 360) % 360;
        this.applyRotation(cell);
        turned += 1;
      });
      this.refresh();
      return turned;
    }

    /** Cut points expressed against the kept pages, not the displayed ones. */
    getCuts(): number[] {
      if (this.mode !== 'split') return [];
      const out: number[] = [];
      let kept = 0;
      this.cells.forEach((cell, index) => {
        if (!cell.removed) kept += 1;
        if (this.cuts.has(index) && kept > 0 && kept < this.getPlan().length) out.push(kept);
      });
      return [...new Set(out)];
    }

    /** True once the person has actually changed something. */
    get touched(): boolean {
      return this.undoStack.length > 0;
    }

    /** Original page count, including pages currently marked for removal. */
    get totalPages(): number {
      return this.cells.length;
    }

    /**
     * Keeps a person's page arrangement while another source PDF is appended.
     * The new pages have no entry in the snapshot, so `restoreState` places
     * them after the existing arrangement ready to be dragged into position.
     */
    getState(): Snapshot {
      return this.snapshot();
    }

    restoreState(snapshot: Snapshot): void {
      this.restore(snapshot, true);
      this.undoStack = [];
      this.redoStack = [];
    }

    /** Kept pages as a range string, for the text box to mirror. */
    getRanges(): string {
      const compact = (pages: number[]): string => {
        if (pages.length === 0) return '';
        const parts: string[] = [];
        let start = pages[0];
        let previous = pages[0];
        for (const page of pages.slice(1)) {
          if (page === previous + 1) {
            previous = page;
            continue;
          }
          parts.push(start === previous ? String(start) : `${start}-${previous}`);
          start = page;
          previous = page;
        }
        parts.push(start === previous ? String(start) : `${start}-${previous}`);
        return parts.join(', ');
      };

      if (this.mode !== 'split') {
        return compact(this.cells.filter((cell) => !cell.removed).map((cell) => cell.page));
      }

      const groups: number[][] = [[]];
      this.cells.forEach((cell, index) => {
        if (!cell.removed) groups[groups.length - 1].push(cell.page);
        if (this.cuts.has(index) && groups[groups.length - 1].length > 0) groups.push([]);
      });
      return groups.filter((group) => group.length > 0).map(compact).join(', ');
    }

    /** Applies a typed range so the box and the grid never disagree. */
    applyRanges(text: string): void {
      const wanted = new Set<number>();
      const groups: number[][] = [];
      for (const part of text.split(',')) {
        const range = part.trim();
        if (!range) continue;
        const match = /^(\d+)\s*(?:-\s*(\d+))?$/.exec(range);
        if (!match) continue;
        const from = Number(match[1]);
        const to = match[2] ? Number(match[2]) : from;
        const group: number[] = [];
        const step = from <= to ? 1 : -1;
        for (let page = from; step > 0 ? page <= to : page >= to; page += step) {
          wanted.add(page);
          group.push(page);
        }
        groups.push(group);
      }

      if (wanted.size === 0) return;

      if (this.mode === 'split') {
        const byPage = new Map(this.cells.map((cell) => [cell.page, cell]));
        const placed = new Set<number>();
        const ordered: Cell[] = [];
        const cutAfterPages = new Set<number>();

        groups.forEach((group, groupIndex) => {
          let last: number | null = null;
          for (const page of group) {
            const cell = byPage.get(page);
            if (!cell || placed.has(page)) continue;
            cell.removed = false;
            ordered.push(cell);
            placed.add(page);
            last = page;
          }
          if (last !== null && groupIndex < groups.length - 1) cutAfterPages.add(last);
        });

        for (const cell of this.cells) {
          if (placed.has(cell.page)) continue;
          cell.removed = true;
          ordered.push(cell);
        }

        this.cells = ordered;
        this.cuts.clear();
        this.cells.forEach((cell, index) => {
          if (cutAfterPages.has(cell.page)) this.cuts.add(index);
        });
        this.reflow();
        this.refresh();
        return;
      }

      // `delete` names the pages to lose; the others name the pages to keep.
      for (const cell of this.cells) {
        const named = wanted.has(cell.page);
        cell.removed = this.mode === 'delete' ? named : !named;
      }
      this.refresh();
    }

    // ── editing ───────────────────────────────────────────────────────

    private snapshot(): Snapshot {
      return {
        order: this.cells.map((cell) => ({
          file: cell.file,
          page: cell.page,
          rotate: cell.rotate,
          removed: cell.removed,
        })),
        cuts: [...this.cuts],
      };
    }

    private commit(): void {
      this.undoStack.push(this.snapshot());
      if (this.undoStack.length > 80) this.undoStack.shift();
      this.redoStack = [];
    }

    private restore(snapshot: Snapshot, appendNew = false): void {
      // Cells are matched by identity, then re-ordered, so their canvases and
      // their place in the render queue survive an undo.
      const byKey = new Map<string, Cell>();
      for (const cell of this.cells) byKey.set(`${cell.file}:${cell.page}`, cell);

      const next: Cell[] = [];
      for (const entry of snapshot.order) {
        const key = `${entry.file}:${entry.page}`;
        const cell = byKey.get(key);
        if (!cell) continue;
        cell.rotate = entry.rotate;
        cell.removed = entry.removed;
        this.applyRotation(cell);
        next.push(cell);
        byKey.delete(key);
      }

      if (appendNew) next.push(...byKey.values());

      this.cells = next;
      this.cuts = new Set(snapshot.cuts);
      this.reflow();
      this.refresh();
    }

    private undo(): void {
      const previous = this.undoStack.pop();
      if (!previous) return;
      this.redoStack.push(this.snapshot());
      this.restore(previous);
    }

    private redo(): void {
      const next = this.redoStack.pop();
      if (!next) return;
      this.undoStack.push(this.snapshot());
      this.restore(next);
    }

    private turn(cell: Cell, by: number): void {
      this.commit();
      cell.rotate = ((cell.rotate + by) % 360 + 360) % 360;
      this.applyRotation(cell);
      this.refresh();
    }

    /**
     * Turns a page without letting it escape its cell.
     *
     * A quarter turn swaps which dimension the frame has to accommodate, so
     * the frame's ratio flips and the picture is laid out at the width its
     * rotated height will need — width x natural. Rotating a box that still
     * reserves its upright height just overlaps the neighbours instead.
     */
    private applyRotation(cell: Cell): void {
      // The cell is a fixed box and the page is contained inside it, so a turn
      // is only a transform plus a flag telling CSS which side now constrains.
      cell.el.dataset.quarter = String(cell.rotate % 180 !== 0);
      cell.frame.style.setProperty('--turn', `${cell.rotate}deg`);
    }

    private toggleRemoved(cell: Cell): void {
      this.commit();
      cell.removed = !cell.removed;
      this.refresh();
    }

    private reflow(): void {
      // One write, after the plan settled — not per pointer move.
      const fragment = document.createDocumentFragment();
      for (const cell of this.cells) fragment.append(cell.el);
      this.pagesEl.replaceChildren(fragment);
    }

    /** Repaints every label and state, and tells the tool something changed. */
    private refresh(): void {
      const kept = this.cells.filter((cell) => !cell.removed).length;

      this.cells.forEach((cell, index) => {
        cell.el.dataset.removed = String(cell.removed);
        cell.el.dataset.picked = String(
          (this.mode === 'extract' || this.mode === 'delete') && !cell.removed
        );

        // The tick means the thing the tool is FOR: in delete, that the page
        // goes; in extract, that it stays. Same control, opposite sense, so it
        // has to say which out loud rather than leave it to be inferred.
        const marked = this.mode === 'delete' ? cell.removed : !cell.removed;
        cell.el.dataset.marked = String(marked);
        const pick = cell.el.querySelector('.page-cell__pick');
        if (pick) {
          const label =
            this.mode === 'delete'
              ? marked
                ? `Page ${cell.page} will be removed. Select to keep it.`
                : `Page ${cell.page} will be kept. Select to remove it.`
              : marked
                ? `Page ${cell.page} will be pulled out. Select to leave it.`
                : `Page ${cell.page} will be left behind. Select to pull it out.`;
          pick.setAttribute('aria-pressed', String(marked));
          pick.setAttribute('aria-label', label);
          pick.setAttribute('title', label);
        }
        cell.el.dataset.cut = String(this.cuts.has(index));
        delete cell.el.dataset.drop;

        const label = cell.el.querySelector('.page-cell__label');
        if (label) {
          const moved = cell.page !== index + 1;
          const turn = cell.rotate ? ` · ${cell.rotate}°` : '';
          label.textContent = moved ? `${index + 1} (was ${cell.page})${turn}` : `${index + 1}${turn}`;
        }

        cell.el.setAttribute(
          'aria-label',
          `Page ${cell.page}${cell.removed ? ', removed' : ''}${cell.rotate ? `, turned ${cell.rotate} degrees` : ''}`
        );
      });

      const outputs = this.getCuts().length + 1;
      this.countEl.textContent =
        this.mode === 'split'
          ? `${kept} of ${this.cells.length} pages · ${outputs} file${outputs === 1 ? '' : 's'}`
          : `${kept} of ${this.cells.length} pages kept`;

      const undoBtn = this.querySelector('[data-grid-undo]') as HTMLButtonElement | null;
      const redoBtn = this.querySelector('[data-grid-redo]') as HTMLButtonElement | null;
      if (undoBtn) undoBtn.disabled = this.undoStack.length === 0;
      if (redoBtn) redoBtn.disabled = this.redoStack.length === 0;

      this.dispatchEvent(new CustomEvent('gridchange', { bubbles: true }));
    }

    // ── toolbar, pointer, keyboard ────────────────────────────────────

    private wireToolbar(): void {
      this.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;

        const action = target.closest<HTMLElement>('[data-grid-action]');
        if (action) {
          event.stopPropagation();
          const cell = this.cellOf(action);
          if (!cell) return;
          if (action.dataset.gridAction === 'pick') return void this.toggleRemoved(cell);
          if (action.dataset.gridAction === 'turn-left') this.turn(cell, -90);
          else if (action.dataset.gridAction === 'turn-right') this.turn(cell, 90);
          else if (action.dataset.gridAction === 'remove') this.toggleRemoved(cell);
          return;
        }

        if (target.closest('[data-grid-cut]')) {
          event.stopPropagation();
          const cell = this.cellOf(target);
          if (!cell) return;
          const index = this.cells.indexOf(cell);
          this.commit();
          if (this.cuts.has(index)) this.cuts.delete(index);
          else this.cuts.add(index);
          this.refresh();
          return;
        }

        if (target.closest('[data-grid-undo]')) return this.undo();
        if (target.closest('[data-grid-redo]')) return this.redo();

        const turnAll = target.closest<HTMLElement>('[data-grid-turn-all]');
        if (turnAll) {
          const by = Number(turnAll.dataset.gridTurnAll);
          this.commit();
          for (const cell of this.cells) {
            cell.rotate = ((cell.rotate + by) % 360 + 360) % 360;
            this.applyRotation(cell);
          }
          this.refresh();
          return;
        }

        if (target.closest('[data-grid-all]')) {
          this.commit();
          for (const cell of this.cells) cell.removed = false;
          this.refresh();
          return;
        }
        if (target.closest('[data-grid-none]')) {
          this.commit();
          for (const cell of this.cells) cell.removed = true;
          this.refresh();
          return;
        }
        if (target.closest('[data-grid-invert]')) {
          this.commit();
          for (const cell of this.cells) cell.removed = !cell.removed;
          this.refresh();
          return;
        }

        // A plain click on the page itself opens it, in every mode. The
        // actions a click used to carry — toggle, turn, cut — all have their
        // own controls now, because being able to check a page is worth more
        // than saving a click, and it was the one thing the grid could not do.
        const cell = this.cellOf(target);
        if (!cell) return;
        // A click that ended a drag is not a click.
        if (this.suppressClick) {
          this.suppressClick = false;
          return;
        }
        void this.showPage(cell);
      });
    }

    private wireViewer(): void {
      const dialog = this.viewer;
      if (!dialog) return;

      this.querySelector('[data-grid-view-close]')?.addEventListener('click', () => dialog.close());
      this.querySelector('[data-grid-view-prev]')?.addEventListener('click', () => this.step(-1));
      this.querySelector('[data-grid-view-next]')?.addEventListener('click', () => this.step(1));

      // Clicking the backdrop closes, the way the rest of the site behaves.
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });

      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
          event.preventDefault();
          this.step(1);
        } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
          event.preventDefault();
          this.step(-1);
        }
      });

      dialog.addEventListener('close', () => {
        // Give focus back to the page it was opened from, or the grid is lost.
        this.viewing?.el.focus();
        this.viewing = null;
      });
    }

    private step(by: number): void {
      if (!this.viewing) return;
      const at = this.cells.indexOf(this.viewing);
      const next = this.cells[at + by];
      if (next) void this.showPage(next);
    }

    /**
     * Opens one page big enough to read.
     *
     * Rendered fresh rather than scaled up from the cell: the thumbnail is 220
     * pixels wide, and blowing that up to check a page is the one thing this
     * is for. The rotation the grid is holding is applied here too, so what is
     * on screen is what will be exported.
     */
    private async showPage(cell: Cell): Promise<void> {
      const dialog = this.viewer;
      const frame = this.querySelector('[data-grid-view-frame]');
      const label = this.querySelector('[data-grid-view-label]');
      if (!dialog || !frame) return;

      this.viewing = cell;
      const at = this.cells.indexOf(cell);
      if (label) {
        const moved = cell.page !== at + 1;
        label.textContent = `Page ${at + 1}${moved ? ` (was ${cell.page})` : ''} of ${this.cells.length}${cell.removed ? ' · removed' : ''}`;
      }

      if (!dialog.open) dialog.showModal();

      const holding = document.createElement('p');
      holding.className = 'page-view__loading';
      holding.textContent = 'Rendering…';
      frame.replaceChildren(holding);

      const token = ++this.viewToken;
      const result = await this.host?.request({
        session: 'render',
        wanted: [{ file: cell.file, page: cell.page }],
        thumbWidth: 1400,
      });

      // A fast click through several pages leaves earlier renders in flight.
      if (token !== this.viewToken || this.viewing !== cell) return;

      if (!result?.ok || !('thumbs' in result) || result.frames.length === 0) {
        holding.textContent = 'That page could not be rendered.';
        return;
      }

      const bitmap = result.frames[0].bitmap;
      const canvas = document.createElement('canvas');
      canvas.width = bitmap.width;
      canvas.height = bitmap.height;
      const ctx = canvas.getContext('bitmaprenderer');
      if (ctx) ctx.transferFromImageBitmap(bitmap);
      else {
        canvas.getContext('2d')?.drawImage(bitmap, 0, 0);
        bitmap.close();
      }

      // Show it as it will be exported, not as it is stored.
      if (cell.rotate % 360 !== 0) {
        const quarter = cell.rotate % 180 !== 0;
        canvas.style.transform = `rotate(${cell.rotate}deg)`;
        if (quarter) canvas.style.maxHeight = 'calc(94vw - 5rem)';
      }

      frame.replaceChildren(canvas);
    }

    private cellOf(node: HTMLElement): Cell | null {
      const el = node.closest('.page-cell');
      return this.cells.find((cell) => cell.el === el) ?? null;
    }

    /**
     * Dragging without the jank.
     *
     * Every cell rectangle is measured ONCE when the drag starts, and the DOM
     * is not touched until the drop. Re-measuring on each pointer move is
     * what makes a grid of a few hundred thumbnails stutter, because every
     * read forces a fresh layout of the whole grid.
     */
    private wirePointer(): void {
      if (this.mode !== 'organise' && this.mode !== 'merge') return;

      let source: Cell | null = null;
      let rects: DOMRect[] = [];
      let float: HTMLElement | null = null;
      let target = -1;
      let started = false;
      let originX = 0;
      let originY = 0;
      let pointer = -1;

      const clear = () => {
        for (const cell of this.cells) delete cell.el.dataset.drop;
      };

      this.pagesEl.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        const node = event.target as HTMLElement;
        if (node.closest('button')) return;

        source = this.cellOf(node);
        if (!source) return;
        originX = event.clientX;
        originY = event.clientY;
        started = false;
        pointer = event.pointerId;
        // Capture is taken when a DRAG begins, not here. Capturing on
        // pointerdown stops the browser synthesising the click and dblclick
        // that follow, which silently cost the grid its double-click-to-view.
      });

      this.pagesEl.addEventListener('pointermove', (event) => {
        if (!source) return;

        if (!started) {
          // A few pixels of slop, so a click stays a click.
          if (Math.hypot(event.clientX - originX, event.clientY - originY) < 5) return;
          started = true;
          if (pointer >= 0) this.pagesEl.setPointerCapture(pointer);
          rects = this.cells.map((cell) => cell.el.getBoundingClientRect());
          source.el.dataset.dragging = 'true';

          float = document.createElement('div');
          float.className = 'page-grid__float';
          const copy = source.canvas
            ? (source.canvas.cloneNode(false) as HTMLCanvasElement)
            : null;
          if (copy && source.canvas) {
            copy.width = source.canvas.width;
            copy.height = source.canvas.height;
            copy.getContext('2d')?.drawImage(source.canvas, 0, 0);
            float.append(copy);
          } else {
            float.textContent = String(source.page);
          }
          document.body.append(float);
        }

        if (float) {
          float.style.left = `${event.clientX - 60}px`;
          float.style.top = `${event.clientY - 40}px`;
        }

        clear();
        target = this.nearestGap(rects, event.clientX, event.clientY);
        const marker = this.cells[Math.min(target, this.cells.length - 1)];
        if (marker) {
          marker.el.dataset.drop = target >= this.cells.length ? 'after' : 'before';
        }

        // Keep scrolling while the pointer sits near an edge.
        const box = this.pagesEl.getBoundingClientRect();
        if (event.clientY < box.top + 48) this.pagesEl.scrollTop -= 12;
        else if (event.clientY > box.bottom - 48) this.pagesEl.scrollTop += 12;
      });

      const finish = () => {
        if (!source) return;
        const dragged = source;
        source = null;
        if (pointer >= 0 && this.pagesEl.hasPointerCapture(pointer)) {
          this.pagesEl.releasePointerCapture(pointer);
        }
        pointer = -1;

        delete dragged.el.dataset.dragging;
        float?.remove();
        float = null;
        clear();

        if (!started || target < 0) return;
        started = false;

        this.suppressClick = true;
        const from = this.cells.indexOf(dragged);
        let to = target;
        if (to > from) to -= 1;
        if (to === from) return;

        this.commit();
        this.cells.splice(from, 1);
        this.cells.splice(to, 0, dragged);
        this.reflow();
        this.refresh();
      };

      this.pagesEl.addEventListener('pointerup', finish);
      this.pagesEl.addEventListener('pointercancel', finish);
    }

    /** Which gap between cells the pointer is closest to. */
    private nearestGap(rects: DOMRect[], x: number, y: number): number {
      let best = rects.length;
      let bestDistance = Number.POSITIVE_INFINITY;

      rects.forEach((rect, index) => {
        for (const [edge, gap] of [
          [rect.left, index],
          [rect.right, index + 1],
        ] as const) {
          const dy = Math.max(rect.top - y, 0, y - rect.bottom);
          const distance = Math.hypot(edge - x, dy);
          if (distance < bestDistance) {
            bestDistance = distance;
            best = gap;
          }
        }
      });

      return best;
    }

    private wireKeyboard(): void {
      this.addEventListener('keydown', (event) => {
        const key = event.key;

        if ((event.metaKey || event.ctrlKey) && key.toLowerCase() === 'z') {
          event.preventDefault();
          if (event.shiftKey) this.redo();
          else this.undo();
          return;
        }

        const cell = this.cellOf(event.target as HTMLElement);
        if (!cell) return;
        const index = this.cells.indexOf(cell);

        const focus = (at: number) => {
          const next = this.cells[Math.max(0, Math.min(at, this.cells.length - 1))];
          next?.el.focus();
        };

        const columns = Math.max(
          1,
          Math.round(this.pagesEl.clientWidth / Math.max(cell.el.offsetWidth, 1))
        );

        if (key === 'ArrowRight') { event.preventDefault(); focus(index + 1); }
        else if (key === 'ArrowLeft') { event.preventDefault(); focus(index - 1); }
        else if (key === 'ArrowDown') { event.preventDefault(); focus(index + columns); }
        else if (key === 'ArrowUp') { event.preventDefault(); focus(index - columns); }
        else if (key === 'Home') { event.preventDefault(); focus(0); }
        else if (key === 'End') { event.preventDefault(); focus(this.cells.length - 1); }
        else if (key === 'r' || key === 'R') {
          event.preventDefault();
          if (this.mode !== 'delete' && this.mode !== 'extract' && this.mode !== 'split') {
            this.turn(cell, event.shiftKey ? -90 : 90);
          }
        } else if (key === 'v' || key === 'V') {
          event.preventDefault();
          void this.showPage(cell);
        } else if (key === 'Delete' || key === 'Backspace') {
          event.preventDefault();
          this.toggleRemoved(cell);
        } else if (key === ' ' || key === 'Enter') {
          event.preventDefault();
          if (this.mode === 'delete' || this.mode === 'extract') this.toggleRemoved(cell);
          else if (this.mode === 'rotate') this.turn(cell, 90);
          else if (this.mode === 'split') {
            this.commit();
            if (this.cuts.has(index)) this.cuts.delete(index);
            else this.cuts.add(index);
            this.refresh();
          }
        } else if ((key === '[' || key === ']') && (this.mode === 'organise' || this.mode === 'merge')) {
          event.preventDefault();
          const to = key === '[' ? index - 1 : index + 1;
          if (to < 0 || to >= this.cells.length) return;
          this.commit();
          this.cells.splice(index, 1);
          this.cells.splice(to, 0, cell);
          this.reflow();
          this.refresh();
          cell.el.focus();
        }
      });
    }

    // ── teardown ──────────────────────────────────────────────────────

    private teardown(): void {
      this.observer?.disconnect();
      this.observer = null;
      this.pending.clear();
      if (this.flushTimer) window.clearTimeout(this.flushTimer);
      this.flushTimer = 0;
      this.recent = [];
      this.cells = [];
      this.cuts.clear();
      this.undoStack = [];
      this.redoStack = [];
      this.pagesEl.replaceChildren();
    }

    /** Called by the tool before a new file loads, and when one is cleared. */
    async release(): Promise<void> {
      this.teardown();
      this.hidden = true;
      if (!this.sessionOpen || !this.host) return;

      // Ask the worker to drop the parsed documents before the host moves on
      // to a new session id, or they stay resident with nothing pointing here.
      this.sessionOpen = false;
      await this.host.request({ session: 'close' }).catch(() => undefined);
    }
  }

  customElements.define('page-grid', PageGridElement);
</script>
