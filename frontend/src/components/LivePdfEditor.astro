---
/**
 * The shared page workspace used by PDF-input tools.
 *
 * It is deliberately a custom element rather than a framework island: the
 * page shell stays static, pdf.js loads only after a file is chosen, and the
 * element exposes a tiny `open / release / getEdits` contract to PdfTool.
 */
---

<live-pdf-editor class="editor" data-live-pdf-editor hidden>
  <header class="editor__topbar">
    <div>
      <p class="editor__eyebrow">Live document workspace</p>
      <h2>Edit the page before you export</h2>
    </div>
    <span class="editor__privacy">Local preview · edits stay in this tab</span>
  </header>

  <div class="editor__shell">
    <nav class="editor__tools" aria-label="Page editing tools">
      <div class="editor__tool-rail-label">TOOLS</div>
      <button class="editor__tool-primary" type="button" data-editor-tool="select" aria-pressed="true" title="Select and move">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 3 12.5 9.2-6.1 1.2-3.2 5.4L5 3Z"></path></svg>
        <span>Select</span>
      </button>
      <button class="editor__tool-primary" type="button" data-editor-tool="pan" aria-pressed="false" title="Pan around the page">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 11V6a1.5 1.5 0 0 1 3 0v5-6a1.5 1.5 0 0 1 3 0v6-5a1.5 1.5 0 0 1 3 0v7.5c0 3.6-2.5 5.5-5.6 5.5H11c-2.8 0-4.8-1.8-5.5-4.4L5 13a1.5 1.5 0 0 1 3-.4V11Z"></path></svg>
        <span>Pan</span>
      </button>

      <span class="editor__tool-rule"></span>

      <div class="editor__tool-group">
        <button class="editor__tool-menu" type="button" data-editor-menu-trigger="comment" aria-expanded="false" aria-controls="editor-menu-comment" title="Comments and text tools">
          <span class="editor__tool-icon editor__tool-icon--comment" aria-hidden="true">⌁</span>
          <span>Comment</span><span class="editor__tool-chevron" aria-hidden="true">⌄</span>
        </button>
        <div class="editor__popover" id="editor-menu-comment" data-editor-menu="comment" hidden>
          <div class="editor__popover-heading"><strong>Comment</strong><span>Add context to the page</span></div>
          <button type="button" data-editor-action="comment" data-editor-tool="text"><span class="editor__menu-icon">◌</span><span><strong>Comment</strong><small>Place a visible note</small></span></button>
          <button type="button" data-editor-action="replace" data-editor-tool="rectangle"><span class="editor__menu-icon">↺</span><span><strong>Replace text area</strong><small>Cover text, then place replacement text</small></span></button>
          <button type="button" data-editor-action="insert-text" data-editor-tool="text"><span class="editor__menu-icon">T</span><span><strong>Insert text</strong><small>Type on the page</small></span></button>
          <button type="button" data-editor-action="text-comment" data-editor-tool="text"><span class="editor__menu-icon">☷</span><span><strong>Text comment</strong><small>Place a visible review note</small></span></button>
        </div>
      </div>

      <div class="editor__tool-group">
        <button class="editor__tool-menu" type="button" data-editor-menu-trigger="markup" aria-expanded="false" aria-controls="editor-menu-markup" title="Markup tools">
          <span class="editor__tool-icon editor__tool-icon--markup" aria-hidden="true">▰</span>
          <span>Markup</span><span class="editor__tool-chevron" aria-hidden="true">⌄</span>
        </button>
        <div class="editor__popover" id="editor-menu-markup" data-editor-menu="markup" hidden>
          <div class="editor__popover-heading"><strong>Markup</strong><span>Call attention to content</span></div>
          <button type="button" data-editor-action="highlight" data-editor-tool="highlight"><span class="editor__menu-icon editor__menu-icon--yellow">▰</span><span><strong>Highlight</strong><small>Emphasise an area</small></span></button>
          <button type="button" data-editor-action="underline" data-editor-tool="highlight"><span class="editor__menu-icon">U̲</span><span><strong>Underline</strong><small>Draw a clean underline</small></span></button>
          <button type="button" data-editor-action="strike" data-editor-tool="highlight"><span class="editor__menu-icon">S̶</span><span><strong>Strike through</strong><small>Mark content for removal</small></span></button>
        </div>
      </div>

      <div class="editor__tool-group">
        <button class="editor__tool-menu" type="button" data-editor-menu-trigger="draw" aria-expanded="false" aria-controls="editor-menu-draw" title="Drawing tools">
          <span class="editor__tool-icon editor__tool-icon--draw" aria-hidden="true">⌁</span>
          <span>Draw</span><span class="editor__tool-chevron" aria-hidden="true">⌄</span>
        </button>
        <div class="editor__popover" id="editor-menu-draw" data-editor-menu="draw" hidden>
          <div class="editor__popover-heading"><strong>Draw</strong><span>Build a simple shape</span></div>
          <button type="button" data-editor-action="ink" data-editor-tool="ink"><span class="editor__menu-icon">〰</span><span><strong>Free draw</strong><small>Pen, mouse, or touch</small></span></button>
          <button type="button" data-editor-action="line" data-editor-tool="line"><span class="editor__menu-icon">╱</span><span><strong>Line</strong><small>Draw a straight line</small></span></button>
          <button type="button" data-editor-action="arrow" data-editor-tool="arrow"><span class="editor__menu-icon">↗</span><span><strong>Arrow</strong><small>Point to a detail</small></span></button>
          <button type="button" data-editor-action="rectangle" data-editor-tool="rectangle"><span class="editor__menu-icon">□</span><span><strong>Rectangle</strong><small>Outline an area</small></span></button>
          <button type="button" data-editor-action="circle" data-editor-tool="rectangle"><span class="editor__menu-icon">○</span><span><strong>Circle</strong><small>Outline an area</small></span></button>
          <button type="button" data-editor-action="callout" data-editor-tool="callout"><span class="editor__menu-icon">⌑</span><span><strong>Callout</strong><small>Draw a pointer and box</small></span></button>
          <button type="button" data-editor-action="polygon" data-editor-tool="rectangle"><span class="editor__menu-icon">⬡</span><span><strong>Polygon</strong><small>Draw a six-sided outline</small></span></button>
          <button type="button" data-editor-action="cloud" data-editor-tool="rectangle"><span class="editor__menu-icon">☁</span><span><strong>Cloud</strong><small>Outline a revision area</small></span></button>
        </div>
      </div>

      <div class="editor__tool-group">
        <button class="editor__tool-menu" type="button" data-editor-menu-trigger="stamp" aria-expanded="false" aria-controls="editor-menu-stamp" title="Text and stamp tools">
          <span class="editor__tool-icon editor__tool-icon--stamp" aria-hidden="true">T·</span>
          <span>Stamp</span><span class="editor__tool-chevron" aria-hidden="true">⌄</span>
        </button>
        <div class="editor__popover" id="editor-menu-stamp" data-editor-menu="stamp" hidden>
          <div class="editor__popover-heading"><strong>Text &amp; stamps</strong><span>Place a quick response</span></div>
          <button type="button" data-editor-action="text" data-editor-tool="text"><span class="editor__menu-icon">T</span><span><strong>Type text</strong><small>Place editable text</small></span></button>
          <button type="button" data-editor-action="check" data-editor-tool="stamp"><span class="editor__menu-icon editor__menu-icon--ok">✓</span><span><strong>Check</strong><small>Positive response</small></span></button>
          <button type="button" data-editor-action="cross" data-editor-tool="stamp"><span class="editor__menu-icon editor__menu-icon--bad">×</span><span><strong>Cross</strong><small>Negative response</small></span></button>
          <button type="button" data-editor-action="dot" data-editor-tool="stamp"><span class="editor__menu-icon">•</span><span><strong>Dot</strong><small>Mark a location</small></span></button>
          <button type="button" data-editor-action="circle-stamp" data-editor-tool="stamp"><span class="editor__menu-icon">○</span><span><strong>Circle</strong><small>Circle response</small></span></button>
          <button type="button" data-editor-action="crossout" data-editor-tool="stamp"><span class="editor__menu-icon">╳</span><span><strong>Crossout</strong><small>Mark for removal</small></span></button>
        </div>
      </div>

      <div class="editor__tool-group">
        <button class="editor__tool-menu" type="button" data-editor-signature-trigger aria-expanded="false" aria-controls="editor-signature-panel" title="Signature palette">
          <span class="editor__tool-icon editor__tool-icon--signature" aria-hidden="true">✎</span>
          <span>Sign</span><span class="editor__tool-chevron" aria-hidden="true">⌄</span>
        </button>
        <div class="editor__popover editor__signature-panel" id="editor-signature-panel" hidden>
          <div class="editor__popover-heading"><strong>Sign the page</strong><span>Placed locally in this PDF</span></div>
          <label class="editor__signature-input">
            <span>Name or initials</span>
            <input data-editor-signature-text maxlength="64" autocomplete="off" placeholder="Type your own mark" />
          </label>
          <button type="button" data-editor-signature-kind="signature"><span class="editor__signature-glyph">Signature</span><span><strong>Place signature</strong><small>Handwriting-style text</small></span></button>
          <button type="button" data-editor-signature-kind="initials"><span class="editor__signature-glyph editor__signature-glyph--initials">IN</span><span><strong>Place initials</strong><small>Compact review mark</small></span></button>
          <a class="editor__signature-link" href="/ProjectPDF/sign-pdf/">Need to draw it? Open Sign PDF →</a>
          <p class="editor__signature-note">Nothing is saved to an account. The mark is included only when you export.</p>
        </div>
      </div>

      <span class="editor__tool-rule"></span>
      <button class="editor__tool-secondary" type="button" data-editor-tool="whiteout" aria-pressed="false" title="Cover an area in white">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 15 8-9 6 5-8 9H5v-5Z"></path><path d="M13 6l6 5"></path></svg>
        <span>Whiteout</span>
      </button>
      <button class="editor__tool-secondary" type="button" data-editor-undo title="Undo last edit" disabled>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 8 5 12l4 4"></path><path d="M5 12h8a6 6 0 0 1 6 6"></path></svg>
        <span>Undo</span>
      </button>
      <button class="editor__tool-secondary" type="button" data-editor-delete title="Delete selected edit" disabled>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14M9 7V4h6v3M8 10v8M12 10v8M16 10v8M7 7l1 14h8l1-14"></path></svg>
        <span>Delete</span>
      </button>
      <p class="editor__tool-footnote">Choose a tool, then place it on the page.</p>
    </nav>

    <aside class="editor__pages" aria-label="Document pages">
      <div class="editor__pages-head">
        <span>Pages</span>
        <span data-editor-page-total></span>
      </div>
      <div class="editor__thumbs" data-editor-thumbs></div>
    </aside>

    <section class="editor__workarea">
      <div class="editor__viewbar">
        <div class="editor__pager" aria-label="Page navigation">
          <button type="button" data-editor-prev aria-label="Previous page">←</button>
          <span>Page <strong data-editor-page>1</strong> / <span data-editor-pages>1</span></span>
          <button type="button" data-editor-next aria-label="Next page">→</button>
        </div>
        <div class="editor__zoom" aria-label="Preview zoom">
          <button type="button" data-editor-zoom-out aria-label="Zoom out">−</button>
          <span data-editor-zoom>100%</span>
          <button type="button" data-editor-zoom-in aria-label="Zoom in">+</button>
        </div>
      </div>

      <div class="editor__viewport" data-editor-viewport>
        <div class="editor__page" data-editor-page-stage>
          <canvas data-editor-canvas></canvas>
          <svg data-editor-overlay viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-label="Editable page layer"></svg>
        </div>
        <p class="editor__loading" data-editor-loading>Choose a PDF to open the workspace.</p>
      </div>

      <div class="editor__properties">
        <label data-editor-text-control>
          <span>Text</span>
          <input data-editor-text value="Add your text" maxlength="160" />
        </label>
        <label>
          <span>Colour</span>
          <input data-editor-color type="color" value="#e11d48" />
        </label>
        <label data-editor-size-control>
          <span>Size</span>
          <select data-editor-size>
            <option value="10">10 pt</option>
            <option value="12">12 pt</option>
            <option value="16" selected>16 pt</option>
            <option value="22">22 pt</option>
            <option value="30">30 pt</option>
          </select>
        </label>
        <label data-editor-width-control hidden>
          <span>Stroke</span>
          <select data-editor-width>
            <option value="1">Fine</option>
            <option value="2" selected>Regular</option>
            <option value="4">Bold</option>
          </select>
        </label>
        <p data-editor-hint>Click an edit to select it. Drag selected text to reposition it.</p>
        <p class="editor__feedback" data-editor-feedback role="status" aria-live="polite"></p>
      </div>
    </section>
  </div>

  <footer class="editor__footer">
    <span data-editor-count>No quick edits yet</span>
    <span>Undo: <kbd>Ctrl</kbd> + <kbd>Z</kbd> · Delete selected: <kbd>Delete</kbd></span>
  </footer>
</live-pdf-editor>

<script>
  import { documentOptions, loadPdfjs, type PdfjsApi } from '../lib/pdf/pdfjs';
  import type { EditMark } from '../lib/pdf/types';

  type PdfDocument = Awaited<ReturnType<PdfjsApi['getDocument']>['promise']>;
  type Tool = 'select' | 'pan' | 'text' | 'highlight' | 'ink' | 'rectangle' | 'whiteout' | 'line' | 'arrow' | 'callout' | 'stamp' | 'signature';
  type BoxMark = Extract<EditMark, { kind: 'highlight' | 'rectangle' | 'whiteout' }>;
  type InkMark = Extract<EditMark, { kind: 'ink' }>;
  type MarkStyle = 'highlight' | 'underline' | 'strike' | 'strike-through' | 'rectangle' | 'circle' | 'line' | 'arrow' | 'callout' | 'polygon' | 'cloud' | 'replace' | 'ink';
  type StampKind = 'check' | 'cross' | 'dot' | 'circle-stamp' | 'crossout';

  interface ToolGuide {
    kind: 'none' | 'watermark' | 'page-number';
    text?: string;
    start?: number;
  }

  class LivePdfEditorElement extends HTMLElement {
    private doc: PdfDocument | null = null;
    private marks: EditMark[] = [];
    private history: EditMark[][] = [];
    private tool: Tool = 'select';
    private activePage = 1;
    private selectedId = '';
    private zoom = 1;
    private renderToken = 0;
    private thumbObserver: IntersectionObserver | null = null;
    private guide: ToolGuide = { kind: 'none' };
    private dragStart: { x: number; y: number } | null = null;
    private draft: BoxMark | InkMark | null = null;
    private moving: { id: string; x: number; y: number; originX: number; originY: number } | null = null;
    private markStyles = new Map<string, MarkStyle>();
    private markupStyle: MarkStyle = 'highlight';
    private stampKind: StampKind = 'check';
    private replaceMode = false;
    private signatureStyle: 'signature' | 'initials' = 'signature';

    private canvas = this.querySelector<HTMLCanvasElement>('[data-editor-canvas]')!;
    private overlay = this.querySelector<SVGSVGElement>('[data-editor-overlay]')!;
    private pageStage = this.querySelector<HTMLElement>('[data-editor-page-stage]')!;
    private viewport = this.querySelector<HTMLElement>('[data-editor-viewport]')!;
    private loading = this.querySelector<HTMLElement>('[data-editor-loading]')!;
    private thumbs = this.querySelector<HTMLElement>('[data-editor-thumbs]')!;
    private feedback = this.querySelector<HTMLElement>('[data-editor-feedback]')!;

    connectedCallback() {
      this.querySelectorAll<HTMLButtonElement>('[data-editor-tool]').forEach((button) => {
        button.addEventListener('click', () => this.setTool(button.dataset.editorTool as Tool));
      });
      this.querySelectorAll<HTMLButtonElement>('[data-editor-menu-trigger]').forEach((button) => {
        button.addEventListener('click', () => this.toggleMenu(button.dataset.editorMenuTrigger ?? ''));
      });
      this.querySelector<HTMLButtonElement>('[data-editor-signature-trigger]')?.addEventListener('click', () => this.toggleMenu('signature'));
      this.querySelectorAll<HTMLButtonElement>('[data-editor-action]').forEach((button) => {
        button.addEventListener('click', () => this.chooseAction(button.dataset.editorAction ?? ''));
      });
      this.querySelectorAll<HTMLButtonElement>('[data-editor-signature-kind]').forEach((button) => {
        button.addEventListener('click', () => {
          const value = this.querySelector<HTMLInputElement>('[data-editor-signature-text]')?.value.trim() ?? '';
          if (!value) {
            this.setFeedback('Type your name or initials first.');
            this.querySelector<HTMLInputElement>('[data-editor-signature-text]')?.focus();
            return;
          }
          this.signatureStyle = button.dataset.editorSignatureKind === 'initials' ? 'initials' : 'signature';
          this.setTool('signature');
          this.setFeedback(`Click the page to place your ${this.signatureStyle}.`);
        });
      });
      this.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        if (!target.closest('[data-editor-menu-trigger], [data-editor-signature-trigger], [data-editor-menu], #editor-signature-panel')) this.closeMenus();
      });

      this.querySelector<HTMLButtonElement>('[data-editor-prev]')?.addEventListener('click', () => void this.setPage(this.activePage - 1));
      this.querySelector<HTMLButtonElement>('[data-editor-next]')?.addEventListener('click', () => void this.setPage(this.activePage + 1));
      this.querySelector<HTMLButtonElement>('[data-editor-zoom-out]')?.addEventListener('click', () => this.setZoom(this.zoom - 0.15));
      this.querySelector<HTMLButtonElement>('[data-editor-zoom-in]')?.addEventListener('click', () => this.setZoom(this.zoom + 0.15));
      this.querySelector<HTMLButtonElement>('[data-editor-undo]')?.addEventListener('click', () => this.undo());
      this.querySelector<HTMLButtonElement>('[data-editor-delete]')?.addEventListener('click', () => this.deleteSelected());

      this.overlay.addEventListener('pointerdown', (event) => this.pointerDown(event));
      this.overlay.addEventListener('pointermove', (event) => this.pointerMove(event));
      this.overlay.addEventListener('pointerup', (event) => this.pointerUp(event));
      this.overlay.addEventListener('pointercancel', () => this.cancelPointer());

      this.addEventListener('keydown', (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'z') {
          event.preventDefault();
          this.undo();
        } else if ((event.key === 'Delete' || event.key === 'Backspace') && this.selectedId) {
          const target = event.target as HTMLElement;
          if (!target.matches('input, textarea, select')) {
            event.preventDefault();
            this.deleteSelected();
          }
        }
      });

      this.setTool('select');
    }

    async open(file: File): Promise<void> {
      await this.release();
      this.hidden = false;
      this.loading.hidden = false;
      this.loading.textContent = 'Opening the document locally…';
      this.marks = [];
      this.history = [];
      this.selectedId = '';
      this.markStyles.clear();
      this.activePage = 1;
      this.refreshState();

      try {
        const api = await loadPdfjs();
        this.doc = await api.getDocument({
          data: new Uint8Array(await file.arrayBuffer()),
          ...documentOptions(),
        }).promise;
        this.buildThumbs();
        await this.renderPage();
      } catch (error) {
        this.loading.hidden = false;
        this.loading.textContent = `Preview unavailable: ${(error as Error).message}. You can still run the tool.`;
        this.pageStage.hidden = true;
      }
    }

    async release(): Promise<void> {
      this.renderToken += 1;
      this.thumbObserver?.disconnect();
      this.thumbObserver = null;
      this.thumbs.replaceChildren();
      this.canvas.width = 0;
      this.canvas.height = 0;
      this.overlay.replaceChildren();
      this.pageStage.hidden = true;
      if (this.doc) await this.doc.destroy().catch(() => undefined);
      this.doc = null;
      this.hidden = true;
    }

    getEdits(): EditMark[] {
      return structuredClone(this.marks);
    }

    setToolPreview(guide: ToolGuide): void {
      this.guide = guide;
      this.renderMarks();
    }

    private buildThumbs(): void {
      if (!this.doc) return;
      const total = this.doc.numPages;
      this.querySelector<HTMLElement>('[data-editor-page-total]')!.textContent = String(total);
      this.querySelector<HTMLElement>('[data-editor-pages]')!.textContent = String(total);

      const frag = document.createDocumentFragment();
      for (let page = 1; page <= total; page += 1) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'editor-thumb';
        button.dataset.page = String(page);
        button.setAttribute('aria-label', `Open page ${page}`);
        const canvas = document.createElement('canvas');
        const label = document.createElement('span');
        label.textContent = String(page);
        button.append(canvas, label);
        button.addEventListener('click', () => void this.setPage(page));
        frag.append(button);
      }
      this.thumbs.replaceChildren(frag);

      this.thumbObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const button = entry.target as HTMLButtonElement;
          this.thumbObserver?.unobserve(button);
          void this.renderThumb(button);
        }
      }, { root: this.thumbs, rootMargin: '120px' });

      this.thumbs.querySelectorAll<HTMLButtonElement>('.editor-thumb').forEach((button) => this.thumbObserver?.observe(button));
      this.markActiveThumb();
    }

    private async renderThumb(button: HTMLButtonElement): Promise<void> {
      if (!this.doc) return;
      const pageNumber = Number(button.dataset.page);
      const page = await this.doc.getPage(pageNumber);
      const viewport = page.getViewport({ scale: 0.22 });
      const canvas = button.querySelector('canvas')!;
      canvas.width = Math.max(1, Math.floor(viewport.width));
      canvas.height = Math.max(1, Math.floor(viewport.height));
      const context = canvas.getContext('2d');
      if (context) await page.render({ canvasContext: context, viewport, canvas }).promise;
      page.cleanup();
    }

    private async setPage(page: number): Promise<void> {
      if (!this.doc) return;
      const next = Math.max(1, Math.min(page, this.doc.numPages));
      if (next === this.activePage && !this.pageStage.hidden) return;
      this.activePage = next;
      this.selectedId = '';
      this.markActiveThumb();
      await this.renderPage();
    }

    private markActiveThumb(): void {
      this.querySelector<HTMLElement>('[data-editor-page]')!.textContent = String(this.activePage);
      this.thumbs.querySelectorAll<HTMLButtonElement>('.editor-thumb').forEach((button) => {
        button.setAttribute('aria-current', String(Number(button.dataset.page) === this.activePage));
      });
      const active = this.thumbs.querySelector<HTMLElement>(`.editor-thumb[data-page="${this.activePage}"]`);
      active?.scrollIntoView({ block: 'nearest' });
      const total = this.doc?.numPages ?? 1;
      const prev = this.querySelector<HTMLButtonElement>('[data-editor-prev]')!;
      const next = this.querySelector<HTMLButtonElement>('[data-editor-next]')!;
      prev.disabled = this.activePage <= 1;
      next.disabled = this.activePage >= total;
    }

    private async renderPage(): Promise<void> {
      if (!this.doc) return;
      const token = ++this.renderToken;
      this.loading.hidden = false;
      this.loading.textContent = `Rendering page ${this.activePage}…`;
      this.pageStage.hidden = true;

      const page = await this.doc.getPage(this.activePage);
      const viewport = page.getViewport({ scale: 1.35 });
      if (token !== this.renderToken) return;
      this.canvas.width = Math.max(1, Math.floor(viewport.width));
      this.canvas.height = Math.max(1, Math.floor(viewport.height));
      const context = this.canvas.getContext('2d');
      if (!context) return;
      await page.render({ canvasContext: context, viewport, canvas: this.canvas }).promise;
      page.cleanup();
      if (token !== this.renderToken) return;

      this.pageStage.dataset.pageWidth = String(viewport.width / 1.35);
      this.pageStage.dataset.pageHeight = String(viewport.height / 1.35);
      this.pageStage.hidden = false;
      this.loading.hidden = true;
      this.applyZoom();
      this.renderMarks();
    }

    private setZoom(value: number): void {
      this.zoom = Math.max(0.55, Math.min(1.75, Math.round(value * 20) / 20));
      this.applyZoom();
    }

    private toggleMenu(name: string): void {
      const panel = name === 'signature'
        ? this.querySelector<HTMLElement>('#editor-signature-panel')
        : this.querySelector<HTMLElement>(`[data-editor-menu="${name}"]`);
      if (!panel) return;
      const wasOpen = !panel.hidden;
      this.closeMenus();
      if (!wasOpen) {
        panel.hidden = false;
        const trigger = name === 'signature'
          ? this.querySelector<HTMLButtonElement>('[data-editor-signature-trigger]')
          : this.querySelector<HTMLButtonElement>(`[data-editor-menu-trigger="${name}"]`);
        trigger?.setAttribute('aria-expanded', 'true');
      }
    }

    private closeMenus(): void {
      this.querySelectorAll<HTMLElement>('[data-editor-menu], #editor-signature-panel').forEach((panel) => { panel.hidden = true; });
      this.querySelectorAll<HTMLButtonElement>('[data-editor-menu-trigger], [data-editor-signature-trigger]').forEach((button) => button.setAttribute('aria-expanded', 'false'));
    }

    private setFeedback(message: string): void {
      this.feedback.textContent = message;
      window.setTimeout(() => {
        if (this.feedback.textContent === message) this.feedback.textContent = '';
      }, 4500);
    }

    private chooseAction(action: string): void {
      this.closeMenus();
      const textInput = this.querySelector<HTMLInputElement>('[data-editor-text]')!;
      if (action !== 'replace') this.replaceMode = false;
      switch (action) {
        case 'comment':
          textInput.value = 'Comment: ';
          this.setTool('text');
          this.setFeedback('Comment preview: place a visible note on the page.');
          break;
        case 'replace':
          this.replaceMode = true;
          this.markStyles.set('__draft__', 'replace');
          this.setTool('rectangle');
          this.setFeedback('Enter replacement text, then drag over the text area. The original is visually covered; this is not secure redaction.');
          break;
        case 'insert-text':
        case 'text-comment':
        case 'text':
          if (action === 'text-comment') textInput.value = 'Comment: ';
          this.setTool('text');
          this.setFeedback('Type your text below, then click on the page.');
          break;
        case 'highlight':
          this.markupStyle = 'highlight';
          this.setTool('highlight');
          break;
        case 'underline':
        case 'strike':
          this.markupStyle = action as 'underline' | 'strike';
          this.setTool('highlight');
          this.setFeedback(`${action === 'underline' ? 'Underline' : 'Strike through'} selected. Drag across the content to mark it.`);
          break;
        case 'circle':
          this.markStyles.set('__draft__', 'circle');
          this.setTool('rectangle');
          this.setFeedback('Circle selected. Drag around the content to mark it.');
          break;
        case 'polygon':
        case 'cloud':
          this.markStyles.set('__draft__', action);
          this.setTool('rectangle');
          this.setFeedback(`${action === 'cloud' ? 'Cloud' : 'Polygon'} selected. Drag around the revision area.`);
          break;
        case 'callout':
          this.setTool('callout');
          this.setFeedback('Callout selected. Drag to draw a pointer and box.');
          break;
        case 'line':
        case 'arrow':
          this.setTool(action as Tool);
          break;
        case 'ink':
          this.setTool('ink');
          break;
        case 'rectangle':
          this.markStyles.delete('__draft__');
          this.setTool('rectangle');
          break;
        case 'check':
        case 'cross':
        case 'dot':
        case 'circle-stamp':
        case 'crossout':
          this.stampKind = action as StampKind;
          this.setTool('stamp');
          this.setFeedback(`${action === 'circle-stamp' ? 'Circle' : action[0].toUpperCase() + action.slice(1)} stamp selected. Click on the page to place it.`);
          break;
      }
    }

    private applyZoom(): void {
      const width = this.canvas.width * this.zoom;
      const height = this.canvas.height * this.zoom;
      this.pageStage.style.width = `${width}px`;
      this.pageStage.style.height = `${height}px`;
      this.querySelector<HTMLElement>('[data-editor-zoom]')!.textContent = `${Math.round(this.zoom * 100)}%`;
    }

    private setTool(tool: Tool): void {
      this.tool = tool;
      this.selectedId = '';
      if (tool !== 'rectangle') {
        this.markStyles.delete('__draft__');
        this.replaceMode = false;
      }
      this.closeMenus();
      this.querySelectorAll<HTMLButtonElement>('[data-editor-tool]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.editorTool === tool));
      });
      this.overlay.dataset.tool = tool;
      this.querySelector<HTMLElement>('[data-editor-text-control]')!.hidden = !(['text', 'stamp'].includes(tool) || this.replaceMode);
      this.querySelector<HTMLElement>('[data-editor-size-control]')!.hidden = !(['text', 'stamp'].includes(tool) || this.replaceMode);
      this.querySelector<HTMLElement>('[data-editor-width-control]')!.hidden = !['ink', 'rectangle', 'line', 'arrow', 'callout'].includes(tool);
      const hints: Record<Tool, string> = {
        select: 'Click an edit to select it. Drag selected text to reposition it.',
        pan: 'Drag the page to move around the workspace.',
        text: 'Type the text below, then click where it should appear.',
        stamp: 'Choose a stamp, then click where it should appear.',
        highlight: 'Drag over the area you want to highlight.',
        ink: 'Draw directly on the page with a mouse, pen, or finger.',
        line: 'Drag to draw a straight line.',
        arrow: 'Drag to draw an arrow.',
        callout: 'Drag to draw a callout pointer.',
        rectangle: this.replaceMode ? 'Enter replacement text below, then drag over the original text.' : 'Drag to draw an outline around an area.',
        signature: `Click where your ${this.signatureStyle} should appear.`,
        whiteout: 'Drag over an area to cover it with white. This is not secure redaction.',
      };
      this.querySelector<HTMLElement>('[data-editor-hint]')!.textContent = hints[tool];
      this.renderMarks();
    }

    private point(event: PointerEvent): { x: number; y: number } {
      const bounds = this.overlay.getBoundingClientRect();
      return {
        x: Math.max(0, Math.min(1, (event.clientX - bounds.left) / bounds.width)),
        y: Math.max(0, Math.min(1, (event.clientY - bounds.top) / bounds.height)),
      };
    }

    private pointerDown(event: PointerEvent): void {
      if (!this.doc || this.pageStage.hidden) return;
      const target = event.target as SVGElement;
      const id = target.closest<SVGElement>('[data-mark-id]')?.dataset.markId ?? '';
      const at = this.point(event);

      if (this.tool === 'pan') {
        this.viewport.dataset.panning = 'true';
        this.overlay.setPointerCapture(event.pointerId);
        this.dragStart = { x: event.clientX, y: event.clientY };
        return;
      }

      if (this.tool === 'select') {
        this.selectedId = id;
        const mark = this.marks.find((item) => item.id === id);
        if (mark?.kind === 'text') {
          this.moving = { id, x: at.x, y: at.y, originX: mark.x, originY: mark.y };
          this.overlay.setPointerCapture(event.pointerId);
        }
        this.refreshState();
        this.renderMarks();
        return;
      }

      this.snapshot();
      const color = this.querySelector<HTMLInputElement>('[data-editor-color]')!.value;
      const strokeWidth = Number(this.querySelector<HTMLSelectElement>('[data-editor-width]')!.value);
      const idValue = crypto.randomUUID();

      if (this.tool === 'stamp') {
        const stampMap: Record<StampKind, string> = {
          check: 'check', cross: 'cross', dot: 'dot', 'circle-stamp': 'circle', crossout: 'crossout',
        };
        this.marks.push({ id: idValue, kind: 'stamp', page: this.activePage, x: at.x, y: at.y, width: 0.055, height: 0.055, color, strokeWidth, stamp: stampMap[this.stampKind] } as EditMark);
        this.markStyles.set(idValue, 'ink');
        this.setTool('select');
        this.selectedId = idValue;
        this.changed();
        return;
      }

      if (this.tool === 'signature') {
        const value = this.querySelector<HTMLInputElement>('[data-editor-signature-text]')?.value.trim() ?? '';
        if (!value) {
          this.history.pop();
          this.setFeedback('Type your name or initials in the Sign menu first.');
          this.setTool('select');
          return;
        }
        const text = this.signatureStyle === 'initials'
          ? value.split(/\s+/).map((part) => part[0] ?? '').join('').slice(0, 4).toUpperCase() || value.slice(0, 4).toUpperCase()
          : value;
        const width = this.signatureStyle === 'initials'
          ? Math.min(0.14, Math.max(0.07, text.length * 0.028))
          : Math.min(0.42, Math.max(0.16, text.length * 0.022));
        this.marks.push({
          id: idValue,
          kind: 'signature-text',
          page: this.activePage,
          x: Math.min(at.x, 1 - width),
          y: Math.min(at.y, 0.92),
          width,
          height: this.signatureStyle === 'initials' ? 0.055 : 0.075,
          text,
          size: this.signatureStyle === 'initials' ? 18 : 22,
          color,
        });
        this.setTool('select');
        this.selectedId = idValue;
        this.changed();
        return;
      }

      if (this.tool === 'text') {
        const text = this.querySelector<HTMLInputElement>('[data-editor-text]')!.value.trim();
        if (!text) {
          this.history.pop();
          this.querySelector<HTMLInputElement>('[data-editor-text]')!.focus();
          return;
        }
        this.marks.push({
          id: idValue,
          kind: 'text',
          page: this.activePage,
          x: at.x,
          y: at.y,
          text,
          size: Number(this.querySelector<HTMLSelectElement>('[data-editor-size]')!.value),
          color,
        });
        if (this.tool === 'stamp') this.markStyles.set(idValue, 'ink');
        this.setTool('select');
        this.selectedId = idValue;
        this.changed();
        return;
      }

      this.dragStart = at;
      this.overlay.setPointerCapture(event.pointerId);
      const drawingStyle: MarkStyle = this.tool === 'line' || this.tool === 'arrow' || this.tool === 'callout'
        ? this.tool
        : this.tool === 'highlight'
          ? this.markupStyle
          : this.tool === 'rectangle' && ['circle', 'polygon', 'cloud', 'replace'].includes(this.markStyles.get('__draft__') ?? '')
            ? this.markStyles.get('__draft__') as MarkStyle
            : this.tool === 'rectangle'
              ? 'rectangle'
              : 'ink';
      this.draft = ['ink', 'line', 'arrow', 'callout'].includes(this.tool)
        ? { id: idValue, kind: 'ink', page: this.activePage, points: [at], color, strokeWidth }
        : {
            id: idValue,
            kind: this.tool === 'highlight' ? 'highlight' : this.tool === 'whiteout' ? 'whiteout' : 'rectangle',
            page: this.activePage,
            x: at.x,
            y: at.y,
            width: 0,
            height: 0,
            color: this.tool === 'highlight' ? '#facc15' : color,
            strokeWidth,
          };
      this.markStyles.set(idValue, drawingStyle);
      this.renderMarks();
    }

    private pointerMove(event: PointerEvent): void {
      if (this.tool === 'pan' && this.dragStart) {
        const dx = this.dragStart.x - event.clientX;
        const dy = this.dragStart.y - event.clientY;
        this.viewport.scrollLeft += dx;
        this.viewport.scrollTop += dy;
        this.dragStart = { x: event.clientX, y: event.clientY };
        return;
      }
      const at = this.point(event);
      if (this.moving) {
        const mark = this.marks.find((item) => item.id === this.moving?.id);
        if (mark?.kind === 'text') {
          mark.x = Math.max(0, Math.min(0.98, this.moving.originX + at.x - this.moving.x));
          mark.y = Math.max(0, Math.min(0.98, this.moving.originY + at.y - this.moving.y));
          this.renderMarks();
        }
        return;
      }
      if (!this.draft || !this.dragStart) return;
      if (this.draft.kind === 'ink') {
        const style = this.markStyles.get(this.draft.id);
        if (style === 'line' || style === 'arrow' || style === 'callout') {
          this.draft.points = [this.dragStart, at];
        } else {
          const last = this.draft.points[this.draft.points.length - 1];
          if (!last || Math.hypot(at.x - last.x, at.y - last.y) > 0.002) this.draft.points.push(at);
        }
      } else {
        this.draft.x = Math.min(this.dragStart.x, at.x);
        this.draft.y = Math.min(this.dragStart.y, at.y);
        this.draft.width = Math.abs(at.x - this.dragStart.x);
        this.draft.height = Math.abs(at.y - this.dragStart.y);
      }
      this.renderMarks();
    }

    private pointerUp(event: PointerEvent): void {
      if (this.tool === 'pan') {
        this.viewport.dataset.panning = 'false';
        this.dragStart = null;
        if (this.overlay.hasPointerCapture(event.pointerId)) this.overlay.releasePointerCapture(event.pointerId);
        return;
      }
      if (this.moving) {
        this.snapshot(this.marks.map((mark) => mark.id === this.moving?.id && mark.kind === 'text'
          ? { ...mark, x: this.moving.originX, y: this.moving.originY }
          : structuredClone(mark)));
        this.moving = null;
        this.changed();
        return;
      }
      if (!this.draft) return;
      const valid = this.draft.kind === 'ink'
        ? this.draft.points.length > 1
        : this.draft.width > 0.006 && this.draft.height > 0.006;
      if (valid) {
        const style = this.markStyles.get(this.draft.id);
        let output: EditMark = this.draft;
        if (this.draft.kind === 'ink' && (style === 'line' || style === 'arrow')) {
          const start = this.draft.points[0]!;
          const end = this.draft.points[this.draft.points.length - 1]!;
          output = { id: this.draft.id, kind: style, page: this.activePage, start, end, color: this.draft.color, strokeWidth: this.draft.strokeWidth } as EditMark;
        } else if (this.draft.kind === 'ink' && style === 'callout') {
          const points = this.draft.points;
          const xs = points.map((point) => point.x);
          const ys = points.map((point) => point.y);
          const x = Math.min(...xs);
          const y = Math.min(...ys);
          const width = Math.max(0.02, Math.max(...xs) - x);
          const height = Math.max(0.02, Math.max(...ys) - y);
          output = { id: this.draft.id, kind: 'callout', page: this.activePage, x, y, width, height, anchor: points[points.length - 1], color: this.draft.color, strokeWidth: this.draft.strokeWidth } as EditMark;
        } else if (this.draft.kind !== 'ink' && style === 'circle') {
          output = { ...this.draft, kind: 'circle' } as EditMark;
        } else if (this.draft.kind !== 'ink' && (style === 'polygon' || style === 'cloud')) {
          const { x, y, width, height } = this.draft;
          output = {
            id: this.draft.id,
            kind: style,
            page: this.activePage,
            points: [
              { x: x + width * 0.5, y }, { x: x + width, y: y + height * 0.28 },
              { x: x + width * 0.82, y: y + height }, { x: x + width * 0.18, y: y + height },
              { x, y: y + height * 0.28 },
            ],
            color: this.draft.color,
            strokeWidth: this.draft.strokeWidth,
          } as EditMark;
        } else if (this.draft.kind !== 'ink' && style === 'replace') {
          const replacement = this.querySelector<HTMLInputElement>('[data-editor-text]')!.value.trim();
          output = {
            ...this.draft,
            kind: 'replace-text',
            text: replacement || 'Replacement text',
            size: Number(this.querySelector<HTMLSelectElement>('[data-editor-size]')!.value),
            backgroundColor: '#ffffff',
          } as EditMark;
        } else if (this.draft.kind !== 'ink' && style === 'underline') {
          output = { ...this.draft, kind: 'underline' } as EditMark;
        } else if (this.draft.kind !== 'ink' && style === 'strike') {
          output = { ...this.draft, kind: 'strike-through' } as EditMark;
        }
        this.marks.push(output);
        const selected = this.draft.id;
        this.setTool('select');
        this.selectedId = selected;
        this.changed();
      } else {
        this.history.pop();
      }
      this.draft = null;
      this.dragStart = null;
      this.renderMarks();
      if (this.overlay.hasPointerCapture(event.pointerId)) this.overlay.releasePointerCapture(event.pointerId);
    }

    private cancelPointer(): void {
      this.draft = null;
      this.dragStart = null;
      this.moving = null;
      this.viewport.dataset.panning = 'false';
      this.renderMarks();
    }

    private snapshot(value: EditMark[] = this.marks): void {
      this.history.push(structuredClone(value));
      if (this.history.length > 50) this.history.shift();
      this.refreshState();
    }

    private undo(): void {
      const previous = this.history.pop();
      if (!previous) return;
      this.marks = previous;
      this.selectedId = '';
      this.changed();
    }

    private deleteSelected(): void {
      if (!this.selectedId) return;
      this.snapshot();
      this.marks = this.marks.filter((mark) => mark.id !== this.selectedId);
      this.selectedId = '';
      this.changed();
    }

    private changed(): void {
      this.refreshState();
      this.renderMarks();
      this.dispatchEvent(new CustomEvent('editorchange', { bubbles: true, detail: { count: this.marks.length } }));
    }

    private refreshState(): void {
      const count = this.marks.length;
      this.querySelector<HTMLElement>('[data-editor-count]')!.textContent = count
        ? `${count} quick edit${count === 1 ? '' : 's'} will be included in the output`
        : 'No quick edits yet';
      this.querySelector<HTMLButtonElement>('[data-editor-undo]')!.disabled = this.history.length === 0;
      this.querySelector<HTMLButtonElement>('[data-editor-delete]')!.disabled = !this.selectedId;
    }

    private svg(name: string, attributes: Record<string, string>): SVGElement {
      const node = document.createElementNS('http://www.w3.org/2000/svg', name);
      for (const [key, value] of Object.entries(attributes)) node.setAttribute(key, value);
      return node;
    }

    private renderMarks(): void {
      const visible = [...this.marks, ...(this.draft ? [this.draft] : [])].filter((mark) => mark.page === this.activePage);
      const nodes: SVGElement[] = [];
      const pageHeight = Number(this.pageStage.dataset.pageHeight || 792);

      const defs = this.svg('defs', {});
      const arrowMarker = this.svg('marker', { id: 'editor-arrowhead', viewBox: '0 0 10 10', refX: '8', refY: '5', markerWidth: '6', markerHeight: '6', orient: 'auto-start-reverse' });
      arrowMarker.append(this.svg('path', { d: 'M 0 0 L 10 5 L 0 10 z', fill: 'currentColor' }));
      defs.append(arrowMarker);
      nodes.push(defs);

      if (this.guide.kind === 'watermark' && this.guide.text) {
        const guide = this.svg('text', { x: '500', y: '515', 'text-anchor': 'middle', class: 'editor-guide editor-guide--watermark', transform: 'rotate(-32 500 500)' });
        guide.textContent = this.guide.text;
        nodes.push(guide);
      } else if (this.guide.kind === 'page-number') {
        const guide = this.svg('text', { x: '945', y: '955', 'text-anchor': 'end', class: 'editor-guide editor-guide--number' });
        guide.textContent = `${this.guide.text ?? ''}${(this.guide.start ?? 1) + this.activePage - 1}`;
        nodes.push(guide);
      }

      for (const mark of visible) {
        const selected = mark.id === this.selectedId;
        let node: SVGElement;
        if (mark.kind === 'text') {
          node = this.svg('text', {
            x: String(mark.x * 1000),
            y: String(mark.y * 1000),
            fill: mark.color,
            'font-size': String((mark.size / pageHeight) * 1000),
            class: selected ? 'editor-mark is-selected' : 'editor-mark',
          });
          node.textContent = mark.text;
        } else if (mark.kind === 'stamp') {
          const glyphs: Record<string, string> = { check: '✓', cross: '×', dot: '•', circle: '○', crossout: '╳' };
          node = this.svg('text', { x: String((mark.x + mark.width / 2) * 1000), y: String((mark.y + mark.height * 0.82) * 1000), 'text-anchor': 'middle', fill: mark.color, 'font-size': String(mark.height * 1000), 'font-weight': '700', class: selected ? 'editor-mark is-selected' : 'editor-mark' });
          node.textContent = glyphs[mark.stamp.toLowerCase()] ?? mark.stamp;
        } else if (mark.kind === 'line' || mark.kind === 'arrow') {
          const start = mark.start ?? { x: mark.x ?? 0, y: mark.y ?? 0 };
          const end = mark.end ?? { x: (mark.x ?? 0) + (mark.width ?? 0), y: (mark.y ?? 0) + (mark.height ?? 0) };
          node = this.svg('polyline', { points: `${start.x * 1000},${start.y * 1000} ${end.x * 1000},${end.y * 1000}`, fill: 'none', stroke: mark.color, 'stroke-width': String(Math.max(1.5, mark.strokeWidth * 2.4)), 'stroke-linecap': 'round', 'marker-end': mark.kind === 'arrow' ? 'url(#editor-arrowhead)' : '', class: selected ? 'editor-mark is-selected' : 'editor-mark' });
        } else if (mark.kind === 'callout') {
          const group = this.svg('g', { class: selected ? 'editor-mark is-selected' : 'editor-mark' });
          group.append(this.svg('rect', { x: String(mark.x * 1000), y: String(mark.y * 1000), width: String(mark.width * 1000), height: String(mark.height * 1000), rx: '12', fill: mark.fill ?? '#ffffff', opacity: String(mark.opacity ?? 0.92), stroke: mark.color, 'stroke-width': String(Math.max(1.5, mark.strokeWidth * 2.4)) }));
          const anchor = mark.anchor ?? { x: mark.x + mark.width / 2, y: mark.y + mark.height + 0.05 };
          group.append(this.svg('line', { x1: String((mark.x + mark.width / 2) * 1000), y1: String((mark.y + mark.height) * 1000), x2: String(anchor.x * 1000), y2: String(anchor.y * 1000), stroke: mark.color, 'stroke-width': String(Math.max(1.5, mark.strokeWidth * 2.4)) }));
          if (mark.text) { const label = this.svg('text', { x: String((mark.x + 0.01) * 1000), y: String((mark.y + mark.height * 0.6) * 1000), fill: mark.color, 'font-size': '18' }); label.textContent = mark.text; group.append(label); }
          node = group;
        } else if (mark.kind === 'polygon' || mark.kind === 'cloud') {
          const xs = mark.points.map((point) => point.x);
          const ys = mark.points.map((point) => point.y);
          if (mark.kind === 'cloud') {
            const x = Math.min(...xs) * 1000;
            const y = Math.min(...ys) * 1000;
            const width = (Math.max(...xs) - Math.min(...xs)) * 1000;
            const height = (Math.max(...ys) - Math.min(...ys)) * 1000;
            node = this.svg('rect', { x: String(x), y: String(y), width: String(width), height: String(height), rx: '52', fill: 'none', stroke: mark.color, 'stroke-width': String(Math.max(1.5, mark.strokeWidth * 2.4)), 'stroke-dasharray': '10 5', class: selected ? 'editor-mark is-selected' : 'editor-mark' });
          } else {
            node = this.svg('polygon', { points: mark.points.map((point) => `${point.x * 1000},${point.y * 1000}`).join(' '), fill: 'none', stroke: mark.color, 'stroke-width': String(Math.max(1.5, mark.strokeWidth * 2.4)), 'stroke-linejoin': 'round', class: selected ? 'editor-mark is-selected' : 'editor-mark' });
          }
        } else if (mark.kind === 'signature' || mark.kind === 'signature-text') {
          const group = this.svg('g', { class: selected ? 'editor-mark is-selected' : 'editor-mark' });
          if (selected) group.append(this.svg('rect', { x: String(mark.x * 1000), y: String(mark.y * 1000), width: String(mark.width * 1000), height: String(mark.height * 1000), rx: '8', fill: 'none', stroke: mark.color ?? '#0f172a', 'stroke-width': '2', 'stroke-dasharray': '8 5' }));
          const label = this.svg('text', {
            x: String((mark.x + 0.006) * 1000),
            y: String((mark.y + mark.height * 0.72) * 1000),
            fill: mark.color ?? '#0f172a',
            'font-size': String(Math.max(18, Math.min(42, (mark.size ?? 22) * 1.35))),
            'font-family': 'Georgia, serif',
            'font-style': 'italic',
          });
          label.textContent = mark.text?.trim() || 'Signature';
          group.append(label);
          node = group;
        } else if (mark.kind === 'replace-text' || mark.kind === 'replace') {
