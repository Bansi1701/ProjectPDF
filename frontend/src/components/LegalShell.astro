---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from './Masthead.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  updated: string;
}

const { title, description, eyebrow, updated } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout {title} {description}>
  <Masthead />
  <main id="main" class="legal">
    <nav aria-label="Breadcrumb"><a href={`${base}/`}>Home</a><span>/</span><span>{eyebrow}</span></nav>
    <header><p>{eyebrow}</p><h1>{title}</h1><span>{description}</span><small>Last updated {updated}</small></header>
    <article><slot /></article>
  </main>
</BaseLayout>
<style>
  .legal { width: min(68rem, calc(100% - 2rem)); margin: 0 auto; padding: 2rem 0 6rem; }
  nav { display: flex; gap: 0.5rem; color: var(--muted); font-size: var(--step--2); }
  nav a { color: inherit; }
  header { max-width: 52rem; padding: clamp(4rem, 10vw, 7rem) 0 4rem; }
  header > p { margin: 0 0 0.7rem; color: var(--accent); font-size: var(--step--2); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  h1 { margin: 0; font-family: var(--font-display); font-size: var(--step-5); line-height: 1; letter-spacing: -0.05em; }
  header > span { display: block; margin: 1.2rem 0; color: var(--ink-2); font-size: var(--step-1); line-height: 1.65; }
  header small { color: var(--muted); }
  article { max-width: 54rem; }
  article :global(h2) { margin: 3.5rem 0 0.7rem; padding-top: 1rem; border-top: 1px solid var(--line); font-family: var(--font-display); font-size: var(--step-2); }
  article :global(h3) { margin-top: 2rem; font-family: var(--font-display); }
  article :global(p), article :global(li) { color: var(--ink-2); line-height: 1.75; }
  article :global(a) { color: var(--accent); }
  article :global(.callout) { margin: 2rem 0; padding: 1.25rem; border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--line)); border-radius: var(--radius-lg); background: color-mix(in srgb, var(--accent) 6%, var(--paper-raised)); }
  article :global(.callout p:last-child) { margin-bottom: 0; }
  article :global(table) { width: 100%; border-collapse: separate; border-spacing: 0; overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-lg); font-size: var(--step--1); }
  article :global(th), article :global(td) { padding: 0.85rem; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); }
  article :global(th) { background: var(--paper-raised); font-size: var(--step--2); }
  article :global(tr:last-child td) { border-bottom: 0; }
  article :global(code) { font-family: var(--font-mono); font-size: 0.9em; }
  @media (max-width: 44rem) {
    h1 { font-size: var(--step-4); }
    article :global(table), article :global(tbody), article :global(tr), article :global(td) { display: block; }
    article :global(thead) { display: none; }
    article :global(tr) { padding: 0.75rem; border-bottom: 1px solid var(--line); }
    article :global(td) { padding: 0.4rem; border: 0; }
  }
</style>
