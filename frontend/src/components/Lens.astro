---
/**
 * The glass.
 *
 * Three SIBLING layers, never nested:
 *
 *   .lens__frost   the material — tint + backdrop-filter
 *   .lens__rim     a 1.25px conic specular ring, pure gradient (no filter)
 *   .lens__body    the content
 *
 * The nesting rule is the whole trick. An element with `backdrop-filter`
 * becomes a backdrop root, so a filtered child samples its parent's
 * ALREADY-COMPOSITED output — you get milk, not lensing. `.lens` therefore
 * carries no filter of its own.
 *
 * The one deliberate exception is `.lens__frost::after`, where compounding
 * blur at the rim is the goal (clear in the middle, busiest at the edge).
 *
 * Used sparingly: at most two lens surfaces on screen at once.
 */
interface Props {
  variant?: 'rail' | 'loupe';
  as?: 'div' | 'header' | 'figure' | 'section';
  class?: string;
}

const { variant = 'loupe', as: Tag = 'div', class: className = '' } = Astro.props;
---

<Tag class:list={['lens', className]} data-lens={variant}>
  <span class="lens__frost" aria-hidden="true"></span>
  <span class="lens__rim" aria-hidden="true"></span>
  <div class="lens__body"><slot /></div>
</Tag>

<style>
  .lens {
    position: relative;
    /* stacking context only — deliberately NOT a backdrop root */
    isolation: isolate;
    border-radius: var(--lens-radius);
    color: var(--ink);
    box-shadow: var(--lens-elev);
    contain: paint;
    transition: box-shadow 260ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* Continuous-curvature corners where supported; degrades invisibly.
     Never on the pill rail — a squircled 999px radius is just a worse pill. */
  @supports (corner-shape: squircle) {
    .lens:not([data-lens='rail']) {
      corner-shape: squircle;
    }
  }

  /* ── layer 1: the material ──────────────────────────────────────────── */
  .lens__frost {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    pointer-events: none;
    background-image: var(--lens-sheen), var(--lens-fill);
    /* Literal values on the prefixed line: WebKit can silently drop a
       -webkit-backdrop-filter whose value comes from a custom property. */
    -webkit-backdrop-filter: blur(18px) saturate(1.7) brightness(1.04);
    backdrop-filter: blur(var(--lens-blur)) saturate(var(--lens-sat))
      brightness(var(--lens-bright));
    /* bevel — implies the glass has thickness */
    box-shadow:
      inset 0 1px 0 var(--lens-bevel-hi),
      inset 0 -1px 0 var(--lens-bevel-lo);
    transition: --lens-sheen-x 420ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .lens__frost {
      -webkit-backdrop-filter: blur(22px) saturate(1.5) brightness(1.12);
    }
  }

  /* Blur falloff at the rim. Nested on purpose — here the goal IS compounding
     blur, not lensed content. Desktop only; worst case the face goes milkier. */
  @media (min-width: 64em) and (prefers-reduced-transparency: no-preference) {
    .lens__frost::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      -webkit-backdrop-filter: blur(9px) saturate(1.5) brightness(1.06);
      backdrop-filter: blur(9px) saturate(1.5) brightness(1.06);
      -webkit-mask-image: radial-gradient(125% 125% at 50% 45%, transparent 52%, #000 100%);
      mask-image: radial-gradient(125% 125% at 50% 45%, transparent 52%, #000 100%);
    }
  }

  /* ── layer 2: specular rim. Pure gradient — no filter, so it can never
        fail into a bright slab over the content. ───────────────────────── */
  .lens__rim {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    pointer-events: none;
    padding: 1.25px;
    background: conic-gradient(
      from var(--lens-rim-angle),
      var(--lens-rim-lo) 0deg,
      var(--lens-rim-cool) 42deg,
      var(--lens-rim-hi) 96deg,
      var(--lens-rim-warm) 158deg,
      var(--lens-rim-lo) 214deg,
      var(--lens-rim-hi) 292deg,
      var(--lens-rim-lo) 360deg
    );
    -webkit-mask-image: linear-gradient(#000 0 0), linear-gradient(#000 0 0);
    -webkit-mask-clip: content-box, border-box;
    -webkit-mask-composite: xor;
    mask-image: linear-gradient(#000 0 0), linear-gradient(#000 0 0);
    mask-clip: content-box, border-box;
    mask-composite: exclude;
  }

  /* One rule mirrors the light source for RTL locales. */
  :global([dir='rtl']) .lens__rim {
    --lens-rim-angle: 332deg;
  }

  .lens__body {
    position: relative;
    z-index: 2;
  }

  /* ── variants ───────────────────────────────────────────────────────── */
  .lens[data-lens='rail'] {
    --lens-radius: 999px;
    --lens-blur: 14px;
  }

  .lens[data-lens='rail'] .lens__frost::after {
    display: none;
  }

  .lens[data-lens='loupe'] {
    --lens-radius: 24px;
  }

  /* ── motion: one entry sweep. Never an infinite animation over a blurred
        surface — that is continuous repaint, i.e. battery. ──────────────── */
  @media (prefers-reduced-motion: no-preference) {
    .lens__rim {
      animation: lens-strike 1100ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
  }

  @keyframes lens-strike {
    from {
      --lens-rim-angle: 124deg;
    }
    to {
      --lens-rim-angle: 208deg;
    }
  }

  .lens:is(:hover, :focus-within) .lens__frost {
    --lens-sheen-x: 36%;
  }

  @media (max-width: 40em) {
    .lens {
      --lens-blur: 12px;
    }
  }

  /* ── fallback chain: every rung complete and legible ─────────────────── */

  @supports not ((backdrop-filter: blur(2px)) or (-webkit-backdrop-filter: blur(2px))) {
    .lens__frost {
      background-image: var(--lens-sheen);
      background-color: color-mix(in oklab, var(--lens-solid) 94%, transparent);
    }
  }

  @supports not ((mask-composite: exclude) or (-webkit-mask-composite: xor)) {
    .lens__rim {
      display: none;
    }
    .lens {
      outline: 1px solid var(--line);
      outline-offset: -1px;
    }
  }

  /* Safari does not support this at all, so it is a bonus — never the
     safety net. Contrast must already hold with the blur contributing zero. */
  @media (prefers-reduced-transparency: reduce) {
    .lens__frost {
      background-image: none;
      background-color: var(--lens-solid);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    .lens__rim {
      background: var(--line-strong);
      animation: none;
    }
  }

  @media (prefers-contrast: more) {
    .lens__frost {
      background-image: none;
      background-color: var(--lens-solid);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    .lens__rim {
      display: none;
    }
    .lens {
      outline: 1.5px solid var(--ink);
      outline-offset: -1.5px;
    }
  }

  @media (forced-colors: active) {
    .lens__frost {
      background: Canvas;
      background-image: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    .lens__rim {
      display: none;
    }
    .lens {
      border: 1px solid CanvasText;
      box-shadow: none;
    }
  }
</style>
