---
import { SITE, TOOLS } from '../config/site';
import { canonical, websiteLd } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  imageSlug?: string;
  noindex?: boolean;
  keywords?: string[];
  contentType?: 'website' | 'article';
}

const { title, description, imageSlug, noindex = false, keywords = [], contentType = 'website' } = Astro.props;
const pageSlug = Astro.url.pathname.split('/').filter(Boolean).at(-1) ?? '';
const tool = TOOLS.find((item) => item.slug === pageSlug && item.status === 'live');
const canonicalUrl = canonical(Astro.url.pathname);
const shareSlug = imageSlug ?? tool?.slug ?? 'home';
const shareImage = canonical(`/og/${shareSlug}.png`);
const home = canonicalUrl === canonical('/');
const schema = home ? websiteLd() : null;
---

<title>{title}</title>
<meta name="description" content={description} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonicalUrl} />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={contentType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={shareImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={`${title} — zero document uploads`} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={shareImage} />
<meta name="twitter:image:alt" content={`${title} — zero document uploads`} />

{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />}
