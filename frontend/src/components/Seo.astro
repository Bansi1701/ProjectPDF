---
import { SITE, TOOLS } from '../config/site';
import { canonical, organizationLd, websiteLd } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  imageSlug?: string;
  noindex?: boolean;
  keywords?: string[];
  contentType?: 'website' | 'article';
}

const { title, description, imageSlug, noindex = false, keywords = [], contentType = 'website' } = Astro.props;
const pageSlug = Astro.url.pathname.split('/').filter(Boolean).at(-1) ?? '';
const tool = TOOLS.find((item) => item.slug === pageSlug && item.status === 'live');
const canonicalUrl = canonical(Astro.url.pathname);
const shareSlug = imageSlug ?? tool?.slug ?? 'home';
const shareImage = canonical(`/og/${shareSlug}.png`);
const home = canonicalUrl === canonical('/');
const schemas = home ? [websiteLd(), organizationLd()] : [];

/* Tool pages ship terse one-line descriptions written for the UI. A search
   snippet wants the differentiator too; append it only when there is room,
   so the copy that was written stays first. */
const USP = 'Free, no upload, no account — it runs in your browser.';
const metaDescription = tool && description.length + USP.length < 160 ? `${description} ${USP}` : description;

/* Ownership proofs for Search Console and Bing Webmaster Tools. Set as
   repository variables so the deploy carries them; absent locally. */
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || '';
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION || '';
---

<title>{title}</title>
<meta name="description" content={metaDescription} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
{noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
<link rel="canonical" href={canonicalUrl} />
{googleVerification && <meta name="google-site-verification" content={googleVerification} />}
{bingVerification && <meta name="msvalidate.01" content={bingVerification} />}

<meta property="og:title" content={title} />
<meta property="og:description" content={metaDescription} />
<meta property="og:type" content={contentType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={shareImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={`${title} — zero document uploads`} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={shareImage} />
<meta name="twitter:image:alt" content={`${title} — zero document uploads`} />

{schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />)}
