---
import Lens from './Lens.astro';
import Logo from './Logo.astro';
import { CATEGORIES, SITE } from '../config/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="masthead-slot">
  <Lens variant="rail" as="header" class="rail">
    <a class="brand" href={`${base}/`}>
      <Logo size="1.375rem" />
      <span>{SITE.name}</span>
    </a>

    <nav class="nav" aria-label="Tool categories">
      {CATEGORIES.map((category) => <a href={`${base}/#${category.toLowerCase()}`}>{category}</a>)}
    </nav>

    <div class="rail__actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode">
        <span aria-hidden="true">◐</span>
      </button>
      <a class="rail-cta" href={`${base}/#tools`}>Browse tools</a>
    </div>
  </Lens>
</div>

<style>
  .masthead-slot {
    position: sticky;
    top: 0.75rem;
    z-index: 20;
    width: min(100% - (var(--gutter) * 2), var(--content));
    margin-inline: auto;
    padding-top: 0.75rem;
  }

  /* The element is rendered by <Lens>, so the parent's scoped selector never
     lands on it. Constrain :global() under .masthead-slot instead. */
  .masthead-slot :global(.rail) {
    padding: 0.5rem 0.5rem 0.5rem 1.125rem;
    min-height: 3.5rem;
  }

  /* Lens wraps its slot in .lens__body, so the row lives one level down. */
  .masthead-slot :global(.rail .lens__body) {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 2.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-right: auto;
  }

  .nav {
    display: none;
    gap: 1.5rem;
  }

  .nav a {
    color: var(--ink-2);
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 500;
  }

  .nav a:hover {
    color: var(--ink);
  }

  .rail__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .theme-toggle,
  .rail-cta {
    padding: 0.5rem 1rem;
    border-radius: 12px;
    border: 1px solid var(--line-strong);
    color: var(--ink);
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 500;
    white-space: nowrap;
  }

  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    background: transparent;
    cursor: pointer;
  }

  .rail-cta:hover {
    color: var(--ink);
    border-color: var(--ink-2);
  }

  @media (min-width: 48em) {
    .nav {
      display: flex;
      margin-inline: auto;
    }

    .brand {
      margin-right: 0;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  const paintToggle = () => {
    if (!toggle) return;
    const dark = document.documentElement.dataset.theme === 'dark';
    toggle.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
    toggle.firstElementChild!.textContent = dark ? '☀' : '◐';
  };

  paintToggle();
  toggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('pdfcraft-theme', next); } catch {}
    paintToggle();
  });
</script>
