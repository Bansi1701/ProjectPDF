---
interface Props {
  size?: string;
}

const { size = '2.5rem' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const mark = `${base}brand/pdfcraft-fold-mark.png`;
---

<span class="logo" style={`--size: ${size}`} aria-hidden="true">
  <img src={mark} alt="" />
</span>

<style>
  .logo {
    display: block;
    width: var(--size);
    height: var(--size);
    overflow: hidden;
    border-radius: 27%;
    box-shadow: 0 6px 14px -9px rgb(225 29 72 / 0.85);
  }

  .logo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
