---
interface Props {
  size?: string;
}

const { size = '2.5rem' } = Astro.props;
---

<span class="logo" style={`--size: ${size}`} aria-hidden="true">
  <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path
      d="M8 3h11l6 6v20a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"
      stroke="currentColor"
      stroke-width="2"
      stroke-linejoin="round"></path>
    <path d="M19 3v6h6" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
  </svg>
</span>

<style>
  .logo {
    display: block;
    width: var(--size);
    height: var(--size);
    color: var(--ink);
  }

  .logo svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
