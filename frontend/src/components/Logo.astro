---
interface Props {
  size?: string;
}

const { size = '2.5rem' } = Astro.props;
---

<span class="logo" style={`--size: ${size}`} aria-hidden="true">
  <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M9 4.5h14.4l7.1 7.2v22.1a1.7 1.7 0 0 1-1.7 1.7H10.7A1.7 1.7 0 0 1 9 33.8V6.2A1.7 1.7 0 0 1 10.7 4.5Z" fill="currentColor" />
    <path d="M23.4 4.5v7.2h7.1L23.4 4.5Z" fill="var(--paper-raised)" opacity=".94" />
    <path d="M14 19.4h12M14 24h9M14 28.6h6" stroke="var(--paper-raised)" stroke-width="2.2" stroke-linecap="round" opacity=".94" />
  </svg>
</span>

<style>
  .logo {
    display: block;
    width: var(--size);
    height: var(--size);
    color: var(--accent);
  }

  .logo svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
