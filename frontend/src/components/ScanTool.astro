---
/**
 * Scan to PDF — the camera half.
 *
 * The worker has no DOM and no camera, so capture has to live on the main
 * thread; everything after capture (finding the page in the frame, unwarping
 * it, cleaning it up, assembling the PDF) belongs in the worker where it
 * cannot block the interface. This file is the capture side of that split.
 *
 * The camera stream is a live feed of whatever someone is pointing at — very
 * often a passport, a payslip or a prescription. It is never uploaded, never
 * recorded, and the track is stopped the moment the page is left. That is the
 * whole reason this tool belongs on this site rather than in an app store.
 *
 * Two pieces of the interface exist because detection is a guess and a scanner
 * may not be:
 *
 *  - The finish selector. Sauvola thresholding is right for a typed page and
 *    catastrophic for a photograph, which comes back as a flat black shape.
 *    The choice is the user's, stated in plain words, and it is one control
 *    rather than a mode and a "clean up" switch that can contradict it.
 *  - The corner editor. When the detector picks the table edge, or finds
 *    nothing, four draggable corners over the captured frame are the whole
 *    difference between a tool that usually works and one that always does.
 */
import Lens from './Lens.astro';
---

<section class="scan" data-scan>
  <p class="eyebrow">Your camera, your device</p>
  <h1>Scan to PDF</h1>
  <p class="lede">
    Photograph a page and get back a straightened, readable PDF. The camera feed stays in this
    tab — no frame is uploaded, and nothing is kept when you leave.
  </p>

  <!-- First run. Static HTML, so it is on screen before any script has run and
       the page is never a heading above an empty rectangle. -->
  <div class="scan__intro" data-scan-intro>
    <ol class="scan__steps">
      <li>
        <b>Point at the page.</b> A live outline follows the sheet of paper, so the crop is
        something you watch rather than something you discover afterwards.
      </li>
      <li>
        <b>Check every shot.</b> Open any page to see it big — drag its corners onto the paper,
        turn it, reshoot it, or drop it. Nothing is final until you say so.
      </li>
      <li>
        <b>Build the PDF here.</b> Straightened, evened out, and saved to your device by the same
        browser tab you are reading this in.
      </li>
    </ol>
    <p class="scan__creed">
      There is no upload step to opt out of and no account to delete. The code that finds the page
      and writes the PDF is the code already running in this tab; the camera indicator goes out the
      moment you turn it off, leave, or switch to another tab.
    </p>
  </div>

  <!-- Nothing here needs a camera until it is asked for: the permission prompt
       fires on the button, not on page load, which is the difference between a
       tool and something that feels like it is watching. -->
  <Lens variant="loupe" class="scan__start" data-scan-start>
    <button class="btn btn--primary" data-scan-open type="button">Turn on the camera</button>
    <p class="scan__hint">
      Your browser will ask first. Nothing starts until you allow it.
    </p>
  </Lens>

  <!-- Lives outside the stage: a retake can be asked for while the camera is
       off, and the request has to survive turning it back on. -->
  <p class="scan__retake" data-scan-retake hidden>
    <span data-scan-retake-label></span>
    <button class="scan__act" data-scan-retake-cancel type="button">Keep the shot I have</button>
  </p>

  <div class="scan__stage" data-scan-stage hidden>
    <div class="scan__viewport">
      <video class="scan__video" data-scan-video playsinline muted autoplay></video>
      <!-- The detected page outline is drawn over the feed so people can see
           what will be cropped before they take the shot. -->
      <canvas class="scan__overlay" data-scan-overlay aria-hidden="true"></canvas>
      <p class="scan__status" data-scan-status role="status" aria-live="polite"></p>
    </div>

    <div class="scan__controls">
      <button class="btn btn--primary" data-scan-shoot type="button">Capture page</button>
      <label class="scan__toggle">
        <input type="checkbox" data-scan-auto />
        <span>Capture automatically when the page is steady</span>
      </label>
      <button class="btn btn--quiet" data-scan-stop type="button">Turn the camera off</button>
    </div>
  </div>

  <div class="scan__shots" data-scan-shots hidden>
    <div class="scan__shots-head">
      <h2 class="scan__shots-title" data-scan-count></h2>
      <button class="scan__act" data-scan-clear type="button">Discard all</button>
    </div>
    <ol class="scan__list" data-scan-list></ol>
    <p class="scan__listhint">
      Open a page to check it full size, drag its corners onto the paper, turn it, reshoot it or
      drop it. The arrows put the pages in the order you want them bound.
    </p>

    <fieldset class="scan__options">
      <legend class="scan__legend">How should the pages come out?</legend>

      <div class="scan__modes">
        <label class="scan__mode">
          <input type="radio" name="scan-finish" value="text" data-scan-finish checked />
          <span class="scan__mode-body">
            <span class="scan__mode-name">Text</span>
            <span class="scan__mode-note">
              Black on white. Sharpest for typed or handwritten pages, and much the smallest file.
            </span>
          </span>
        </label>

        <label class="scan__mode">
          <input type="radio" name="scan-finish" value="grey" data-scan-finish />
          <span class="scan__mode-body">
            <span class="scan__mode-name">Greyscale</span>
            <span class="scan__mode-note">
              Keeps the shading. For pages with a photograph, a shaded diagram or a stamp on them.
            </span>
          </span>
        </label>

        <label class="scan__mode">
          <input type="radio" name="scan-finish" value="colour" data-scan-finish />
          <span class="scan__mode-body">
            <span class="scan__mode-name">Colour</span>
            <span class="scan__mode-note">
              Keeps the colour. For logos, highlighter, coloured forms and receipts.
            </span>
          </span>
        </label>

        <label class="scan__mode">
          <input type="radio" name="scan-finish" value="photo" data-scan-finish />
          <span class="scan__mode-body">
            <span class="scan__mode-name">Photo, unchanged</span>
            <span class="scan__mode-note">
              No cropping, no straightening, no clean-up — the frames exactly as the camera took
              them.
            </span>
          </span>
        </label>
      </div>

      <p class="scan__note">
        Text thresholds every pixel to black or white, so a photograph or a coloured logo comes out
        as a flat black shape. If a page looks like that in the previews, Greyscale or Colour is
        the fix.
      </p>

      <label class="scan__toggle">
        <input type="checkbox" data-scan-searchable />
        <span>Make the text searchable (runs recognition here; adds time)</span>
      </label>
    </fieldset>

    <div class="scan__actions">
      <button class="btn btn--primary" data-scan-run type="button">Make the PDF</button>
    </div>
    <p class="status" data-scan-progress role="status" aria-live="polite"></p>
  </div>

  <section class="result" data-result hidden>
    <ul class="result__notes" data-notes></ul>
    <div class="result__actions" data-downloads></div>
    <p class="result__receipt" data-receipt></p>
  </section>

  <p class="error" data-error hidden role="alert"></p>

  <!--
    Per-page review. Authored here rather than built by the script on purpose:
    a <dialog> in the markup gets Astro's scoped styles, native focus trapping
    and Escape for free, and the four corner handles are real focusable buttons
    from the first paint rather than nodes a stylesheet cannot reach.
  -->
  <dialog class="scan__review" data-scan-review aria-labelledby="scan-review-title">
    <div class="scan__review-inner">
      <header class="scan__review-head">
        <h2 class="scan__review-title" id="scan-review-title" data-review-title>Page</h2>
        <button class="btn btn--primary scan__done" data-review-close type="button">Done</button>
      </header>

      <div class="scan__panes">
        <div class="scan__editor" data-review-editor>
          <img class="scan__editor-frame" data-review-frame alt="" decoding="async" />
          <svg
            class="scan__editor-quad"
            data-review-quad
            viewBox="0 0 100 100"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <polygon data-review-poly points="0,0 100,0 100,100 0,100"></polygon>
          </svg>

          <button class="scan__handle" data-review-handle="0" type="button" aria-describedby="scan-review-help"></button>
          <button class="scan__handle" data-review-handle="1" type="button" aria-describedby="scan-review-help"></button>
          <button class="scan__handle" data-review-handle="2" type="button" aria-describedby="scan-review-help"></button>
          <button class="scan__handle" data-review-handle="3" type="button" aria-describedby="scan-review-help"></button>

          <!-- A thumb covers exactly the pixel it is aiming at, so the corner
               under it is drawn again, larger, somewhere the thumb is not. -->
          <canvas class="scan__loupe" data-review-loupe width="136" height="136" aria-hidden="true" hidden></canvas>
        </div>

        <figure class="scan__proof">
          <img class="scan__proof-img" data-review-proof alt="" decoding="async" />
          <figcaption class="scan__proof-note" data-review-proofnote></figcaption>
        </figure>
      </div>

      <p class="scan__help" id="scan-review-help">
        Drag a corner onto the paper, or move focus to one and nudge it with the arrow keys — hold
        Shift to move ten times as far.
      </p>
      <p class="scan__readout" data-review-readout role="status" aria-live="polite"></p>

      <div class="scan__review-actions">
        <button class="scan__act" data-review-whole type="button">Use the whole frame</button>
        <button class="scan__act" data-review-detect type="button">Find the page again</button>
        <button class="scan__act" data-review-rotate type="button">Rotate right</button>
        <button class="scan__act" data-review-earlier type="button">Move earlier</button>
        <button class="scan__act" data-review-later type="button">Move later</button>
        <button class="scan__act" data-review-retake type="button">Retake this page</button>
        <button class="scan__act scan__act--warn" data-review-delete type="button">Remove this page</button>
      </div>
    </div>
  </dialog>
</section>

<style>
  .scan {
    padding-block: clamp(2rem, 1.5rem + 2vw, 3rem) clamp(3.5rem, 3rem + 4vw, 6rem);
    display: grid;
    gap: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    max-width: 46rem;
  }

  .eyebrow {
    font-size: var(--step--2);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }

  h1 {
    margin: 0;
    font-size: var(--step-4, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .lede {
    margin: 0;
    color: var(--ink-2);
    max-width: 34rem;
  }

  /* ---- first run ------------------------------------------------------ */

  .scan__intro {
    display: grid;
    gap: 0.9rem;
    border-left: 2px solid var(--line);
    padding-left: clamp(0.9rem, 0.6rem + 1vw, 1.4rem);
  }

  .scan__steps {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.55rem;
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.55;
    max-width: 40rem;
  }

  .scan__steps b {
    color: var(--ink);
    font-weight: 600;
  }

  .scan__creed {
    margin: 0;
    max-width: 40rem;
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--muted);
  }

  .scan__start {
    display: grid;
    gap: 0.6rem;
    justify-items: center;
    text-align: center;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .scan__hint {
    margin: 0;
    font-size: var(--step--1);
    color: var(--muted);
  }

  /* ---- the stage ------------------------------------------------------ */

  .scan__retake {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
    margin: 0;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--line);
    border-left: 3px solid var(--disclose);
    border-radius: calc(var(--radius) * 0.5);
    background: var(--paper-raised);
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .scan__viewport {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper-sunk);
    border: 1px solid var(--line);
  }

  .scan__video {
    display: block;
    width: 100%;
    height: auto;
    max-height: 62vh;
    object-fit: contain;
    background: #000;
  }

  .scan__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .scan__status {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    margin: 0;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    font-size: var(--step--2);
    background: rgb(0 0 0 / 0.55);
    color: #fff;
  }

  .scan__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    align-items: center;
    margin-top: 0.75rem;
  }

  .scan__toggle {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  /* ---- the captured pages --------------------------------------------- */

  .scan__shots-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .scan__shots-title {
    margin: 0;
    font-size: var(--step-1);
  }

  .scan__list {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(136px, 1fr));
    gap: 0.75rem;
  }

  .scan__listhint {
    margin: 0.6rem 0 0;
    font-size: var(--step--2);
    color: var(--muted);
    max-width: 38rem;
  }

  /* ---- finish selector ------------------------------------------------- */

  .scan__options {
    border: 0;
    padding: 0;
    margin: 1.25rem 0 0;
    display: grid;
    gap: 0.7rem;
  }

  .scan__legend {
    padding: 0;
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--ink);
  }

  .scan__modes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0.5rem;
  }

  .scan__mode {
    display: flex;
    gap: 0.55rem;
    align-items: start;
    padding: 0.6rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) * 0.5);
    background: var(--paper-raised);
    cursor: pointer;
  }

  .scan__mode:hover {
    border-color: var(--line-strong);
  }

  /* :has is the whole point of the card — the checked input decides the
     surface, and there is no JS in this file keeping a class in step. */
  .scan__mode:has(input:checked) {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .scan__mode:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .scan__mode input {
    margin-top: 0.2rem;
    accent-color: var(--accent);
    flex: none;
  }

  .scan__mode-body {
    display: grid;
    gap: 0.15rem;
  }

  .scan__mode-name {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink);
  }

  .scan__mode-note {
    font-size: var(--step--2);
    line-height: 1.45;
    color: var(--muted);
  }

  .scan__note {
    margin: 0;
    font-size: var(--step--2);
    line-height: 1.5;
    color: var(--muted);
    max-width: 40rem;
  }

  .scan__actions {
    margin-top: 1rem;
  }

  /* ---- a small, quiet button --------------------------------------------
     Not .btn: these sit in rows of six and .btn is sized for one decision. */

  .scan__act {
    font: inherit;
    font-size: var(--step--2);
    color: var(--ink);
    background: var(--paper-raised);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 0.45rem 0.85rem;
    min-height: 2.2rem;
    cursor: pointer;
  }

  .scan__act:hover {
    border-color: var(--ink-2);
  }

  .scan__act:disabled {
    color: var(--muted);
    border-color: var(--line);
    cursor: default;
  }

  .scan__act--warn {
    color: var(--seal);
  }

  /* ---- the review dialog ----------------------------------------------- */

  .scan__review {
    width: min(60rem, calc(100vw - 1.5rem));
    max-width: none;
    max-height: min(94dvh, 94vh);
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper-raised);
    color: var(--ink);
    overflow: auto;
    overscroll-behavior: contain;
  }

  .scan__review::backdrop {
    background: rgb(0 0 0 / 0.55);
    backdrop-filter: blur(2px);
  }

  .scan__review-inner {
    display: grid;
    gap: 0.8rem;
    padding: clamp(0.8rem, 0.6rem + 1vw, 1.25rem);
  }

  .scan__review-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .scan__review-title {
    margin: 0;
    font-size: var(--step-1);
  }

  .scan__done {
    padding: 0.5rem 1.1rem;
    font-size: var(--step--1);
  }

  .scan__panes {
    display: grid;
    gap: 0.8rem;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: start;
  }

  @media (max-width: 48em) {
    .scan__panes {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* The editor is a plain positioned box. The picture inside it is placed in
     pixels by the script — object-fit would letterbox it somewhere the corner
     handles cannot be told about, and the handles must land on the paper. */
  .scan__editor {
    position: relative;
    height: clamp(15rem, 46vh, 32rem);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) * 0.5);
    background: var(--paper-sunk);
    overflow: hidden;
  }

  /* Zero until the script has measured the box: for one frame otherwise the
     picture is drawn at its own 4000 px and the editor is a crop of a corner. */
  .scan__editor-frame {
    position: absolute;
    left: 0;
    top: 0;
    display: block;
    width: 0;
    height: 0;
    max-width: none;
  }

  .scan__editor-quad {
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: none;
    overflow: visible;
    max-width: none;
  }

  .scan__editor-quad polygon {
    fill: rgb(255 255 255 / 0.14);
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linejoin: round;
    /* The viewBox is stretched to the picture's aspect, so without this the
       stroke is stretched with it and one pair of sides draws thicker. */
    vector-effect: non-scaling-stroke;
  }

  /* 44px of target for a thumb, 20px of dot for the eye. */
  .scan__handle {
    position: absolute;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    cursor: grab;
    /* Without this the browser claims the gesture for a scroll and the corner
       stops following the finger halfway through the drag. */
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
  }

  .scan__handle::before {
    content: '';
    position: absolute;
    inset: 12px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow:
      0 0 0 3px var(--paper-raised),
      0 1px 4px rgb(0 0 0 / 0.35);
  }

  .scan__handle:active {
    cursor: grabbing;
  }

  .scan__handle:focus-visible {
    outline: none;
  }

  .scan__handle:focus-visible::before {
    inset: 9px;
    box-shadow:
      0 0 0 3px var(--paper-raised),
      0 0 0 6px var(--accent);
  }

  .scan__handle[disabled] {
    display: none;
  }

  .scan__loupe {
    position: absolute;
    width: 136px;
    height: 136px;
    border-radius: 50%;
    border: 2px solid var(--paper-raised);
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.35);
    pointer-events: none;
    background: var(--paper-sunk);
  }

  .scan__proof {
    margin: 0;
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }

  .scan__proof-img {
    display: block;
    width: 100%;
    height: clamp(11rem, 34vh, 24rem);
    object-fit: contain;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) * 0.5);
    background: var(--paper-sunk);
  }

  .scan__proof-note {
    font-size: var(--step--2);
    line-height: 1.45;
    color: var(--muted);
  }

  .scan__help,
  .scan__readout {
    margin: 0;
    font-size: var(--step--2);
    color: var(--muted);
  }

  .scan__readout {
    font-variant-numeric: tabular-nums;
    min-height: 1.2em;
  }

  .scan__review-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* Defined locally: .sr-only is scoped inside PdfTool and does not reach here. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  /**
   * Capture side of Scan to PDF.
   *
   * The division of labour is deliberate. Everything that touches pixels for
   * real — detection, unwarping, enhancement, PDF assembly — is `lib/pdf/scan.ts`
   * running in the worker. This file owns the camera, the viewfinder outline,
   * the list of shots and the geometry the user can correct, and nothing else.
   * Three consequences worth stating up front:
   *
   *  - A shot is kept as the JPEG the camera produced, not as a processed
   *    bitmap. scan.ts is built to take encoded bytes for exactly this reason:
   *    twenty full-resolution bitmaps is a few hundred megabytes pinned, twenty
   *    JPEGs is about eight, and bytes cannot be closed out from under a retake.
   *  - The thumbnail under each shot is a rehearsal, not the output. It is the
   *    same detect → unwarp → clean pipeline run at ~560 px so it costs tens of
   *    milliseconds instead of seconds; the worker repeats it at full resolution
   *    when the PDF is built. A thumbnail can therefore disagree with the final
   *    page on a marginal frame, and the caption says which of the two found a
   *    page edge rather than pretending they always agree.
   *  - Corners the user has set are the one thing the worker must not re-guess,
   *    so they travel with the request as `quads` — fractions of each frame, not
   *    pixels, so no resampling step can shift them. A quad is sent only for a
   *    page somebody actually adjusted; the rest are `null` and the worker
   *    detects them at its own, higher, resolution.
   *
   * Nothing here uploads, records or stores a frame. The only bytes that leave
   * this module go to the worker, which is the same tab.
   */
  import type { ImageLike, Point, Quad, ScanMode } from '../lib/pdf/scan';
  import type { OutputFile, WorkerRequest, WorkerResponse } from '../lib/pdf/types';

  /* ================================================================== *
   * Pure geometry — no DOM, no canvas, no state.
   *
   * Everything the corner editor gets wrong if it is wrong lives here, in
   * functions that can be run outside a browser: where the picture sits inside
   * its box, how a pointer position becomes a fraction of that picture, which
   * quadrilaterals are worth accepting, and what a quarter-turn does to a set
   * of corners. Kept together at the top of the module so the whole lot can be
   * exercised in node.
   * ================================================================== */

  /** Corners as fractions of their own frame: 0–1 across, 0–1 down. */
  type Corners = Quad;

  /** Where a picture lands when it is letterboxed into a box, in box pixels. */
  interface Fit {
    x: number;
    y: number;
    w: number;
    h: number;
    /** Box pixels per source pixel. */
    scale: number;
  }

  const clamp = (n: number, low: number, high: number): number =>
    n < low ? low : n > high ? high : n;

  const clamp01 = (n: number): number => clamp(n, 0, 1);

  /**
   * `object-fit: contain`, done in numbers so the handles can be told about it.
   *
   * The editor shows the frame as shot — some frames are portrait, some
   * landscape, the box is neither — so the picture is letterbox-fitted and the
   * bars are dead space. A corner dropped in the bar is not a corner of the
   * page, and every mapping below runs through this one rectangle so there is
   * only one place for that to be wrong.
   */
  function fitBox(boxWidth: number, boxHeight: number, srcWidth: number, srcHeight: number): Fit {
    if (!(srcWidth > 0) || !(srcHeight > 0) || !(boxWidth > 0) || !(boxHeight > 0)) {
      return { x: 0, y: 0, w: 0, h: 0, scale: 0 };
    }
    const scale = Math.min(boxWidth / srcWidth, boxHeight / srcHeight);
    const w = srcWidth * scale;
    const h = srcHeight * scale;
    return { x: (boxWidth - w) / 2, y: (boxHeight - h) / 2, w, h, scale };
  }

  /** A point in the editor's box → the same point as a fraction of the picture. */
  function toFraction(fit: Fit, x: number, y: number): Point {
    if (fit.w <= 0 || fit.h <= 0) return { x: 0, y: 0 };
    return { x: clamp01((x - fit.x) / fit.w), y: clamp01((y - fit.y) / fit.h) };
  }

  /** …and back, which is where the handles and the loupe are put. */
  function toBoxPoint(fit: Fit, point: Point): Point {
    return { x: fit.x + point.x * fit.w, y: fit.y + point.y * fit.h };
  }

  const WHOLE_FRAME: Corners = [
    { x: 0, y: 0 },
    { x: 1, y: 0 },
    { x: 1, y: 1 },
    { x: 0, y: 1 },
  ];

  const cross = (o: Point, a: Point, b: Point): number =>
    (a.x - o.x) * (b.y - o.y) - (a.y - o.y) * (b.x - o.x);

  const areaOf = (quad: Corners): number => {
    let sum = 0;
    for (let i = 0; i < 4; i += 1) {
      const a = quad[i];
      const b = quad[(i + 1) % 4];
      sum += a.x * b.y - b.x * a.y;
    }
    return Math.abs(sum) / 2;
  };

  /** A side shorter than this is a corner that has been dragged onto another. */
  const MIN_SIDE = 0.04;
  /** Below this the "page" is a sliver and the unwarp output is unreadable. */
  const MIN_AREA = 0.02;

  /**
   * Is this still a page-shaped quadrilateral?
   *
   * A sheet of paper photographed through a lens is convex, in bounds and not
   * degenerate. Rejecting a drag that breaks any of those — rather than letting
   * it through and handing the homography a bow-tie — is why dragging a corner
   * past its neighbour leaves the corner where it was instead of turning the
   * page inside out.
   */
  function quadOk(quad: Corners): boolean {
    let sign = 0;
    for (let i = 0; i < 4; i += 1) {
      const current = quad[i];
      if (!(current.x >= 0 && current.x <= 1 && current.y >= 0 && current.y <= 1)) return false;

      const previous = quad[(i + 3) % 4];
      const next = quad[(i + 1) % 4];

      const turn = cross(previous, current, next);
      if (turn === 0) return false;
      const way = turn > 0 ? 1 : -1;
      if (sign === 0) sign = way;
      else if (sign !== way) return false;

      if (Math.hypot(next.x - current.x, next.y - current.y) < MIN_SIDE) return false;
    }
    return areaOf(quad) >= MIN_AREA;
  }

  /** Replace one corner, or keep the quad as it was if that would break it. */
  function withCorner(quad: Corners, index: number, point: Point): Corners {
    const next = quad.slice() as Point[];
    next[index] = { x: clamp01(point.x), y: clamp01(point.y) };
    const candidate = next as unknown as Corners;
    return quadOk(candidate) ? candidate : quad;
  }

  /**
   * The same corners after the picture is turned a quarter-turn clockwise.
   *
   * Two things move at once and it is easy to do only one. Each point rotates
   * — (x, y) becomes (1 − y, x) — and the ORDER rotates with it, because the
   * array is defined as clockwise from the top-left and after the turn the old
   * bottom-left corner is the one at the top left.
   */
  function rotateCornersCW(quad: Corners): Corners {
    const turn = (point: Point): Point => ({ x: 1 - point.y, y: point.x });
    return [turn(quad[3]), turn(quad[0]), turn(quad[1]), turn(quad[2])] as Corners;
  }

  /** Frame pixels → fractions, and back. The engine works in pixels. */
  const toFractions = (quad: Quad, width: number, height: number): Corners =>
    [
      { x: clamp01(quad[0].x / width), y: clamp01(quad[0].y / height) },
      { x: clamp01(quad[1].x / width), y: clamp01(quad[1].y / height) },
      { x: clamp01(quad[2].x / width), y: clamp01(quad[2].y / height) },
      { x: clamp01(quad[3].x / width), y: clamp01(quad[3].y / height) },
    ] as Corners;

  const toPixels = (quad: Corners, width: number, height: number): Quad =>
    [
      { x: quad[0].x * width, y: quad[0].y * height },
      { x: quad[1].x * width, y: quad[1].y * height },
      { x: quad[2].x * width, y: quad[2].y * height },
      { x: quad[3].x * width, y: quad[3].y * height },
    ] as Quad;

  /** Move one item of a list to another index. Used by the page reorder. */
  function moveItem<T>(items: readonly T[], from: number, to: number): T[] {
    const out = items.slice();
    if (from < 0 || from >= out.length || to < 0 || to >= out.length || from === to) return out;
    const [item] = out.splice(from, 1);
    out.splice(to, 0, item);
    return out;
  }

  /**
   * Where to park the loupe so the hand holding the phone is not in front of it.
   *
   * Above the corner by preference, flipped below when the corner is near the
   * top of the frame, and always inside the editor.
   */
  function loupeSpot(
    handleX: number,
    handleY: number,
    boxWidth: number,
    boxHeight: number,
    size: number,
    gap: number
  ): Point {
    const above = handleY - gap - size;
    const y = above >= 0 ? above : handleY + gap;
    return {
      x: clamp(handleX - size / 2, 0, Math.max(0, boxWidth - size)),
      y: clamp(y, 0, Math.max(0, boxHeight - size)),
    };
  }

  /* ================= end pure geometry ================= */

  const root = document.querySelector<HTMLElement>('[data-scan]');

  if (root) {
    const q = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)!;

    // `<Lens data-scan-start>` does not reach the DOM — an Astro component only
    // renders the props it names, and Lens names `class` and `variant`. The
    // class does come through, so that is what this hangs on.
    const startBlock =
      root.querySelector<HTMLElement>('[data-scan-start]') ?? q<HTMLElement>('.scan__start');
    const hint = startBlock.querySelector<HTMLElement>('.scan__hint');
    const hintText = hint?.textContent ?? '';
    const intro = q('[data-scan-intro]');
    const openBtn = q<HTMLButtonElement>('[data-scan-open]');
    const stage = q('[data-scan-stage]');
    const video = q<HTMLVideoElement>('[data-scan-video]');
    const overlay = q<HTMLCanvasElement>('[data-scan-overlay]');
    const liveStatus = q('[data-scan-status]');
    const shootBtn = q<HTMLButtonElement>('[data-scan-shoot]');
    const autoBox = q<HTMLInputElement>('[data-scan-auto]');
    const stopBtn = q<HTMLButtonElement>('[data-scan-stop]');

    const retakeBar = q('[data-scan-retake]');
    const retakeLabel = q('[data-scan-retake-label]');
    const retakeCancel = q<HTMLButtonElement>('[data-scan-retake-cancel]');

    const shotsBlock = q('[data-scan-shots]');
    const countEl = q('[data-scan-count]');
    const clearBtn = q<HTMLButtonElement>('[data-scan-clear]');
    const list = q<HTMLOListElement>('[data-scan-list]');
    const finishInputs = Array.from(
      root.querySelectorAll<HTMLInputElement>('[data-scan-finish]')
    );
    const searchableBox = q<HTMLInputElement>('[data-scan-searchable]');
    const runBtn = q<HTMLButtonElement>('[data-scan-run]');
    const progress = q('[data-scan-progress]');

    const review = q<HTMLDialogElement>('[data-scan-review]');
    const reviewTitle = q('[data-review-title]');
    const reviewClose = q<HTMLButtonElement>('[data-review-close]');
    const editor = q('[data-review-editor]');
    const frameImg = q<HTMLImageElement>('[data-review-frame]');
    // Not via `q`: its constraint is HTMLElement, and an <svg> is not one.
    const quadSvg = root.querySelector<SVGSVGElement>('[data-review-quad]')!;
    const quadPoly = root.querySelector<SVGPolygonElement>('[data-review-poly]')!;
    const handles = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-review-handle]'));
    const loupe = q<HTMLCanvasElement>('[data-review-loupe]');
    const proofImg = q<HTMLImageElement>('[data-review-proof]');
    const proofNote = q('[data-review-proofnote]');
    const readout = q('[data-review-readout]');
    const wholeBtn = q<HTMLButtonElement>('[data-review-whole]');
    const detectBtn = q<HTMLButtonElement>('[data-review-detect]');
    const rotateBtn = q<HTMLButtonElement>('[data-review-rotate]');
    const earlierBtn = q<HTMLButtonElement>('[data-review-earlier]');
    const laterBtn = q<HTMLButtonElement>('[data-review-later]');
    const retakeBtn = q<HTMLButtonElement>('[data-review-retake]');
    const deleteBtn = q<HTMLButtonElement>('[data-review-delete]');

    const result = q('[data-result]');
    const notesEl = q('[data-notes]');
    const downloads = q('[data-downloads]');
    const receipt = q('[data-receipt]');
    const errorEl = q('[data-error]');

    /* ---------------------------------------------------------------- *
     * Budgets
     * ---------------------------------------------------------------- */

    /**
     * The live outline analyses a frame this big on its long edge.
     *
     * Detection is a Sobel pass, an Otsu threshold, two flood fills and a hull
     * search, all synchronous on the main thread. At 480 px that is single-digit
     * milliseconds on a laptop and around 25 ms on a mid-range phone; at the
     * sensor's own 1920 px it is most of a second, five times a second, which is
     * a hot phone and a dead battery for an outline nobody can see move that
     * precisely anyway.
     */
    const LIVE_EDGE = 480;

    /** ~5 fps. Fast enough to feel attached to the page, slow enough to idle. */
    const LIVE_INTERVAL_MS = 200;

    /** Thumbnail rehearsal size. Big enough to see the crop, small enough to be free. */
    const PREVIEW_EDGE = 560;

    /**
     * "Find the page again" analyses this much of the frame.
     *
     * Twice the rehearsal's resolution, because this one is asked for: somebody
     * has looked at a bad crop and pressed a button, so a hundred milliseconds
     * of main thread is a fair price for the detector's best answer rather than
     * its cheapest.
     */
    const DETECT_EDGE = 1024;

    /** The loupe: its diameter, how far it stands off the finger, what it shows. */
    const LOUPE_SIZE = 136;
    const LOUPE_GAP = 26;
    /** Box pixels across the magnified circle — about 4× at the default size. */
    const LOUPE_SPAN = 34;

    /** Arrow-key nudge, in editor pixels. Shift multiplies it by ten. */
    const NUDGE = 1;

    /**
     * Auto-capture rule, stated once here so it is not folded out of the code:
     *
     *   Fire when a page has been found on every poll for AUTO_STEADY_MS and no
     *   corner has drifted more than AUTO_STILL of the frame's long edge from
     *   where that corner was when the hold began. After firing, do not fire
     *   again until either the page is lost for AUTO_LOST_POLLS polls in a row,
     *   or some corner has moved AUTO_RELEASE of the long edge away from where
     *   the shot was taken.
     *
     * Measured against the anchor rather than the previous poll because a slow
     * steady creep — a hand lowering the phone — passes a poll-to-poll test
     * every time and still photographs a moving page.
     *
     * The re-arm half is the important half. Without it a phone propped over a
     * document photographs the same page every second until the list is a
     * hundred identical scans; with it, "turn the page" is the gesture that
     * takes the next shot, which is what the hands are doing anyway.
     */
    const AUTO_STEADY_MS = 900;
    const AUTO_STILL = 0.012;
    const AUTO_RELEASE = 0.06;
    const AUTO_LOST_POLLS = 3;

    /* ---------------------------------------------------------------- *
     * Lazily-loaded pixel engine
     * ---------------------------------------------------------------- */

    type Engine = typeof import('../lib/pdf/scan');

    let engine: Engine | null = null;
    let engineLoad: Promise<Engine> | null = null;

    /**
     * Deferred to the first camera click on purpose.
     *
     * scan.ts reaches the image helpers and through them pdf-lib. A tool page
     * has to paint its heading and its buttons from static HTML with nothing on
     * the critical path, so this chunk is fetched at the moment someone asks for
     * the camera and not a moment earlier.
     */
    function loadEngine(): Promise<Engine> {
      engineLoad ??= import('../lib/pdf/scan').then((module) => {
        engine = module;
        return module;
      });
      return engineLoad;
    }

    /* ---------------------------------------------------------------- *
     * Canvas helpers
     * ---------------------------------------------------------------- */

    type AnyCanvas = OffscreenCanvas | HTMLCanvasElement;
    type Any2D = OffscreenCanvasRenderingContext2D | CanvasRenderingContext2D;
    interface Pad {
      canvas: AnyCanvas;
      ctx: Any2D;
    }

    /**
     * A drawing surface that is never in the document.
     *
     * OffscreenCanvas where it exists — it skips the compositor entirely, which
     * is the whole point when the surface is read back and thrown away five
     * times a second. A detached `<canvas>` is the same pixels for older Safari.
     */
    function pad(width: number, height: number): Pad | null {
      const w = Math.max(1, Math.round(width));
      const h = Math.max(1, Math.round(height));
      const canvas: AnyCanvas =
        typeof OffscreenCanvas === 'function'
          ? new OffscreenCanvas(w, h)
          : document.createElement('canvas');
      canvas.width = w;
      canvas.height = h;
      const ctx = (canvas as HTMLCanvasElement).getContext('2d', {
        willReadFrequently: true,
      }) as Any2D | null;
      return ctx ? { canvas, ctx } : null;
    }

    /** Draw a source down to `maxEdge` and read the pixels back as an ImageLike. */
    function frameOf(
      source: CanvasImageSource,
      sourceWidth: number,
      sourceHeight: number,
      maxEdge: number,
      surface?: Pad
    ): ImageLike | null {
      const scale = Math.min(1, maxEdge / Math.max(sourceWidth, sourceHeight));
      const width = Math.max(1, Math.round(sourceWidth * scale));
      const height = Math.max(1, Math.round(sourceHeight * scale));

      const target = surface ?? pad(width, height);
      if (!target) return null;
      if (target.canvas.width !== width || target.canvas.height !== height) {
        target.canvas.width = width;
        target.canvas.height = height;
      }

      target.ctx.imageSmoothingEnabled = true;
      target.ctx.imageSmoothingQuality = 'medium';
      target.ctx.drawImage(source, 0, 0, width, height);
      return target.ctx.getImageData(0, 0, width, height);
    }

    async function toBlob(canvas: AnyCanvas, type: string, quality?: number): Promise<Blob> {
      if ('convertToBlob' in canvas) {
        return canvas.convertToBlob(quality === undefined ? { type } : { type, quality });
      }
      return new Promise((resolve, reject) => {
        canvas.toBlob(
          (blob) => (blob ? resolve(blob) : reject(new Error('This browser could not encode the frame.'))),
          type,
          quality
        );
      });
    }

    /** Let the browser paint before a long synchronous stretch. */
    const paint = (): Promise<void> =>
      new Promise((resolve) => requestAnimationFrame(() => resolve()));

    /* ---------------------------------------------------------------- *
     * Messages
     * ---------------------------------------------------------------- */

    function fail(message: string): void {
      errorEl.textContent = message;
      errorEl.hidden = false;
    }

    const clearError = (): void => {
      errorEl.hidden = true;
      errorEl.textContent = '';
    };

    /**
     * The status line is `aria-live`, and the poll runs five times a second.
     * Writing the same sentence into it repeatedly is silent for a sighted user
     * and a stutter for a screen reader, so only real changes are written.
     */
    const say = (message: string): void => {
      if (liveStatus.textContent !== message) liveStatus.textContent = message;
    };

    /**
     * Offer the file picker as a way through.
     *
     * Appended rather than always present, because a permanent "or pick a file"
     * next to a camera button is noise for the nine people in ten whose camera
     * works. It is built once and reused.
     */
    let picker: HTMLInputElement | null = null;
    let pickerBtn: HTMLButtonElement | null = null;

    function offerPicker(label: string): void {
      if (!picker) {
        picker = document.createElement('input');
        picker.type = 'file';
        picker.accept = 'image/*';
        picker.multiple = true;
        picker.className = 'scan__picker-input';
        picker.addEventListener('change', () => {
          const chosen = Array.from(picker?.files ?? []);
          if (picker) picker.value = '';
          void addPhotos(chosen);
        });

        pickerBtn = document.createElement('button');
        pickerBtn.type = 'button';
        pickerBtn.className = 'btn btn--quiet scan__picker';
        pickerBtn.addEventListener('click', () => picker?.click());

        // Inside the lens BODY, not the lens root. The frost and rim layers
        // paint above any non-positioned sibling, so appending to the root put
        // the only way out of a no-camera dead end underneath the glass.
        const body = startBlock.querySelector('.lens__body') ?? startBlock;
        body.append(picker, pickerBtn);
      }
      if (pickerBtn) pickerBtn.textContent = label;
    }

    /* ---------------------------------------------------------------- *
     * Camera lifecycle
     * ---------------------------------------------------------------- */

    let stream: MediaStream | null = null;
    let loop = 0;
    let lastPoll = 0;
    /** Has the camera ever been on? Only changes the wording of the button. */
    let used = false;

    /**
     * Stop every track and forget the stream.
     *
     * Called from the stop button, from `pagehide`, from the tab going into the
     * background and from a view-transition swap. A camera indicator still lit
     * after someone has navigated away is unacceptable anywhere and absurd on a
     * site whose entire claim is that nothing leaves the device, so this is
     * deliberately over-subscribed: stopping twice costs nothing, stopping never
     * costs trust.
     */
    /**
     * Bumped by every stop, and captured by every start.
     *
     * getUserMedia can be waiting on a permission prompt for as long as
     * someone takes to answer it, and until it resolves `stream` is still
     * null — so stopCamera had nothing to stop and every teardown guarded on
     * `stream` was a no-op. Leaving the page mid-prompt therefore armed a
     * camera that switched on afterwards, attached itself to a video nobody
     * was looking at, and started polling. On this site of all sites that is
     * the one bug that must not exist.
     */
    let cameraEpoch = 0;

    function stopCamera(message = ''): void {
      cameraEpoch += 1;
      if (loop) cancelAnimationFrame(loop);
      loop = 0;

      for (const track of stream?.getTracks() ?? []) track.stop();
      stream = null;

      video.srcObject = null;
      overlay.getContext('2d')?.clearRect(0, 0, overlay.width, overlay.height);

      stage.hidden = true;
      startBlock.hidden = false;
      openBtn.disabled = false;
      openBtn.textContent = used ? 'Turn the camera back on' : 'Turn on the camera';
      say('');
      // The stage is hidden by now, so anything said there would be said to
      // nobody; the line under the button is the one still on screen.
      if (hint) hint.textContent = message || hintText;

      resetAuto();
    }

    async function startCamera(): Promise<void> {
      clearError();
      progress.textContent = '';

      if (!navigator.mediaDevices?.getUserMedia) {
        fail(
          'This browser will not open a camera on this page. Cameras need a secure (https) connection — you can still pick photos you have already taken.'
        );
        offerPicker('Pick photos instead');
        return;
      }

      openBtn.disabled = true;
      openBtn.textContent = 'Waiting for permission…';

      // The engine fetch and the permission prompt are independent; run them
      // together so the outline is ready the moment the feed is.
      const engineReady = loadEngine();
      const epoch = cameraEpoch;
      let opened: MediaStream;

      try {
        opened = await navigator.mediaDevices.getUserMedia({
          video: {
            // `ideal`, never `exact`: a laptop has no rear camera and an `exact`
            // facingMode there is an OverconstrainedError instead of a webcam.
            facingMode: { ideal: 'environment' },
            width: { ideal: 1920 },
            height: { ideal: 1440 },
          },
        });
      } catch (error) {
        openBtn.disabled = false;
        openBtn.textContent = 'Turn on the camera';
        // A refusal that arrives after the user gave up on it is not news.
        if (epoch === cameraEpoch) describeCameraFailure(error);
        return;
      }

      // The session this belongs to is over — someone stopped the camera, or
      // left the page, while the permission prompt was still up. Release the
      // hardware immediately and show nothing.
      if (epoch !== cameraEpoch) {
        for (const track of opened.getTracks()) track.stop();
        return;
      }

      stream = opened;

      // Reveal the stage BEFORE attaching the stream and BEFORE awaiting
      // anything. The video sits inside it, `hidden` resolves to
      // `display: none !important` here, and Chromium never settles play() on
      // an element it is not rendering — so awaiting play() while the stage is
      // still hidden waits for a reveal that the await itself is blocking.
      // The camera came on, the feed never appeared, and the button stayed
      // disabled saying "Waiting for permission…" forever.
      used = true;
      startBlock.hidden = true;
      // The three steps have happened by the time the feed is up; leaving them
      // there just pushes the viewfinder down the screen.
      intro.hidden = true;
      stage.hidden = false;
      openBtn.disabled = false;
      // Put the label back. The start block is hidden now, but it comes back
      // when the camera is turned off, and a button reading "Waiting for
      // permission…" when nothing is pending is a small lie.
      openBtn.textContent = 'Turn on the camera';

      video.srcObject = stream;
      try {
        await video.play();
      } catch {
        // Autoplay refusal on a muted inline video is rare but survivable: the
        // element is in the document and will start on the next interaction.
      }

      // The outline needs the engine; the FEED does not. Loading it must never
      // hold up the picture, and failing to load it must not take the tool
      // down with it — capture without edge detection is still a scanner.
      void engineReady.catch(() => {
        say('Page detection is unavailable, so captures will use the whole frame.');
      });
      if (hint) hint.textContent = hintText;
      say(
        retakeTarget
          ? 'Camera on. Line up the page you are reshooting.'
          : 'Camera on. Nothing is being recorded or uploaded — looking for a page…'
      );

      fitOverlay();
      resetAuto();
      lastPoll = 0;
      loop = requestAnimationFrame(tick);
    }

    /** Say which thing went wrong, and what can be done about that thing. */
    function describeCameraFailure(error: unknown): void {
      const name = error instanceof DOMException ? error.name : '';

      if (name === 'NotAllowedError' || name === 'SecurityError') {
        fail(
          'The camera stayed off because permission was refused. That is a fine answer — if you change your mind, allow the camera in the address bar and press the button again. Photos you have already taken work just as well.'
        );
        offerPicker('Pick photos instead');
        return;
      }

      if (name === 'NotFoundError' || name === 'OverconstrainedError') {
        fail(
          'No camera was found on this device. You can still make a scan from photos you already have.'
        );
        offerPicker('Pick photos instead');
        return;
      }

      if (name === 'NotReadableError' || name === 'AbortError' || name === 'TrackStartError') {
        fail(
          'Another app is holding the camera. Close whatever is using it — a video call is the usual culprit — and press the button again.'
        );
        offerPicker('Pick photos instead');
        return;
      }

      fail('The camera would not start. Nothing was captured. You can pick photos instead.');
      offerPicker('Pick photos instead');
    }

    /* ---------------------------------------------------------------- *
     * The viewfinder outline
     * ---------------------------------------------------------------- */

    let livePad: Pad | null = null;
    let outlineColour = '';

    /**
     * Match the overlay's backing store to the box it is stretched over.
     *
     * The canvas is `inset: 0` inside the viewport, so its CSS box is the video
     * element's box. Its *pixel* size is a separate number, and if it is left at
     * the 300×150 default the browser stretches those pixels over the box: the
     * outline lands somewhere near the page and drifts as the layout changes.
     */
    function fitOverlay(): void {
      const box = video.getBoundingClientRect();
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      const width = Math.max(1, Math.round(box.width * dpr));
      const height = Math.max(1, Math.round(box.height * dpr));
      if (overlay.width !== width || overlay.height !== height) {
        overlay.width = width;
        overlay.height = height;
      }
    }

    /**
     * Where the picture actually sits inside the element.
     *
     * `object-fit: contain` plus `max-height` means the feed is letterboxed the
     * moment a tall frame meets a short viewport. Drawing as though the picture
     * filled the element puts the outline in the black bars.
     */
    function pictureBox(): Fit | null {
      const vw = video.videoWidth;
      const vh = video.videoHeight;
      if (!vw || !vh || !overlay.width || !overlay.height) return null;
      return fitBox(overlay.width, overlay.height, vw, vh);
    }

    /** `analysisScale` is analysis pixels per video pixel, so its inverse maps back. */
    function drawOutline(quad: Quad | null, analysisScale: number): void {
      const ctx = overlay.getContext('2d');
      if (!ctx) return;
      ctx.clearRect(0, 0, overlay.width, overlay.height);

      const box = pictureBox();
      if (!quad || !box || analysisScale <= 0) return;

      // Read from the tokens rather than picking a colour here — custom
      // properties inherit, so the overlay resolves the same --accent the rest
      // of the page uses. The literal is only reached if it has not resolved.
      outlineColour ||= getComputedStyle(overlay).getPropertyValue('--accent').trim() || '#e11d48';

      const to = (point: Point) => ({
        x: box.x + (point.x / analysisScale) * box.scale,
        y: box.y + (point.y / analysisScale) * box.scale,
      });

      const corners = [to(quad[0]), to(quad[1]), to(quad[2]), to(quad[3])];

      ctx.beginPath();
      ctx.moveTo(corners[0].x, corners[0].y);
      for (let i = 1; i < 4; i += 1) ctx.lineTo(corners[i].x, corners[i].y);
      ctx.closePath();

      ctx.fillStyle = 'rgb(255 255 255 / 0.14)';
      ctx.fill();
      ctx.lineWidth = Math.max(2, overlay.width / 320);
      ctx.lineJoin = 'round';
      ctx.strokeStyle = outlineColour;
      ctx.stroke();

      const dot = ctx.lineWidth * 1.8;
      ctx.fillStyle = outlineColour;
      for (const corner of corners) {
        ctx.beginPath();
        ctx.arc(corner.x, corner.y, dot, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    /* ---------------------------------------------------------------- *
     * Auto-capture
     * ---------------------------------------------------------------- */

    /** Corners in fractions of the frame's long edge, so the rule is resolution-free. */
    let steadyQuad: Point[] | null = null;
    let steadySince = 0;
    let shotQuad: Point[] | null = null;
    let lostPolls = 0;

    function resetAuto(): void {
      steadyQuad = null;
      steadySince = 0;
      shotQuad = null;
      lostPolls = 0;
    }

    const drift = (a: Point[], b: Point[]): number => {
      let worst = 0;
      for (let i = 0; i < 4; i += 1) worst = Math.max(worst, Math.hypot(a[i].x - b[i].x, a[i].y - b[i].y));
      return worst;
    };

    /* ---------------------------------------------------------------- *
     * The poll
     * ---------------------------------------------------------------- */

    let capturing = false;

    /**
     * requestAnimationFrame with a time gate, not setInterval.
     *
     * rAF stops when the tab is hidden, so a backgrounded tab does no detection
     * work at all; setInterval would keep grinding a frame that nobody can see.
     */
    function tick(now: number): void {
      loop = requestAnimationFrame(tick);
      if (now - lastPoll < LIVE_INTERVAL_MS) return;
      lastPoll = now;

      if (!engine || !stream || video.readyState < 2 || !video.videoWidth) return;

      fitOverlay();

      livePad ??= pad(LIVE_EDGE, LIVE_EDGE);
      if (!livePad) return;

      const image = frameOf(video, video.videoWidth, video.videoHeight, LIVE_EDGE, livePad);
      if (!image) return;

      const analysisScale = image.width / video.videoWidth;
      const found = engine.detectPageQuad(image);
      drawOutline(found?.quad ?? null, analysisScale);

      if (!found) {
        say('Looking for a page — try a background a different shade from the paper.');
        steadyQuad = null;
        steadySince = 0;
        lostPolls += 1;
        // Losing the page for a moment is how someone signals they have moved on
        // to the next sheet, so that is what re-arms auto-capture.
        if (lostPolls >= AUTO_LOST_POLLS) shotQuad = null;
        return;
      }

      lostPolls = 0;

      const long = Math.max(image.width, image.height);
      const corners = found.quad.map((point) => ({ x: point.x / long, y: point.y / long }));

      if (shotQuad && drift(corners, shotQuad) > AUTO_RELEASE) shotQuad = null;

      const still = steadyQuad !== null && drift(corners, steadyQuad) <= AUTO_STILL;
      if (!still) {
        steadyQuad = corners;
        steadySince = now;
      }

      const heldFor = now - steadySince;
      const ready = still && heldFor >= AUTO_STEADY_MS;

      if (!autoBox.checked) {
        say('Page found — press Capture when it looks right.');
      } else if (shotQuad) {
        say('Captured. Turn the page for the next one.');
      } else if (ready) {
        say('Capturing…');
      } else {
        say(still ? 'Hold steady…' : 'Page found — hold still.');
      }

      if (autoBox.checked && ready && !shotQuad && !capturing) {
        shotQuad = corners;
        void capture();
      }
    }

    /* ---------------------------------------------------------------- *
     * Shots
     * ---------------------------------------------------------------- */

    interface Shot {
      id: number;
      /** The frame as it is encoded now. This is what the worker gets. */
      bytes: ArrayBuffer;
      type: string;
      /** Pixel size of those bytes. Follows a rotation. */
      width: number;
      height: number;
      /**
       * The page inside the frame, in fractions of it, or null for "no idea".
       * Fractions rather than pixels because every stage of this — the 560 px
       * rehearsal, the editor at whatever size the window happens to be, the
       * worker's 2600 px working copy — is a different resolution of the same
       * frame, and a fraction survives all of them unchanged.
       */
      quad: Corners | null;
      /** Did a person put those corners there? Only then are they sent. */
      manual: boolean;
      /** Preview object URL. Revoked when the shot goes. */
      url: string;
      /** Did the rehearsal end up with a page rather than the whole frame? */
      detected: boolean;
      node: HTMLLIElement;
    }

    let shots: Shot[] = [];
    let nextId = 1;
    /** The page the next capture replaces, instead of appending. */
    let retakeTarget: Shot | null = null;

    /** The one control that decides how a page comes out. */
    type Finish = ScanMode | 'photo';

    const finish = (): Finish => {
      const chosen = finishInputs.find((input) => input.checked);
      return (chosen?.value as Finish) ?? 'text';
    };

    /** `photo` is not a scan mode; it is the absence of one. */
    const mode = (): ScanMode => {
      const chosen = finish();
      return chosen === 'photo' ? 'text' : chosen;
    };

    const cleaning = (): boolean => finish() !== 'photo';

    /**
     * The rehearsal: crop, unwarp, clean, at thumbnail size.
     *
     * Detection here runs on a 560 px copy where the worker uses 1024, so this
     * is the more pessimistic of the two — it will occasionally miss an edge the
     * real pass finds. That is the right way round for a preview: it never
     * promises a crop it cannot deliver. When corners are handed in, nothing is
     * detected at all and the preview is exactly the crop that was asked for.
     */
    /** What a rehearsal produces: the picture, where it decided the page was, and whether it found one. */
    type Preview = { blob: Blob; quad: Corners | null; detected: boolean };

    async function rehearse(
      source: CanvasImageSource,
      width: number,
      height: number,
      corners: Corners | null
    ): Promise<Preview | null> {
      const module = engine ?? (await loadEngine());

      const image = frameOf(source, width, height, PREVIEW_EDGE);
      if (!image) return null;

      if (!cleaning()) {
        // "Photo, unchanged" means the photograph goes into the PDF as it is,
        // so the preview has to be the photograph as it is.
        const plain = pad(image.width, image.height);
        if (!plain) return null;
        plain.ctx.putImageData(new ImageData(image.data, image.width, image.height), 0, 0);
        return { blob: await toBlob(plain.canvas, 'image/jpeg', 0.82), quad: corners, detected: false };
      }

      await paint();

      let quad = corners;
      if (!quad) {
        const found = module.detectPageQuad(image);
        quad = found ? toFractions(found.quad, image.width, image.height) : null;
      }

      const page = quad ? module.unwarp(image, toPixels(quad, image.width, image.height)) : null;
      const flat = page ?? image;

      await paint();

      const cleaned =
        mode() === 'text' ? module.sauvola(flat) : module.flattenIllumination(flat, mode() === 'colour');

      const surface = pad(cleaned.width, cleaned.height);
      if (!surface) return null;
      surface.ctx.putImageData(new ImageData(cleaned.data, cleaned.width, cleaned.height), 0, 0);

      // Bilevel output is runs of black and white: PNG is both smaller and
      // exact, where JPEG would ring around every stroke.
      const text = mode() === 'text';
      return {
        blob: await toBlob(surface.canvas, text ? 'image/png' : 'image/jpeg', text ? undefined : 0.82),
        quad,
        detected: page !== null,
      };
    }

    /** Detection on its own, at the resolution somebody asking for it deserves. */
    async function findPage(shot: Shot): Promise<Corners | null> {
      const module = engine ?? (await loadEngine());
      const bitmap = await createImageBitmap(new Blob([shot.bytes], { type: shot.type }));
      try {
        const image = frameOf(bitmap, bitmap.width, bitmap.height, DETECT_EDGE);
        if (!image) return null;
        const found = module.detectPageQuad(image);
        return found ? toFractions(found.quad, image.width, image.height) : null;
      } finally {
        bitmap.close();
      }
    }

    function shotNode(shot: Shot): HTMLLIElement {
      const li = document.createElement('li');
      li.className = 'scan__shot';

      // The thumbnail IS the button. A page you cannot open is a page you find
      // out about after the PDF is written, which is the failure this whole
      // review path exists to stop.
      const open = document.createElement('button');
      open.type = 'button';
      open.className = 'scan__shot-open';
      open.dataset.scanPage = '';

      const img = document.createElement('img');
      img.src = shot.url;
      img.alt = '';
      img.decoding = 'async';

      const badge = document.createElement('span');
      badge.className = 'scan__shot-badge';
      badge.dataset.badge = '';

      open.append(img, badge);
      open.addEventListener('click', () => void openReview(shot));

      const bar = document.createElement('div');
      bar.className = 'scan__shot-bar';

      const note = document.createElement('span');
      note.className = 'scan__shot-note';
      note.dataset.label = '';

      const moves = document.createElement('span');
      moves.className = 'scan__shot-moves';

      const button = (text: string, run: () => void, move: string): HTMLButtonElement => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'scan__step';
        btn.textContent = text;
        btn.dataset.move = move;
        btn.addEventListener('click', run);
        return btn;
      };

      // Move buttons rather than drag-and-drop. This tool's primary device is a
      // phone held in one hand: a drag target inside a scrolling grid fights the
      // scroll, and the buttons are reachable by keyboard and screen reader for
      // free, which a pointer drag is not.
      const earlier = button('←', () => move(shot, -1, earlier), '-1');
      const later = button('→', () => move(shot, 1, later), '1');
      const remove = button('✕', () => drop(shot), 'drop');

      moves.append(earlier, later, remove);
      bar.append(note, moves);
      li.append(open, bar);
      return li;
    }

    /** What the caption says about a page, in three words or so. */
    const shotNote = (shot: Shot): string => {
      if (!cleaning()) return 'as shot';
      if (shot.manual) return 'corners set';
      return shot.detected ? 'edges found' : 'whole frame';
    };

    function render(): void {
      list.replaceChildren(...shots.map((shot) => shot.node));

      shots.forEach((shot, index) => {
        const badge = shot.node.querySelector<HTMLElement>('[data-badge]');
        if (badge) badge.textContent = String(index + 1);

        const label = shot.node.querySelector<HTMLElement>('[data-label]');
        if (label) label.textContent = shotNote(shot);

        const open = shot.node.querySelector<HTMLButtonElement>('[data-scan-page]');
        if (open) {
          open.setAttribute(
            'aria-label',
            `Open page ${index + 1} of ${shots.length} to check its corners, turn it, reshoot it or remove it`
          );
        }

        const img = shot.node.querySelector('img');
        if (img) img.alt = `Preview of captured page ${index + 1}`;

        const earlier = shot.node.querySelector<HTMLButtonElement>('[data-move="-1"]');
        if (earlier) {
          earlier.disabled = index === 0;
          earlier.setAttribute('aria-label', `Move page ${index + 1} earlier`);
        }
        const later = shot.node.querySelector<HTMLButtonElement>('[data-move="1"]');
        if (later) {
          later.disabled = index === shots.length - 1;
          later.setAttribute('aria-label', `Move page ${index + 1} later`);
        }
        const remove = shot.node.querySelector<HTMLButtonElement>('[data-move="drop"]');
        if (remove) remove.setAttribute('aria-label', `Remove page ${index + 1}`);
      });

      const n = shots.length;
      countEl.textContent = n === 0 ? 'No pages yet' : `${n} page${n === 1 ? '' : 's'} captured`;
      shotsBlock.hidden = n === 0;
      runBtn.disabled = n === 0;

      if (reviewing) updateReviewHead();
    }

    function move(shot: Shot, delta: number, focus?: HTMLElement): void {
      const from = shots.indexOf(shot);
      if (from < 0) return;
      shots = moveItem(shots, from, from + delta);
      render();
      // replaceChildren detaches and re-inserts, which drops focus. Put it back
      // so a keyboard user can press the same key again.
      focus?.focus();
    }

    function drop(shot: Shot): void {
      if (reviewing === shot) closeReview();
      URL.revokeObjectURL(shot.url);
      shots = shots.filter((item) => item !== shot);
      if (retakeTarget === shot) {
        retakeTarget = null;
        updateRetakeBar();
      }
      render();
    }

    function discardAll(): void {
      closeReview();
      for (const shot of shots) URL.revokeObjectURL(shot.url);
      shots = [];
      retakeTarget = null;
      updateRetakeBar();
      result.hidden = true;
      render();
    }

    /** Hand a freshly rehearsed preview to a shot, thumbnail and all. */
    function applyPreview(
      shot: Shot,
      preview: { blob: Blob; quad: Corners | null; detected: boolean }
    ): void {
      URL.revokeObjectURL(shot.url);
      shot.url = URL.createObjectURL(preview.blob);
      shot.detected = preview.detected;
      if (!shot.manual) shot.quad = preview.quad;
      const img = shot.node.querySelector('img');
      if (img) img.src = shot.url;
    }

    /** One captured frame becomes one shot — or replaces the one being retaken. */
    async function keep(
      bytes: ArrayBuffer,
      type: string,
      source: CanvasImageSource,
      width: number,
      height: number
    ): Promise<void> {
      // A preview that cannot be built is a cosmetic failure. Falling back to
      // the frame itself keeps the capture — throwing away a photograph of
      // someone's passport because the thumbnail would not encode is not a
      // trade this tool gets to make.
      const preview = await rehearse(source, width, height, null).catch(() => null);
      const blob = preview?.blob ?? new Blob([bytes], { type });

      const target = retakeTarget;
      retakeTarget = null;
      updateRetakeBar();

      if (target && shots.includes(target)) {
        URL.revokeObjectURL(target.url);
        target.bytes = bytes;
        target.type = type;
        target.width = width;
        target.height = height;
        target.url = URL.createObjectURL(blob);
        // A retake is a new photograph: the corners of the old one described a
        // page that is no longer in the frame.
        target.quad = preview?.quad ?? null;
        target.manual = false;
        target.detected = preview?.detected ?? false;
        const img = target.node.querySelector('img');
        if (img) img.src = target.url;
        render();
        return;
      }

      const shot: Shot = {
        id: nextId++,
        bytes,
        type,
        width,
        height,
        quad: preview?.quad ?? null,
        manual: false,
        url: URL.createObjectURL(blob),
        detected: preview?.detected ?? false,
        node: document.createElement('li'),
      };
      shot.node = shotNode(shot);
      shots.push(shot);
      render();
    }

    async function capture(): Promise<void> {
      if (capturing || !stream || !video.videoWidth) return;
      capturing = true;
      shootBtn.disabled = true;
      clearError();

      try {
        const full = pad(video.videoWidth, video.videoHeight);
        if (!full) throw new Error('no surface');
        full.ctx.drawImage(video, 0, 0, full.canvas.width, full.canvas.height);

        // 0.92 rather than lossless: the worker resamples and re-encodes anyway,
        // and a 12 MP PNG per shot would be tens of megabytes held in the tab.
        const blob = await toBlob(full.canvas, 'image/jpeg', 0.92);
        const bytes = await blob.arrayBuffer();

        say(retakeTarget ? 'Replaced.' : 'Captured.');
        await keep(bytes, 'image/jpeg', full.canvas, full.canvas.width, full.canvas.height);

        // Release the full-resolution surface; on a phone it is 50 MB of RGBA.
        full.canvas.width = full.canvas.height = 1;
      } catch {
        fail('That frame could not be captured. Nothing was kept — try again.');
      } finally {
        capturing = false;
        shootBtn.disabled = false;
      }
    }

    /** The permission-refused path: photos that already exist on the device. */
    async function addPhotos(files: File[]): Promise<void> {
      if (files.length === 0) return;
      clearError();

      let rejected = 0;

      for (const file of files) {
        let bitmap: ImageBitmap | null = null;
        try {
          bitmap = await createImageBitmap(file);
          const bytes = await file.arrayBuffer();
          await keep(bytes, file.type || 'image/jpeg', bitmap, bitmap.width, bitmap.height);
        } catch {
          // Counted, never named. A filename is document content under this
          // project's privacy rule, and it does not belong in the interface any
          // more than it belongs in a log.
          rejected += 1;
        } finally {
          bitmap?.close();
        }
      }

      if (rejected > 0) {
        fail(
          `${rejected} photo${rejected === 1 ? '' : 's'} could not be opened in this browser. HEIC photos from an iPhone usually need converting to JPEG first.`
        );
      }
    }

    /**
     * Rebuild thumbnails after the finish is changed, or after one page's
     * corners are moved.
     *
     * A preview that no longer matches what the button will produce is worse
     * than no preview. Rebuilt one at a time with a frame between each so a
     * dozen pages does not freeze the page; a second change cancels the first.
     */
    let restyleToken = 0;

    async function restyleShots(only?: Shot): Promise<void> {
      const wanted = only ? [only] : shots.slice();
      if (wanted.length === 0) return;
      const token = ++restyleToken;
      if (!only) progress.textContent = 'Updating the previews…';

      for (const shot of wanted) {
        if (token !== restyleToken) return;
        try {
          const bitmap = await createImageBitmap(new Blob([shot.bytes], { type: shot.type }));
          // finally, not a plain statement: a rehearse that throws would
          // otherwise pin a full-resolution decoded surface, and this loop runs
          // once per captured page.
          let preview: Preview | null = null;
          try {
            preview = await rehearse(bitmap, bitmap.width, bitmap.height, shot.quad);
          } finally {
            bitmap.close();
          }
          if (token !== restyleToken) return;
          if (preview) applyPreview(shot, preview);
        } catch {
          // A shot whose preview cannot be rebuilt keeps the old one. The bytes
          // are untouched, so the PDF is unaffected either way.
        }
        await paint();
      }

      if (token === restyleToken) {
        render();
        if (!only) progress.textContent = '';
      }
    }

    /* ---------------------------------------------------------------- *
     * Retake
     * ---------------------------------------------------------------- */

    function updateRetakeBar(): void {
      const target = retakeTarget;
      if (!target) {
        retakeBar.hidden = true;
        retakeLabel.textContent = '';
        return;
      }
      const number = shots.indexOf(target) + 1;
      retakeLabel.textContent = `Reshooting page ${number}. The next photo you take replaces it; every other page is kept.`;
      retakeBar.hidden = false;
    }

    function startRetake(shot: Shot): void {
      retakeTarget = shot;
      closeReview();
      updateRetakeBar();
      if (stream) {
        say('Line up that page again — the next capture replaces it.');
      } else if (hint) {
        hint.textContent = 'Turn the camera on to reshoot that page. Everything else is kept.';
      }
      (stream ? shootBtn : openBtn).focus();
    }

    /* ---------------------------------------------------------------- *
     * Per-page review and the corner editor
     * ---------------------------------------------------------------- */

    let reviewing: Shot | null = null;
    /** The working corners. Written straight back to the shot on every change. */
    let working: Corners = WHOLE_FRAME;
    let fit: Fit = { x: 0, y: 0, w: 0, h: 0, scale: 0 };
    let reviewUrl = '';
    let proofUrl = '';
    let proofToken = 0;
    let dragging = -1;
    let nudgeTimer = 0;

    const CORNER_NAMES = ['Top left', 'Top right', 'Bottom right', 'Bottom left'];

    function updateReviewHead(): void {
      const shot = reviewing;
      if (!shot) return;
      const index = shots.indexOf(shot);
      reviewTitle.textContent = `Page ${index + 1} of ${shots.length}`;
      earlierBtn.disabled = index <= 0;
      laterBtn.disabled = index < 0 || index >= shots.length - 1;
    }

    /**
     * "Photo, unchanged" has no geometry to edit — the frame goes in whole —
     * so the corners are taken away rather than left there doing nothing.
     */
    function updateReviewMode(): void {
      const editable = cleaning();
      for (const handle of handles) handle.disabled = !editable;
      // `hidden` as an attribute rather than a property: SVGElement does not
      // carry the property, and the global [hidden] rule covers both anyway.
      if (editable) quadSvg.removeAttribute('hidden');
      else quadSvg.setAttribute('hidden', '');
      wholeBtn.disabled = !editable;
      detectBtn.disabled = !editable;
      loupe.hidden = true;
    }

    function layoutEditor(): void {
      const shot = reviewing;
      if (!shot) return;

      const width = frameImg.naturalWidth || shot.width;
      const height = frameImg.naturalHeight || shot.height;
      fit = fitBox(editor.clientWidth, editor.clientHeight, width, height);
      if (fit.w <= 0) return;

      const px = (n: number): string => `${n}px`;
      frameImg.style.left = px(fit.x);
      frameImg.style.top = px(fit.y);
      frameImg.style.width = px(fit.w);
      frameImg.style.height = px(fit.h);

      quadSvg.style.left = px(fit.x);
      quadSvg.style.top = px(fit.y);
      quadSvg.style.width = px(fit.w);
      quadSvg.style.height = px(fit.h);

      placeHandles();
      labelHandles();
    }

    function placeHandles(): void {
      // The viewBox is 0–100 in both axes and the aspect is not preserved, so a
      // fraction is a percentage and no pixel arithmetic is needed here at all.
      quadPoly.setAttribute(
        'points',
        working.map((point) => `${point.x * 100},${point.y * 100}`).join(' ')
      );

      handles.forEach((handle, index) => {
        const spot = toBoxPoint(fit, working[index]);
        handle.style.left = `${spot.x}px`;
        handle.style.top = `${spot.y}px`;
      });
    }

    /**
     * The labels carry the position, so they are rewritten when the position
     * has settled — not sixty times a second mid-drag, which is a screen reader
     * reading a number that has already changed.
     */
    function labelHandles(): void {
      handles.forEach((handle, index) => {
        handle.setAttribute(
          'aria-label',
          `${CORNER_NAMES[index]} corner, ${Math.round(working[index].x * 100)}% across and ${Math.round(working[index].y * 100)}% down. Drag it, or nudge it with the arrow keys.`
        );
      });
    }

    /** Take the corners as the user's own, and show what they produce. */
    function setCorners(next: Corners, manual: boolean): void {
      const shot = reviewing;
      if (!shot) return;
      working = next;
      shot.quad = next;
      shot.manual = manual;
      placeHandles();
      // Deliberately no render() here. This runs on every pointermove, and
      // render() calls replaceChildren over the whole list; the caption that
      // needs to change ("corners set") is repainted when the drag ends and
      // the new preview lands, a frame or two later.
    }

    function moveCorner(index: number, point: Point, announce: boolean): void {
      const next = withCorner(working, index, point);
      if (next === working) {
        // Refused, so say so. A corner that stops dead under the finger with no
        // explanation reads as a broken drag rather than a guard rail.
        readout.textContent =
          'A page cannot fold over itself, so that corner stopped where it was. Move the corner next to it first.';
        return;
      }
      setCorners(next, true);
      if (announce) {
        labelHandles();
        readout.textContent = `${CORNER_NAMES[index]}: ${Math.round(next[index].x * 100)}% across, ${Math.round(next[index].y * 100)}% down.`;
      }
    }

    /**
     * The loupe.
     *
     * The source square is clamped to stay inside the frame and the crosshair
     * is offset by however far it had to move, so a corner dropped in the very
     * corner of the photograph is still shown under the cross rather than
     * drifting off-centre as the sample rectangle is clipped.
     */
    function showLoupe(index: number): void {
      const shot = reviewing;
      const ctx = loupe.getContext('2d');
      if (!shot || !ctx || !frameImg.naturalWidth || fit.scale <= 0) return;

      const spot = loupeSpot(
        toBoxPoint(fit, working[index]).x,
        toBoxPoint(fit, working[index]).y,
        editor.clientWidth,
        editor.clientHeight,
        LOUPE_SIZE,
        LOUPE_GAP
      );
      loupe.style.left = `${spot.x}px`;
      loupe.style.top = `${spot.y}px`;
      loupe.hidden = false;

      const span = LOUPE_SPAN / fit.scale;
      const sx = working[index].x * frameImg.naturalWidth;
      const sy = working[index].y * frameImg.naturalHeight;
      const cx = clamp(sx, span / 2, Math.max(span / 2, frameImg.naturalWidth - span / 2));
      const cy = clamp(sy, span / 2, Math.max(span / 2, frameImg.naturalHeight - span / 2));

      ctx.clearRect(0, 0, LOUPE_SIZE, LOUPE_SIZE);
      ctx.drawImage(frameImg, cx - span / 2, cy - span / 2, span, span, 0, 0, LOUPE_SIZE, LOUPE_SIZE);

      const zoom = LOUPE_SIZE / span;
      const markX = LOUPE_SIZE / 2 + (sx - cx) * zoom;
      const markY = LOUPE_SIZE / 2 + (sy - cy) * zoom;

      outlineColour ||= getComputedStyle(loupe).getPropertyValue('--accent').trim() || '#e11d48';
      ctx.strokeStyle = outlineColour;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(markX - 14, markY);
      ctx.lineTo(markX + 14, markY);
      ctx.moveTo(markX, markY - 14);
      ctx.lineTo(markX, markY + 14);
      ctx.stroke();
    }

    /** Re-unwarp with the corners as they now are, and show the result. */
    async function refreshProof(): Promise<void> {
      const shot = reviewing;
      if (!shot) return;
      const token = ++proofToken;
      proofNote.textContent = 'Straightening…';

      try {
        const bitmap = await createImageBitmap(new Blob([shot.bytes], { type: shot.type }));
        let preview: Preview | null = null;
        try {
          preview = await rehearse(bitmap, bitmap.width, bitmap.height, shot.quad);
        } finally {
          bitmap.close();
        }
        if (token !== proofToken || reviewing !== shot) return;
        if (!preview) {
          proofNote.textContent = 'That page could not be previewed here, but the bytes are fine.';
          return;
        }

        if (proofUrl) URL.revokeObjectURL(proofUrl);
        proofUrl = URL.createObjectURL(preview.blob);
        proofImg.src = proofUrl;
        applyPreview(shot, preview);
        render();

        proofNote.textContent = cleaning()
          ? 'This is the page as it will go into the PDF. The worker repeats the same crop at full resolution.'
          : 'Photo, unchanged: the frame goes into the PDF exactly as your camera took it.';
      } catch {
        if (token === proofToken) {
          proofNote.textContent = 'That page could not be previewed here, but the bytes are fine.';
        }
      }
    }

    async function openReview(shot: Shot): Promise<void> {
      reviewing = shot;
      working = shot.quad ?? WHOLE_FRAME;
      readout.textContent = '';
      proofNote.textContent = '';

      if (reviewUrl) URL.revokeObjectURL(reviewUrl);
      reviewUrl = URL.createObjectURL(new Blob([shot.bytes], { type: shot.type }));
      frameImg.src = reviewUrl;

      updateReviewHead();
      updateReviewMode();
      if (!review.open) review.showModal();

      try {
        await frameImg.decode();
      } catch {
        // Safari rejects decode() on an image that is swapped mid-flight. The
        // load listener below covers it; naturalWidth guards the rest.
      }
      if (reviewing !== shot) return;
      layoutEditor();
      void refreshProof();
    }

    function closeReview(): void {
      if (review.open) review.close();
    }

    function releaseReview(): void {
      reviewing = null;
      dragging = -1;
      loupe.hidden = true;
      if (nudgeTimer) window.clearTimeout(nudgeTimer);
      nudgeTimer = 0;
      frameImg.removeAttribute('src');
      if (reviewUrl) URL.revokeObjectURL(reviewUrl);
      reviewUrl = '';
      if (proofUrl) URL.revokeObjectURL(proofUrl);
      proofUrl = '';
      proofImg.removeAttribute('src');
    }

    /**
     * Turn the page a quarter-turn.
     *
     * The bytes themselves are rotated, not a flag on the shot: the worker takes
     * `InputFile[]` and has nowhere to carry a per-page rotation, and a
     * compositor-side drawImage plus one JPEG encode is cheap next to being
     * wrong. The corners come along — see rotateCornersCW for the half of that
     * which is easy to forget.
     */
    async function rotateShot(shot: Shot): Promise<void> {
      const bitmap = await createImageBitmap(new Blob([shot.bytes], { type: shot.type }));
      try {
        const surface = pad(bitmap.height, bitmap.width);
        if (!surface) return;
        surface.ctx.translate(bitmap.height, 0);
        surface.ctx.rotate(Math.PI / 2);
        surface.ctx.drawImage(bitmap, 0, 0);

        const blob = await toBlob(surface.canvas, 'image/jpeg', 0.92);
        shot.bytes = await blob.arrayBuffer();
        shot.type = 'image/jpeg';
        shot.width = bitmap.height;
        shot.height = bitmap.width;
        if (shot.quad) shot.quad = rotateCornersCW(shot.quad);
        surface.canvas.width = surface.canvas.height = 1;
      } finally {
        bitmap.close();
      }
    }

    /* ---------------------------------------------------------------- *
     * Building the PDF
     * ---------------------------------------------------------------- */

    /**
     * The scan request, plus the one field this UI adds.
     *
     * `quads` is per file and aligned with `files`. Each entry is either four
     * corners as fractions of that frame — clockwise from the top-left, exactly
     * what `scan.ts` wants once multiplied by the working copy's width and
     * height — or null, meaning "you find it". Only pages a person adjusted
     * carry corners; everything else is null so the worker's own detector, which
     * runs at a higher resolution than anything on this thread, still decides.
     */
    type ScanRequest = WorkerRequest & { quads?: (Corners | null)[] };

    let worker: Worker | null = null;
    let jobId = 0;
    let stageOfJob: 'scan' | 'ocr' = 'scan';
    let scanNotes: string[] = [];
    let scanReceipt = { pages: 0, bytesIn: 0, durationMs: 0 };
    /** Kept so a failed recognition pass can still hand over the scan. */
    let scanOutput: OutputFile[] = [];
    let scanBytesOut = 0;
    let urls: string[] = [];
    let ticker = 0;

    function ensureWorker(): Worker {
      if (!worker) {
        worker = new Worker(new URL('../lib/pdf/worker.ts', import.meta.url), { type: 'module' });
        worker.onmessage = (event: MessageEvent<WorkerResponse>) => onDone(event.data);
        worker.onerror = () => {
          stopProgress();
          runBtn.disabled = shots.length === 0;
          fail('The engine failed to start. Nothing was sent anywhere; reload and try again.');
        };
      }
      return worker;
    }

    const size = (n: number): string =>
      n >= 1048576 ? `${(n / 1048576).toFixed(2)} MB` : `${(n / 1024).toFixed(1)} KB`;

    /**
     * An honest progress line.
     *
     * The worker reports nothing until it is finished, so there is no percentage
     * to show that would not be invented. What can be shown truthfully is what
     * is being done, to how many pages, and how long it has been going.
     */
    function startProgress(text: string): void {
      stopProgress();
      const began = performance.now();
      const write = (): void => {
        const seconds = Math.round((performance.now() - began) / 1000);
        progress.textContent = seconds < 2 ? text : `${text} · ${seconds}s`;
      };
      write();
      ticker = window.setInterval(write, 1000);
    }

    function stopProgress(): void {
      if (ticker) window.clearInterval(ticker);
      ticker = 0;
      progress.textContent = '';
    }

    function build(): void {
      if (shots.length === 0) return;
      clearError();
      result.hidden = true;
      runBtn.disabled = true;

      const clean = cleaning();
      const n = shots.length;

      // Copies, not the originals: postMessage transfers detach the buffers it
      // is handed, and the shots have to survive so the list still works if the
      // build fails or the user builds twice.
      //
      // The names are made up here rather than carried from the file picker.
      // Both operations sniff the bytes and ignore the name, and a filename is
      // document content that has no business crossing into the worker's
      // receipt or anywhere else.
      const files = shots.map((shot, index) => ({
        name: `page-${String(index + 1).padStart(2, '0')}.${shot.type.split('/')[1] ?? 'jpg'}`,
        bytes: shot.bytes.slice(0),
      }));

      jobId += 1;
      stageOfJob = 'scan';
      scanNotes = [];

      const request: ScanRequest = clean
        ? {
            id: jobId,
            op: 'scan',
            files,
            scanMode: mode(),
            // Each page keeps the shape of the sheet that was photographed.
            // Forcing A4 would letterbox a receipt and crop nothing usefully.
            pageSize: 'fit',
            detectEdges: true,
            quads: shots.map((shot) => (shot.manual ? shot.quad : null)),
          }
        : {
            // "Photo, unchanged" is not "scan with the cleaning turned down" —
            // every scan mode flattens or thresholds. It is "put these
            // photographs in a PDF", which is a different operation, and the one
            // that keeps the JPEG bytes verbatim.
            id: jobId,
            op: 'images-to-pdf',
            files,
            pageSize: 'fit',
          };

      startProgress(
        clean
          ? `Finding the page edges and cleaning up ${n} page${n === 1 ? '' : 's'} on this device…`
          : `Assembling ${n} page${n === 1 ? '' : 's'} on this device…`
      );

      ensureWorker().postMessage(
        request,
        files.map((file) => file.bytes)
      );
    }

    /** Second stage: recognition, run on the PDF the first stage produced. */
    function runOcr(pdf: Uint8Array): void {
      jobId += 1;
      stageOfJob = 'ocr';

      // A copy, because the buffer is transferred and the first stage's output
      // is still the thing the user gets if recognition fails.
      const bytes = new Uint8Array(pdf).buffer;
      const request: WorkerRequest = {
        id: jobId,
        op: 'ocr',
        files: [{ name: 'scan.pdf', bytes }],
        searchable: true,
      };

      startProgress('Reading the text on each page…');
      ensureWorker().postMessage(request, [bytes]);
    }

    /** Put a finished set of files on screen, whichever stage produced them. */
    function present(files: OutputFile[], notes: string[], bytesOut: number, ms: number): void {
      stopProgress();
      runBtn.disabled = false;

      notesEl.replaceChildren(
        ...notes.map((note) => {
          const li = document.createElement('li');
          li.textContent = note;
          return li;
        })
      );

      for (const url of urls) URL.revokeObjectURL(url);
      urls = [];

      downloads.replaceChildren(
        ...files.map((file, index) => {
          const url = URL.createObjectURL(
            new Blob([file.bytes as BlobPart], { type: file.type ?? 'application/pdf' })
          );
          urls.push(url);

          const a = document.createElement('a');
          a.className = index === 0 ? 'btn btn--primary' : 'btn btn--quiet';
          a.href = url;
          a.download = file.name;
          a.textContent = file.name.endsWith('.txt') ? 'Save the text' : 'Save the PDF';
          return a;
        })
      );

      const pages = scanReceipt.pages;
      receipt.textContent = `${pages} page${pages === 1 ? '' : 's'} · ${size(scanReceipt.bytesIn)} photographed → ${size(bytesOut)} · ${Math.round(ms)}ms · 0 bytes sent`;
      result.hidden = false;
    }

    function onDone({ id, result: res }: WorkerResponse): void {
      if (id !== jobId) return;

      if (!res.ok) {
        stopProgress();
        runBtn.disabled = shots.length === 0;

        // A failed second stage still leaves a perfectly good PDF behind.
        // Throwing it away because the optional half failed would be the worst
        // of both, so it is handed over with the reason attached.
        if (stageOfJob === 'ocr' && scanOutput.length > 0) {
          fail(`${res.error} The scan itself is fine and is ready to save below, just without searchable text.`);
          present(
            scanOutput,
            [...scanNotes, 'Recognition did not finish, so this PDF has no searchable text layer.'],
            scanBytesOut,
            scanReceipt.durationMs
          );
          return;
        }

        fail(res.error);
        return;
      }

      if (!('files' in res)) return;

      if (stageOfJob === 'scan') {
        scanNotes = res.notes ?? [];
        scanReceipt = { pages: res.pages, bytesIn: res.bytesIn, durationMs: res.durationMs };
        scanOutput = res.files;
        scanBytesOut = res.bytesOut;

        const pdf = res.files[0];
        if (pdf && searchableBox.checked) {
          runOcr(pdf.bytes);
          return;
        }

        present(res.files, scanNotes, res.bytesOut, res.durationMs);
        return;
      }

      present(
        res.files,
        [...scanNotes, ...(res.notes ?? [])],
        res.bytesOut,
        scanReceipt.durationMs + res.durationMs
      );
    }

    /* ---------------------------------------------------------------- *
     * Wiring
     * ---------------------------------------------------------------- */

    openBtn.addEventListener('click', () => void startCamera());
    stopBtn.addEventListener('click', () => stopCamera('Camera off. Nothing was recorded.'));
    shootBtn.addEventListener('click', () => void capture());
    clearBtn.addEventListener('click', discardAll);
    runBtn.addEventListener('click', build);

    for (const input of finishInputs) {
      input.addEventListener('change', () => {
        updateReviewMode();
        void restyleShots().then(() => {
          if (reviewing) void refreshProof();
        });
      });
    }

    retakeCancel.addEventListener('click', () => {
      retakeTarget = null;
      updateRetakeBar();
    });

    autoBox.addEventListener('change', () => {
      resetAuto();
      if (autoBox.checked) say('Hold the page still and it will take itself.');
    });

    /* ---- the corner handles ------------------------------------------ */

    handles.forEach((handle, index) => {
      handle.addEventListener('pointerdown', (event: PointerEvent) => {
        if (!reviewing || !cleaning()) return;
        // Capture on the handle, so a finger that outruns the dot still drives
        // it and a pointerup outside the editor still ends the drag.
        handle.setPointerCapture(event.pointerId);
        dragging = index;
        event.preventDefault();
        handle.focus();
        showLoupe(index);
      });

      handle.addEventListener('pointermove', (event: PointerEvent) => {
        if (dragging !== index) return;
        event.preventDefault();
        const box = editor.getBoundingClientRect();
        moveCorner(index, toFraction(fit, event.clientX - box.left, event.clientY - box.top), false);
        showLoupe(index);
      });

      const end = (): void => {
        if (dragging !== index) return;
        dragging = -1;
        loupe.hidden = true;
        labelHandles();
        render();
        readout.textContent = `${CORNER_NAMES[index]}: ${Math.round(working[index].x * 100)}% across, ${Math.round(working[index].y * 100)}% down.`;
        void refreshProof();
      };

      handle.addEventListener('pointerup', end);
      handle.addEventListener('pointercancel', end);

      handle.addEventListener('keydown', (event: KeyboardEvent) => {
        if (!reviewing || fit.w <= 0) return;
        const step = (event.shiftKey ? 10 : 1) * NUDGE;
        let dx = 0;
        let dy = 0;
        if (event.key === 'ArrowLeft') dx = -step;
        else if (event.key === 'ArrowRight') dx = step;
        else if (event.key === 'ArrowUp') dy = -step;
        else if (event.key === 'ArrowDown') dy = step;
        else return;

        event.preventDefault();
        const point = working[index];
        moveCorner(index, { x: point.x + dx / fit.w, y: point.y + dy / fit.h }, true);
        showLoupe(index);

        // Re-unwarping on every key press would run the pipeline thirty times
        // for one held-down arrow. Once the keys stop, once.
        if (nudgeTimer) window.clearTimeout(nudgeTimer);
        nudgeTimer = window.setTimeout(() => {
          loupe.hidden = true;
          void refreshProof();
        }, 320);
      });

      handle.addEventListener('blur', () => {
        if (dragging !== index) loupe.hidden = true;
      });
    });

    /* ---- the review buttons ------------------------------------------ */

    reviewClose.addEventListener('click', () => closeReview());
    // 'close' fires for Escape too, so there is no 'cancel' listener here.
    review.addEventListener('close', releaseReview);

    frameImg.addEventListener('load', layoutEditor);

    wholeBtn.addEventListener('click', () => {
      if (!reviewing) return;
      setCorners(WHOLE_FRAME, true);
      readout.textContent = 'Using the whole frame.';
      void refreshProof();
    });

    detectBtn.addEventListener('click', () => {
      const shot = reviewing;
      if (!shot) return;
      detectBtn.disabled = true;
      readout.textContent = 'Looking for the page…';
      void findPage(shot)
        .then((found) => {
          if (reviewing !== shot) return;
          if (!found) {
            readout.textContent =
              'No page edge found in this shot. Drag the corners onto the paper yourself, or use the whole frame.';
            return;
          }
          // Found by the detector, not by a person: leave it re-detectable so
          // the worker's better pass at full resolution still gets its say.
          setCorners(found, false);
          readout.textContent = 'Found a page. Drag any corner that is not on the paper.';
          void refreshProof();
        })
        .catch(() => {
          readout.textContent = 'Page detection is unavailable here. Set the corners by hand.';
        })
        .finally(() => {
          detectBtn.disabled = !cleaning();
        });
    });

    rotateBtn.addEventListener('click', () => {
      const shot = reviewing;
      if (!shot) return;
      rotateBtn.disabled = true;
      void rotateShot(shot)
        .then(async () => {
          if (reviewing !== shot) return;
          working = shot.quad ?? WHOLE_FRAME;
          if (reviewUrl) URL.revokeObjectURL(reviewUrl);
          reviewUrl = URL.createObjectURL(new Blob([shot.bytes], { type: shot.type }));
          frameImg.src = reviewUrl;
          try {
            await frameImg.decode();
          } catch {
            // The load listener re-lays out either way.
          }
          layoutEditor();
          void refreshProof();
        })
        .catch(() => fail('That page could not be turned. It is unchanged.'))
        .finally(() => {
          rotateBtn.disabled = false;
        });
    });

    earlierBtn.addEventListener('click', () => {
      if (reviewing) move(reviewing, -1, earlierBtn);
    });

    laterBtn.addEventListener('click', () => {
      if (reviewing) move(reviewing, 1, laterBtn);
    });

    retakeBtn.addEventListener('click', () => {
      if (reviewing) startRetake(reviewing);
    });

    deleteBtn.addEventListener('click', () => {
      if (reviewing) drop(reviewing);
    });

    // The editor's box changes with the window, with the phone turning, and
    // when the dialog first opens; the handles are placed in its pixels.
    const editorObserver = new ResizeObserver(() => {
      if (reviewing) layoutEditor();
    });
    editorObserver.observe(editor);

    // The overlay's pixel size follows the video's box, which changes on rotate,
    // on resize, and when the stream's own dimensions finally arrive.
    const observer = new ResizeObserver(() => fitOverlay());
    observer.observe(video);
    window.addEventListener('resize', fitOverlay);
    video.addEventListener('loadedmetadata', fitOverlay);

    /**
     * Leaving the tab turns the camera off.
     *
     * A background tab holding a live camera is precisely the behaviour this
     * tool exists not to have, and rAF has already stopped the detection loop
     * anyway, so the stream would only be a lit indicator doing nothing. Turning
     * it back on is one button.
     */
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && stream) stopCamera('Camera turned off when you left the tab.');
    });

    window.addEventListener('pagehide', () => stopCamera());
    // Harmless without view transitions; the teardown hook if they are ever on.
    document.addEventListener('astro:before-swap', () => stopCamera());

    updateReviewMode();
    updateRetakeBar();
    render();
  }
</script>

<style is:global>
  /*
   * The shot list is built by the script above, at runtime.
   *
   * Astro scopes a component's styles by stamping a data attribute on the
   * elements it compiles; an element created by `document.createElement` never
   * gets that attribute, so the `.scan__shot` rules in the scoped block cannot
   * reach these nodes. Hence `is:global` — every selector here is namespaced
   * under `.scan` so "global" is a mechanism, not a blast radius.
   *
   * The review dialog is NOT here: it is written in the markup above and its
   * styles are scoped like any other authored element.
   */
  .scan .scan__shot {
    position: relative;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) * 0.6);
    overflow: hidden;
    background: var(--paper-raised);
    display: grid;
    grid-template-rows: 1fr auto;
  }

  /* The thumbnail is the way in to the page, so it has to look like one. */
  .scan .scan__shot-open {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--paper-sunk);
    cursor: pointer;
  }

  .scan .scan__shot-open img {
    display: block;
    width: 100%;
    height: auto;
    background: var(--paper-sunk);
  }

  .scan .scan__shot-open:hover img {
    opacity: 0.92;
  }

  .scan .scan__shot-open:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .scan .scan__shot-badge {
    position: absolute;
    left: 0.35rem;
    top: 0.35rem;
    min-width: 1.4rem;
    padding: 0.05rem 0.35rem;
    border-radius: 999px;
    font-size: var(--step--2);
    font-variant-numeric: tabular-nums;
    background: rgb(0 0 0 / 0.62);
    color: #fff;
  }

  .scan .scan__shot-bar {
    display: grid;
    gap: 0.2rem;
    padding: 0.3rem 0.4rem 0.4rem;
  }

  .scan .scan__shot-note {
    font-size: var(--step--2);
    color: var(--muted);
  }

  .scan .scan__shot-moves {
    display: flex;
    gap: 0.25rem;
  }

  /* 30px is small for a thumb, which is why these are the shortcut and the
     dialog is the place where a page is actually worked on. */
  .scan .scan__step {
    flex: 1;
    min-height: 30px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: transparent;
    color: var(--ink-2);
    font: inherit;
    font-size: var(--step--2);
    line-height: 1;
    cursor: pointer;
  }

  .scan .scan__step:hover:not(:disabled) {
    background: var(--paper-sunk);
    color: var(--ink);
  }

  .scan .scan__step:disabled {
    color: var(--line-strong);
    cursor: default;
  }

  .scan .scan__step:last-child {
    color: var(--seal);
  }

  .scan .scan__picker {
    margin-top: 0.25rem;
  }

  /* The picker is opened by the button next to it; it is never the target. */
  .scan .scan__picker-input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
