---
import '../styles/global.css';

import Seo from '../components/Seo.astro';
import { TOOLS } from '../config/site';

interface Props {
  title: string;
  description: string;
  lang?: string;
  imageSlug?: string;
  /** Kept for page-call compatibility; schema is derived from the shared tool config. */
  toolName?: string;
}

const { title, description, lang = 'en', imageSlug } = Astro.props;

// Respects the deployment base path (a GitHub Pages project site is served
// from /ProjectPDF/, not /).
const favicon = `${import.meta.env.BASE_URL}/favicon.svg`.replace(/\/{2,}/g, '/');

const pageSlug = Astro.url.pathname.split('/').filter(Boolean).at(-1) ?? '';
const noindex = TOOLS.some((tool) => tool.slug === pageSlug && tool.status !== 'live');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <Seo {title} {description} {imageSlug} {noindex} />

    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0f17" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href={favicon} type="image/svg+xml" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('pdfcraft-theme');
        const theme = saved === 'light' || saved === 'dark'
          ? saved
          : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 0.75rem 1.25rem;
    background: var(--paper-raised);
    border: 1px solid var(--line-strong);
    border-radius: 0 0 var(--radius) 0;
  }

  .skip:focus {
    left: 0;
  }
</style>
