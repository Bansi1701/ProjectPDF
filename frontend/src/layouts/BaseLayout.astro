---
import '../styles/global.css';

import Seo from '../components/Seo.astro';
import ProofCounter from '../components/ProofCounter.astro';
import SpeedNote from '../components/SpeedNote.astro';
import { TOOLS } from '../config/site';
import { LEGACY_USAGE_KEY, PREFERENCE_VERSION, THEME_KEY } from '../lib/browserPreferences';

interface Props {
  title: string;
  description: string;
  lang?: string;
  imageSlug?: string;
  keywords?: string[];
  contentType?: 'website' | 'article';
  /** Kept for page-call compatibility; schema is derived from the shared tool config. */
  toolName?: string;
}

const { title, description, lang = 'en', imageSlug, keywords, contentType } = Astro.props;

// Respects the deployment base path (a GitHub Pages project site is served
// from /ProjectPDF/, not /).
const favicon = `${import.meta.env.BASE_URL}/favicon.svg`.replace(/\/{2,}/g, '/');
const interFont = `${import.meta.env.BASE_URL}/fonts/inter-latin.woff2`.replace(/\/{2,}/g, '/');
const brandFont = `${import.meta.env.BASE_URL}/fonts/plus-jakarta-sans-latin.woff2`.replace(/\/{2,}/g, '/');

const pageSlug = Astro.url.pathname.split('/').filter(Boolean).at(-1) ?? '';
const noindex = TOOLS.some((tool) => tool.slug === pageSlug && tool.status !== 'live');
const themeKey = THEME_KEY;
const legacyUsageKey = LEGACY_USAGE_KEY;
const preferenceVersion = PREFERENCE_VERSION;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <Seo {title} {description} {imageSlug} {noindex} {keywords} {contentType} />

    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0f17" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href={favicon} type="image/svg+xml" />
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={brandFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <script is:inline define:vars={{ themeKey, legacyUsageKey, preferenceVersion }}>
      try {
        // This retired counter was never transmitted or used. Remove any copy
        // left by an earlier release before reading the requested appearance.
        localStorage.removeItem(legacyUsageKey);
        const raw = localStorage.getItem(themeKey);
        let saved = null;
        if (raw) {
          try {
            const record = JSON.parse(raw);
            if (
              record?.version === preferenceVersion &&
              (record.value === 'light' || record.value === 'dark') &&
              typeof record.expiresAt === 'number' &&
              record.expiresAt > Date.now()
            ) saved = record.value;
            else localStorage.removeItem(themeKey);
          } catch {
            localStorage.removeItem(themeKey);
          }
        }
        const theme = saved ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      } catch {
        document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <ProofCounter />
    <SpeedNote />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 0.75rem 1.25rem;
    background: var(--paper-raised);
    border: 1px solid var(--line-strong);
    border-radius: 0 0 var(--radius) 0;
  }

  .skip:focus {
    left: 0;
  }
</style>
